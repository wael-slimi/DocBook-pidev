<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="24" styleClass="content-area"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.docbook.controllers.admin.ActivityLogController">

    <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

    <HBox alignment="BOTTOM_LEFT" spacing="10">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="System Logs" styleClass="h2"/>
            <Label text="Track all user actions, logins, and security events." styleClass="body-md"/>
        </VBox>
        <HBox spacing="12">
            <Button text="REFRESH" onAction="#handleRefresh" styleClass="btn-outline"/>
            <Button text="CLEAR ALL" onAction="#handleClearLogs" styleClass="btn-primary" style="-fx-background-color: #ef4444;"/>
        </HBox>
    </HBox>

    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="filters-container">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        <TextField fx:id="searchField" promptText="Search users or details..." prefWidth="300" styleClass="search-field"/>
        <HBox alignment="CENTER" spacing="8" styleClass="filter-chip">
            <Label text="ACTION:" styleClass="label-caps-sm"/>
            <ComboBox fx:id="actionFilter" prefWidth="150" promptText="All Actions" styleClass="filter-combo"/>
        </HBox>
        <HBox alignment="CENTER" spacing="8" styleClass="filter-chip">
            <Label text="USER TYPE:" styleClass="label-caps-sm"/>
            <ComboBox fx:id="typeFilter" prefWidth="120" promptText="All Types" styleClass="filter-combo"/>
        </HBox>
    </HBox>

    <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
        <TableView fx:id="logTable" VBox.vgrow="ALWAYS" prefHeight="500">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colUser" text="USER" prefWidth="200"/>
                <TableColumn fx:id="colAction" text="ACTION" prefWidth="150"/>
                <TableColumn fx:id="colDetails" text="DETAILS" prefWidth="400"/>
                <TableColumn fx:id="colDate" text="TIMESTAMP" prefWidth="180"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
