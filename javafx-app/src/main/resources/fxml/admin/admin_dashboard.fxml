<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="mainPane" stylesheets="@/css/style.css" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.docbook.controllers.auth.AdminController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="patient-sidebar" prefWidth="260" minWidth="260" maxWidth="260" spacing="0">
            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 20 16 20;" spacing="12">
                <StackPane style="-fx-background-color: #0058be; -fx-background-radius: 10;" minWidth="40" minHeight="40" prefWidth="40" prefHeight="40">
                    <Text text="✚" style="-fx-font-size: 20px; -fx-fill: white;"/>
                </StackPane>
                <Text text="DocBook" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-fill: #1e293b;"/>
            </HBox>
            
            <!-- Navigation -->
            <VBox styleClass="sidebar-nav" spacing="2" style="-fx-padding: 8 12;">
                <Button fx:id="btnDashboard" onAction="#handleSwitchToDashboard" 
                        text="🏠  Tableau de bord" styleClass="nav-link-active" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button fx:id="btnUserManagement" onAction="#handleSwitchToUsers" 
                        text="👥  Patients" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button fx:id="btnDoctorApprovals" onAction="#handleSwitchToApprovals" 
                        text="👨‍⚕️  Médecins" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button fx:id="btnSystemLogs" text="📋  Journaux d'activité" onAction="#handleSwitchToLogs" 
                        styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="⚙️  Paramètres" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Admin Profile -->
            <VBox style="-fx-padding: 16 20; -fx-background-color: #f1f5f9;" spacing="8">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane style="-fx-background-color: #e0e7ff; -fx-background-radius: 20;" prefWidth="36" prefHeight="36">
                        <Text text="AD" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-fill: #0058be;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Admin Central" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
                        <Text text="admin@docbook.fr" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                    </VBox>
                </HBox>
                <Button onAction="#handleLogout" text="Déconnexion"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-background-radius: 8; 
                               -fx-font-size: 12px; -fx-padding: 8 12; -fx-cursor: hand;"
                        prefWidth="220"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" styleClass="content-area">
            <!-- Top AppBar -->
            <HBox alignment="CENTER_LEFT" prefHeight="64" styleClass="top-appbar">
                <padding><Insets left="24" right="24"/></padding>
                <Text text="☰" style="-fx-font-size: 20px; -fx-text-fill: #64748b; -fx-cursor: hand;"/>
                <Text text="Gestion Médicale" styleClass="top-appbar-title" style="-fx-margin: 0 0 0 16;"/>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox spacing="12" alignment="CENTER">
                    <Button text="🔔" style="-fx-font-size: 18px; -fx-background-color: transparent; -fx-cursor: hand;"/>
                    <Separator orientation="VERTICAL" prefHeight="24"/>
                    <Button onAction="#handleLogout" text="Déconnexion" styleClass="logout-btn"/>
                </HBox>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <VBox fx:id="dashboardView" spacing="0" styleClass="content-area">
                    <ScrollPane fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox spacing="24">
                            <padding><Insets top="24" right="32" bottom="32" left="32"/></padding>

                            <!-- Page Header -->
                            <HBox alignment="BOTTOM_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Text text="Vue d'ensemble du système" styleClass="h1"/>
                                    <Text text="Bienvenue, voici le résumé des activités de la plateforme aujourd'hui." 
                                          styleClass="body" style="-fx-text-fill: #727785;"/>
                                </VBox>
                            </HBox>

                            <!-- STAT CARDS (4 columns) -->
                            <GridPane hgap="24" vgap="24">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>

                                <!-- Card 1: Users -->
                                <VBox GridPane.columnIndex="0" styleClass="stat-card" spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <StackPane styleClass="stat-card-icon, stat-card-icon-primary" prefWidth="40" prefHeight="40">
                                            <Text text="👥" style="-fx-font-size: 20px;"/>
                                        </StackPane>
                                        <Text text="Total" style="-fx-font-size: 11px; -fx-font-weight: 600; 
                                                     -fx-text-fill: #727785;"/>
                                    </HBox>
                                    <Text text="UTILISATEURS TOTAL" styleClass="stat-card-label"/>
                                    <Label fx:id="statTotalUsers" text="0" styleClass="stat-card-value" 
                                          style="-fx-font-size: 28px; -fx-font-weight: 700;"/>
                                </VBox>

                                <!-- Card 2: Doctors -->
                                <VBox GridPane.columnIndex="1" styleClass="stat-card" spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <StackPane styleClass="stat-card-icon, stat-card-icon-secondary" prefWidth="40" prefHeight="40">
                                            <Text text="🩺" style="-fx-font-size: 20px;"/>
                                        </StackPane>
                                        <Text text="+5%" style="-fx-font-size: 11px; -fx-font-weight: 600; 
                                                     -fx-background-color: #dcfce7; -fx-text-fill: #16a34a; 
                                                     -fx-padding: 2 8; -fx-background-radius: 9999;"/>
                                    </HBox>
                                    <Text text="NOUVEAUX MÉDECINS" styleClass="stat-card-label"/>
                                    <Label fx:id="statDoctors" text="243" styleClass="stat-card-value" 
                                          style="-fx-font-size: 28px; -fx-font-weight: 700;"/>
                                </VBox>

                                <!-- Card 3: Approvals -->
                                <VBox GridPane.columnIndex="2" styleClass="stat-card" spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <StackPane styleClass="stat-card-icon, stat-card-icon-tertiary" prefWidth="40" prefHeight="40">
                                            <Text text="⏳" style="-fx-font-size: 20px;"/>
                                        </StackPane>
                                        <Text text="En attente" style="-fx-font-size: 11px; -fx-font-weight: 600; 
                                                     -fx-background-color: #fef3c7; -fx-text-fill: #d97706; 
                                                     -fx-padding: 2 8; -fx-background-radius: 9999;"/>
                                    </HBox>
                                    <Text text="APPROBATIONS REQUISES" styleClass="stat-card-label"/>
                                    <Label fx:id="pendingCountLabel" text="18" styleClass="stat-card-value" 
                                          style="-fx-font-size: 28px; -fx-font-weight: 700;"/>
                                </VBox>

                                <!-- Card 4: Patients -->
                                <VBox GridPane.columnIndex="3" styleClass="stat-card" spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <StackPane prefWidth="40" prefHeight="40" 
                                                   style="-fx-background-color: #ede9fe; -fx-background-radius: 10;">
                                            <Text text="🤒" style="-fx-font-size: 20px;"/>
                                        </StackPane>
                                        <Text text="Total" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #727785;"/>
                                    </HBox>
                                    <Text text="PATIENTS TOTAL" styleClass="stat-card-label"/>
                                    <Label fx:id="statPatients" text="0" styleClass="stat-card-value" 
                                          style="-fx-font-size: 28px; -fx-font-weight: 700;"/>
                                </VBox>
                            </GridPane>

                            <!-- CHART + APPROVALS -->
                            <HBox spacing="24">
                                <!-- Chart Area -->
                                <VBox HBox.hgrow="ALWAYS" styleClass="content-card">
                                    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 0 0 16 0;">
                                        <Text text="Inscriptions Utilisateurs (7 derniers jours)" styleClass="h3"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <ComboBox promptText="Cette semaine" prefWidth="120" 
                                                  style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0;"/>
                                    </HBox>
                                    
                                    <!-- Simulated Bar Chart -->
                                    <HBox alignment="BOTTOM_CENTER" spacing="8" prefHeight="200">
                                        <VBox VBox.vgrow="ALWAYS" style="-fx-alignment: center;">
                                            <StackPane style="-fx-background-color: #d8e2ff; -fx-background-radius: 4 4 0 0;" 
                                                       prefHeight="80" prefWidth="40"/>
                                            <Text text="LUN" style="-fx-font-size: 10px; -fx-text-fill: #727785;"/>
                                        </VBox>
                                        <VBox VBox.vgrow="ALWAYS" style="-fx-alignment: center;">
                                            <StackPane style="-fx-background-color: #d8e2ff; -fx-background-radius: 4 4 0 0;" 
                                                       prefHeight="130" prefWidth="40"/>
                                            <Text text="MAR" style="-fx-font-size: 10px; -fx-text-fill: #727785;"/>
                                        </VBox>
                                        <VBox VBox.vgrow="ALWAYS" style="-fx-alignment: center;">
                                            <StackPane style="-fx-background-color: #d8e2ff; -fx-background-radius: 4 4 0 0;" 
                                                       prefHeight="110" prefWidth="40"/>
                                            <Text text="MER" style="-fx-font-size: 10px; -fx-text-fill: #727785;"/>
                                        </VBox>
                                        <VBox VBox.vgrow="ALWAYS" style="-fx-alignment: center;">
                                            <StackPane style="-fx-background-color: #d8e2ff; -fx-background-radius: 4 4 0 0;" 
                                                       prefHeight="170" prefWidth="40"/>
                                            <Text text="JEU" style="-fx-font-size: 10px; -fx-text-fill: #727785;"/>
                                        </VBox>
                                        <VBox VBox.vgrow="ALWAYS" style="-fx-alignment: center;">
                                            <StackPane style="-fx-background-color: #2170e4; -fx-background-radius: 4 4 0 0;" 
                                                       prefHeight="190" prefWidth="40"/>
                                            <Text text="VEN" style="-fx-font-size: 10px; -fx-font-weight: 600; -fx-text-fill: #191b23;"/>
                                        </VBox>
                                        <VBox VBox.vgrow="ALWAYS" style="-fx-alignment: center;">
                                            <StackPane style="-fx-background-color: #d8e2ff; -fx-background-radius: 4 4 0 0;" 
                                                       prefHeight="70" prefWidth="40"/>
                                            <Text text="SAM" style="-fx-font-size: 10px; -fx-text-fill: #727785;"/>
                                        </VBox>
                                        <VBox VBox.vgrow="ALWAYS" style="-fx-alignment: center;">
                                            <StackPane style="-fx-background-color: #d8e2ff; -fx-background-radius: 4 4 0 0;" 
                                                       prefHeight="50" prefWidth="40"/>
                                            <Text text="DIM" style="-fx-font-size: 10px; -fx-text-fill: #727785;"/>
                                        </VBox>
                                    </HBox>
                                    
                                    <HBox spacing="24" style="-fx-padding: 16 0 0 0;">
                                        <HBox spacing="8" alignment="CENTER">
                                            <StackPane style="-fx-background-color: #2170e4; -fx-background-radius: 3;" 
                                                       prefWidth="12" prefHeight="12"/>
                                            <Text text="Patients (820)" styleClass="caption"/>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER">
                                            <StackPane style="-fx-background-color: #8455ef; -fx-background-radius: 3;" 
                                                       prefWidth="12" prefHeight="12"/>
                                            <Text text="Médecins (45)" styleClass="caption"/>
                                        </HBox>
                                    </HBox>
                                </VBox>
                                
                                <!-- Approvals Card -->
                                <VBox prefWidth="350" styleClass="content-card">
                                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 16 0;">
                                        <Text text="Demandes d'approbation en attente" styleClass="h3"/>
                                        <Text text="3 Nouvelles" style="-fx-font-size: 10px; -fx-font-weight: 600; 
                                                    -fx-background-color: #fef3c7; -fx-text-fill: #d97706; 
                                                    -fx-padding: 2 8; -fx-background-radius: 9999;"/>
                                    </HBox>
                                    
                                    <!-- Request 1 -->
                                    <VBox style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 12; -fx-margin: 0 0 8 0;">
                                        <HBox spacing="12" alignment="CENTER_LEFT">
                                            <StackPane prefWidth="40" prefHeight="40" style="-fx-background-color: #e9ddff; -fx-background-radius: 20;">
                                                <Text text="ML" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-fill: #6b38d4;"/>
                                            </StackPane>
                                            <VBox spacing="2">
                                                <Text text="Dr. Marc Lefebvre" styleClass="body-bold"/>
                                                <Text text="Cardiologie • Paris" styleClass="caption"/>
                                            </VBox>
                                        </HBox>
                                        <HBox spacing="8" style="-fx-padding: 8 0 0 0;">
                                            <Button text="Approuver" style="-fx-background-color: #0058be; -fx-text-fill: white; 
                                                        -fx-font-size: 11px; -fx-font-weight: 600; -fx-background-radius: 6; 
                                                        -fx-padding: 6 12;"/>
                                            <Button text="Rejeter" style="-fx-background-color: transparent; -fx-border-color: #e2e8f0; 
                                                        -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: 600; 
                                                        -fx-background-radius: 6; -fx-padding: 6 12;"/>
                                        </HBox>
                                    </VBox>
                                    
                                    <!-- Request 2 -->
                                    <VBox style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 12; -fx-margin: 0 0 8 0;">
                                        <HBox spacing="12" alignment="CENTER_LEFT">
                                            <StackPane prefWidth="40" prefHeight="40" style="-fx-background-color: #e9ddff; -fx-background-radius: 20;">
                                                <Text text="SC" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-fill: #6b38d4;"/>
                                            </StackPane>
                                            <VBox spacing="2">
                                                <Text text="Dr. Sarah Chen" styleClass="body-bold"/>
                                                <Text text="Pédiatrie • Lyon" styleClass="caption"/>
                                            </VBox>
                                        </HBox>
                                        <HBox spacing="8" style="-fx-padding: 8 0 0 0;">
                                            <Button text="Approuver" style="-fx-background-color: #0058be; -fx-text-fill: white; 
                                                        -fx-font-size: 11px; -fx-font-weight: 600; -fx-background-radius: 6; 
                                                        -fx-padding: 6 12;"/>
                                            <Button text="Rejeter" style="-fx-background-color: transparent; -fx-border-color: #e2e8f0; 
                                                        -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: 600; 
                                                        -fx-background-radius: 6; -fx-padding: 6 12;"/>
                                        </HBox>
                                    </VBox>
                                    
                                    <!-- Request 3 -->
                                    <VBox style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 12;">
                                        <HBox spacing="12" alignment="CENTER_LEFT">
                                            <StackPane prefWidth="40" prefHeight="40" style="-fx-background-color: #e9ddff; -fx-background-radius: 20;">
                                                <Text text="AD" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-fill: #6b38d4;"/>
                                            </StackPane>
                                            <VBox spacing="2">
                                                <Text text="Dr. Amélie Durand" styleClass="body-bold"/>
                                                <Text text="Dermatologie • Marseille" styleClass="caption"/>
                                            </VBox>
                                        </HBox>
                                        <HBox spacing="8" style="-fx-padding: 8 0 0 0;">
                                            <Button text="Approuver" style="-fx-background-color: #0058be; -fx-text-fill: white; 
                                                        -fx-font-size: 11px; -fx-font-weight: 600; -fx-background-radius: 6; 
                                                        -fx-padding: 6 12;"/>
                                            <Button text="Rejeter" style="-fx-background-color: transparent; -fx-border-color: #e2e8f0; 
                                                        -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: 600; 
                                                        -fx-background-radius: 6; -fx-padding: 6 12;"/>
                                        </HBox>
                                    </VBox>
                                    
                                    <Text text="Voir toutes les demandes" style="-fx-text-fill: #0058be; 
                                                -fx-font-size: 12px; -fx-font-weight: 600; -fx-cursor: hand; 
                                                -fx-padding: 16 0 0 0;"/>
                                </VBox>
                            </HBox>

                            <!-- USER DISTRIBUTION -->
                            <VBox styleClass="content-card">
                                <Text text="Distribution des Utilisateurs" styleClass="h3" style="-fx-padding: 0 0 16 0;"/>
                                <VBox spacing="12">
                                    <HBox spacing="16" alignment="CENTER_LEFT">
                                        <Label fx:id="distDoctorsLabel" text="Médecins: 0" prefWidth="100" styleClass="body"/>
                                        <ProgressBar fx:id="distDoctorsBar" progress="0" HBox.hgrow="ALWAYS" 
                                                     styleClass="progress-bar-custom" style="-fx-accent: #0058be;"/>
                                        <Label fx:id="distDoctorsPct" text="0%" prefWidth="50" styleClass="body"/>
                                    </HBox>
                                    <HBox spacing="16" alignment="CENTER_LEFT">
                                        <Label fx:id="distPatientsLabel" text="Patients: 0" prefWidth="100" styleClass="body"/>
                                        <ProgressBar fx:id="distPatientsBar" progress="0" HBox.hgrow="ALWAYS" 
                                                     styleClass="progress-bar-custom" style="-fx-accent: #6b38d4;"/>
                                        <Label fx:id="distPatientsPct" text="0%" prefWidth="50" styleClass="body"/>
                                    </HBox>
                                    <HBox spacing="16" alignment="CENTER_LEFT">
                                        <Label fx:id="distAdminsLabel" text="Admins: 0" prefWidth="100" styleClass="body"/>
                                        <ProgressBar fx:id="distAdminsBar" progress="0" HBox.hgrow="ALWAYS" 
                                                     styleClass="progress-bar-custom" style="-fx-accent: #924700;"/>
                                        <Label fx:id="distAdminsPct" text="0%" prefWidth="50" styleClass="body"/>
                                    </HBox>
                                </VBox>
                                <Label fx:id="distRecent" text="0 new registrations this week" styleClass="caption" style="-fx-padding: 16 0 0 0;"/>
                            </VBox>

                        </VBox>
                    </ScrollPane>
                </VBox>

                <VBox fx:id="usersView" spacing="0" styleClass="content-area" visible="false" managed="false">
                    <ScrollPane fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox spacing="24">
                            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                            <HBox alignment="BOTTOM_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="User Management" styleClass="h2"/>
                                    <Label text="Manage clinical staff and patient records." styleClass="body-md"/>
                                </VBox>
                            </HBox>

                            <HBox styleClass="filters-container" spacing="16" alignment="CENTER_LEFT">
                                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                                <HBox alignment="CENTER" spacing="8" styleClass="filter-chip">
                                    <Label text="USER TYPE:" styleClass="label-caps-sm"/>
                                    <ComboBox fx:id="filterTypeCombo" prefWidth="120" promptText="All Types" styleClass="filter-combo"/>
                                </HBox>
                                <HBox alignment="CENTER" spacing="8" styleClass="filter-chip">
                                    <Label text="STATUS:" styleClass="label-caps-sm"/>
                                    <ComboBox fx:id="filterStatusCombo" prefWidth="120" promptText="All Statuses" styleClass="filter-combo"/>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Hyperlink text="CLEAR ALL FILTERS" styleClass="link-secondary" onAction="#handleClearFilters"/>
                            </HBox>

                            <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
                                <TableView fx:id="userTable" VBox.vgrow="ALWAYS" prefHeight="400">
                                    <columns>
                                        <TableColumn fx:id="colName" text="NAME" prefWidth="250"/>
                                        <TableColumn fx:id="colRole" text="USER TYPE" prefWidth="180"/>
                                        <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="250"/>
                                        <TableColumn fx:id="colStatus" text="STATUS" prefWidth="120"/>
                                        <TableColumn fx:id="colAction" text="ACTIONS" prefWidth="120"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                        </VBox>
                    </ScrollPane>
                </VBox>

                <VBox fx:id="approvalsView" spacing="0" styleClass="content-area" visible="false" managed="false">
                    <ScrollPane fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox spacing="24">
                            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                            <HBox alignment="BOTTOM_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="Doctor Approvals" styleClass="h2"/>
                                    <Label text="Verify and approve new medical registrations." styleClass="body-md"/>
                                </VBox>
                            </HBox>

                            <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
                                <TableView fx:id="approvalTable" VBox.vgrow="ALWAYS" prefHeight="400">
                                    <columns>
                                        <TableColumn fx:id="colApproveName" text="NAME" prefWidth="250"/>
                                        <TableColumn fx:id="colApproveSpecialty" text="SPECIALTY" prefWidth="200"/>
                                        <TableColumn fx:id="colApproveEmail" text="EMAIL" prefWidth="250"/>
                                        <TableColumn fx:id="colApproveStatus" text="STATUS" prefWidth="120"/>
                                        <TableColumn fx:id="colApproveAction" text="ACTIONS" prefWidth="180"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                        </VBox>
                    </ScrollPane>
                </VBox>

                <VBox fx:id="logsView" spacing="0" styleClass="content-area" visible="false" managed="false">
                    <ScrollPane fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox spacing="24">
                            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                            <HBox alignment="BOTTOM_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="System Logs" styleClass="h2"/>
                                    <Label text="Track all user actions, logins, and security events." styleClass="body-md"/>
                                </VBox>
                                <HBox spacing="12">
                                    <Button text="REFRESH" onAction="#handleRefreshLogs" styleClass="btn-outline"/>
                                </HBox>
                            </HBox>

                            <HBox spacing="16" alignment="CENTER_LEFT" styleClass="filters-container">
                                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                                <TextField fx:id="logSearchField" promptText="Search users or details..." prefWidth="300" styleClass="search-field"/>
                                <HBox alignment="CENTER" spacing="8" styleClass="filter-chip">
                                    <Label text="ACTION:" styleClass="label-caps-sm"/>
                                    <ComboBox fx:id="logActionFilter" prefWidth="150" promptText="All Actions" styleClass="filter-combo"/>
                                </HBox>
                            </HBox>

                            <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
                                <TableView fx:id="logTable" VBox.vgrow="ALWAYS" prefHeight="500">
                                    <columns>
                                        <TableColumn fx:id="colLogId" text="ID" prefWidth="60"/>
                                        <TableColumn fx:id="colLogUser" text="USER" prefWidth="200"/>
                                        <TableColumn fx:id="colLogAction" text="ACTION" prefWidth="150"/>
                                        <TableColumn fx:id="colLogDetails" text="DETAILS" prefWidth="400"/>
                                        <TableColumn fx:id="colLogDate" text="TIMESTAMP" prefWidth="180"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                        </VBox>
                    </ScrollPane>
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
