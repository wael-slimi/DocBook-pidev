<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="mainPane" stylesheets="@/css/style.css" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.docbook.controllers.auth.AdminController">

    <left>
        <VBox styleClass="sidebar" prefWidth="260" spacing="0">
            <padding>
                <Insets top="20" bottom="20"/>
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <padding><Insets left="24" bottom="30"/></padding>
                <StackPane styleClass="logo-container" prefWidth="40" prefHeight="40">
                    <Label text="DB" styleClass="logo-text"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label text="DocBook" styleClass="title-main"/>
                    <Label text="Admin Portal" styleClass="subtitle"/>
                </VBox>
            </HBox>

            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Button fx:id="btnDashboard" onAction="#handleSwitchToDashboard" text="Dashboard" styleClass="nav-button-active" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic><Label text="▦" style="-fx-font-size: 14px;"/></graphic>
                </Button>
                <Button fx:id="btnUserManagement" onAction="#handleSwitchToUsers" text="User Management" styleClass="nav-button" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic><Label text="👥" style="-fx-font-size: 14px;"/></graphic>
                </Button>
                <Button fx:id="btnDoctorApprovals" onAction="#handleSwitchToApprovals" text="Doctor Approvals" styleClass="nav-button" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic><Label text="🩺" style="-fx-font-size: 14px;"/></graphic>
                    <padding><Insets right="16" top="8" bottom="8" left="16"/></padding>
                </Button>
                <Button fx:id="btnSystemLogs" text="System Logs" onAction="#handleSwitchToLogs" styleClass="nav-button" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic><Label text="📋" style="-fx-font-size: 14px;"/></graphic>
                </Button>

                <Separator VBox.vgrow="ALWAYS" visible="false"/>

                <Button fx:id="btnToggleTheme" onAction="#handleToggleTheme" text="Toggle Theme" styleClass="nav-button" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <graphic><Label text="🌓" style="-fx-font-size: 14px;"/></graphic>
                </Button>
            </VBox>

            <VBox styleClass="sidebar-footer">
                <padding><Insets left="16" right="16" top="16" bottom="20"/></padding>

                <HBox styleClass="admin-profile-card" spacing="12" alignment="CENTER_LEFT">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <StackPane>
                        <Circle fill="#BDC3C7" radius="18"/>
                        <Label text="A" styleClass="avatar-text"/>
                    </StackPane>
                    <VBox>
                        <Label text="Admin" styleClass="admin-name-sidebar"/>
                        <Label text="Administrator" styleClass="admin-role-sidebar"/>
                    </VBox>
                </HBox>

                <Button onAction="#handleLogout" text="Log Out" maxWidth="Infinity" alignment="CENTER"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10;">
                    <VBox.margin>
                        <Insets top="15" />
                    </VBox.margin>
                    <graphic>
                        <Region styleClass="icon-logout" style="-fx-shape: 'M16 17v-3H9v-4h7V7l5 5-5 5M14 2a2 2 0 0 1 2 2v2h-2V4H5v16h9v-2h2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9z'; -fx-background-color: #dc2626; -fx-pref-width: 14; -fx-pref-height: 14;"/>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" styleClass="content-area">
            <HBox alignment="CENTER_LEFT" prefHeight="64" styleClass="top-bar">
                <padding><Insets left="32" right="32"/></padding>
                <TextField fx:id="searchField" promptText="Search accounts, emails, or IDs..." prefWidth="400" styleClass="search-field"/>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="btnExportCSV" text="EXPORT CSV" styleClass="btn-outline" onAction="#handleExportCSV">
                        <graphic><Label text="⬇" style="-fx-font-size: 12px;"/></graphic>
                    </Button>
                    <Separator orientation="VERTICAL" prefHeight="20"/>
                    <VBox alignment="CENTER_RIGHT">
                        <Label text="DocBook Admin" styleClass="version-title"/>
                        <Label text="v2.4.0" styleClass="version-tag"/>
                    </VBox>
                </HBox>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <VBox fx:id="dashboardView" spacing="0" styleClass="content-area">
                    <ScrollPane fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox spacing="24">
                            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                            <HBox alignment="BOTTOM_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="Dashboard" styleClass="h2"/>
                                    <Label text="Overview of your clinical platform." styleClass="body-md"/>
                                </VBox>
                            </HBox>

                            <GridPane hgap="16" vgap="16">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>

                                <VBox GridPane.columnIndex="0" styleClass="stat-card-teal" spacing="6">
                                    <Label text="TOTAL USERS" styleClass="stat-label-white"/>
                                    <Label fx:id="statTotalUsers" text="0" styleClass="stat-value-white"/>
                                    <Label fx:id="statTotalTrend" text="All registered accounts" styleClass="stat-label-white"/>
                                </VBox>

                                <VBox GridPane.columnIndex="1" styleClass="stat-card-teal" spacing="6">
                                    <Label text="ACTIVE DOCTORS" styleClass="stat-label-white"/>
                                    <Label fx:id="statDoctors" text="0" styleClass="stat-value-white"/>
                                    <Label fx:id="statDoctorsTrend" text="Verified &amp; practicing" styleClass="stat-label-white"/>
                                </VBox>

                                <VBox GridPane.columnIndex="2" styleClass="stat-card-teal" spacing="6">
                                    <Label text="ACTIVE PATIENTS" styleClass="stat-label-white"/>
                                    <Label fx:id="statPatients" text="0" styleClass="stat-value-white"/>
                                    <Label fx:id="statPatientsTrend" text="Verified &amp; active" styleClass="stat-label-white"/>
                                </VBox>

                                <VBox GridPane.columnIndex="3" styleClass="stat-card-white" spacing="6">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="PENDING APPROVALS" styleClass="stat-label-dark" HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="pendingCountLabel" text="0" styleClass="badge-urgent"/>
                                    </HBox>
                                    <Label text="Doctor registrations" styleClass="body-md"/>
                                    <Button text="Review Now" styleClass="btn-outline" onAction="#handleSwitchToApprovals" maxWidth="Infinity"/>
                                </VBox>
                            </GridPane>

                            <VBox styleClass="stat-card-white" spacing="15">
                                <Label text="USER DISTRIBUTION" styleClass="stat-label-dark"/>
                                <VBox spacing="10">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label fx:id="distDoctorsLabel" text="Doctors: 0" styleClass="body-md" prefWidth="120"/>
                                        <ProgressBar fx:id="distDoctorsBar" progress="0" HBox.hgrow="ALWAYS" prefHeight="10" styleClass="progress-teal"/>
                                        <Label fx:id="distDoctorsPct" text="0%" styleClass="body-md" prefWidth="50"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label fx:id="distPatientsLabel" text="Patients: 0" styleClass="body-md" prefWidth="120"/>
                                        <ProgressBar fx:id="distPatientsBar" progress="0" HBox.hgrow="ALWAYS" prefHeight="10" styleClass="progress-amber"/>
                                        <Label fx:id="distPatientsPct" text="0%" styleClass="body-md" prefWidth="50"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label fx:id="distAdminsLabel" text="Admins: 0" styleClass="body-md" prefWidth="120"/>
                                        <ProgressBar fx:id="distAdminsBar" progress="0" HBox.hgrow="ALWAYS" prefHeight="10" styleClass="progress-indigo"/>
                                        <Label fx:id="distAdminsPct" text="0%" styleClass="body-md" prefWidth="50"/>
                                    </HBox>
                                </VBox>
                                <Label fx:id="distRecent" text="0 new registrations this week" styleClass="body-md"/>
                            </VBox>

                        </VBox>
                    </ScrollPane>
                </VBox>

                <VBox fx:id="usersView" spacing="0" styleClass="content-area" visible="false" managed="false">
                    <ScrollPane fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox spacing="24">
                            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                            <HBox alignment="BOTTOM_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="User Management" styleClass="h2"/>
                                    <Label text="Manage clinical staff and patient records." styleClass="body-md"/>
                                </VBox>
                            </HBox>

                            <HBox styleClass="filters-container" spacing="16" alignment="CENTER_LEFT">
                                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                                <HBox alignment="CENTER" spacing="8" styleClass="filter-chip">
                                    <Label text="USER TYPE:" styleClass="label-caps-sm"/>
                                    <ComboBox fx:id="filterTypeCombo" prefWidth="120" promptText="All Types" styleClass="filter-combo"/>
                                </HBox>
                                <HBox alignment="CENTER" spacing="8" styleClass="filter-chip">
                                    <Label text="STATUS:" styleClass="label-caps-sm"/>
                                    <ComboBox fx:id="filterStatusCombo" prefWidth="120" promptText="All Statuses" styleClass="filter-combo"/>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Hyperlink text="CLEAR ALL FILTERS" styleClass="link-secondary" onAction="#handleClearFilters"/>
                            </HBox>

                            <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
                                <TableView fx:id="userTable" VBox.vgrow="ALWAYS" prefHeight="400">
                                    <columns>
                                        <TableColumn fx:id="colName" text="NAME" prefWidth="250"/>
                                        <TableColumn fx:id="colRole" text="USER TYPE" prefWidth="180"/>
                                        <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="250"/>
                                        <TableColumn fx:id="colStatus" text="STATUS" prefWidth="120"/>
                                        <TableColumn fx:id="colAction" text="ACTIONS" prefWidth="120"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                        </VBox>
                    </ScrollPane>
                </VBox>

                <VBox fx:id="approvalsView" spacing="0" styleClass="content-area" visible="false" managed="false">
                    <ScrollPane fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox spacing="24">
                            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                            <HBox alignment="BOTTOM_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="Doctor Approvals" styleClass="h2"/>
                                    <Label text="Verify and approve new medical registrations." styleClass="body-md"/>
                                </VBox>
                            </HBox>

                            <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
                                <TableView fx:id="approvalTable" VBox.vgrow="ALWAYS" prefHeight="400">
                                    <columns>
                                        <TableColumn fx:id="colApproveName" text="NAME" prefWidth="250"/>
                                        <TableColumn fx:id="colApproveSpecialty" text="SPECIALTY" prefWidth="200"/>
                                        <TableColumn fx:id="colApproveEmail" text="EMAIL" prefWidth="250"/>
                                        <TableColumn fx:id="colApproveStatus" text="STATUS" prefWidth="120"/>
                                        <TableColumn fx:id="colApproveAction" text="ACTIONS" prefWidth="180"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                        </VBox>
                    </ScrollPane>
                </VBox>

                <VBox fx:id="logsView" spacing="0" styleClass="content-area" visible="false" managed="false">
                    <ScrollPane fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox spacing="24">
                            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                            <HBox alignment="BOTTOM_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="System Logs" styleClass="h2"/>
                                    <Label text="Track all user actions, logins, and security events." styleClass="body-md"/>
                                </VBox>
                                <HBox spacing="12">
                                    <Button text="REFRESH" onAction="#handleRefreshLogs" styleClass="btn-outline"/>
                                </HBox>
                            </HBox>

                            <HBox spacing="16" alignment="CENTER_LEFT" styleClass="filters-container">
                                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                                <TextField fx:id="logSearchField" promptText="Search users or details..." prefWidth="300" styleClass="search-field"/>
                                <HBox alignment="CENTER" spacing="8" styleClass="filter-chip">
                                    <Label text="ACTION:" styleClass="label-caps-sm"/>
                                    <ComboBox fx:id="logActionFilter" prefWidth="150" promptText="All Actions" styleClass="filter-combo"/>
                                </HBox>
                            </HBox>

                            <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
                                <TableView fx:id="logTable" VBox.vgrow="ALWAYS" prefHeight="500">
                                    <columns>
                                        <TableColumn fx:id="colLogId" text="ID" prefWidth="60"/>
                                        <TableColumn fx:id="colLogUser" text="USER" prefWidth="200"/>
                                        <TableColumn fx:id="colLogAction" text="ACTION" prefWidth="150"/>
                                        <TableColumn fx:id="colLogDetails" text="DETAILS" prefWidth="400"/>
                                        <TableColumn fx:id="colLogDate" text="TIMESTAMP" prefWidth="180"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                        </VBox>
                    </ScrollPane>
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
