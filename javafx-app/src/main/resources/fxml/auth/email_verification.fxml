<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.docbook.controllers.auth.EmailVerificationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="Email Verification">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>
    <Label fx:id="emailDisplayLabel" text="A verification code has been sent to your email." wrapText="true" />
    <TextField fx:id="verificationCodeField" promptText="Enter Verification Code" />
    <Button onAction="#handleVerify" prefWidth="200.0" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="Verify Email" />
    <Button onAction="#handleResendCode" prefWidth="200.0" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Resend Code" />
    <Button onAction="#handleBackToLogin" prefWidth="200.0" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="Back to Login" />
    <Label fx:id="messageLabel" textFill="RED" />
</VBox>