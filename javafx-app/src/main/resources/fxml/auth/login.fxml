<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Line?>

<AnchorPane fx:id="loginRoot" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="org.docbook.controllers.auth.LoginController"
            stylesheets="@../../css/style.css"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #667eea;">

    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" 
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        
        <!-- Main Login Card -->
        <VBox styleClass="login-card" maxWidth="420" StackPane.alignment="CENTER"
              style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0.3, 0, 10);">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>
            <spacing>24</spacing>
            
            <!-- Header -->
            <VBox spacing="8" alignment="CENTER">
                <!-- Medical Icon -->
                <StackPane style="-fx-background-color: #0058be; -fx-background-radius: 12;" prefWidth="56" prefHeight="56">
                    <Text text="✚" style="-fx-font-size: 28px; -fx-fill: white;"/>
                </StackPane>
                
                <Text text="DocBook" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                <Label text="Connexion à votre espace médical" 
                       style="-fx-font-size: 14px; -fx-text-fill: #64748b;" 
                       textAlignment="CENTER" wrapText="true" prefWidth="340"/>
            </VBox>
            
            <!-- Form -->
            <VBox spacing="16">
                <!-- Email Field -->
                <VBox spacing="6">
                    <Text text="Email" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-fill: #374151;"/>
                    <TextField fx:id="emailField" promptText="votre.email@exemple.com" 
                               style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12 14; -fx-font-size: 14px;"/>
                </VBox>
                
                <!-- Password Field -->
                <VBox spacing="6">
                    <HBox spacing="0" alignment="CENTER_LEFT">
                        <Text text="Mot de passe" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-fill: #374151;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Text text="Mot de passe oublié ?" 
                              style="-fx-font-size: 12px; -fx-fill: #0058be; -fx-cursor: hand;"
                              onMouseClicked="#goToForgotPassword"/>
                    </HBox>
                    <PasswordField fx:id="passwordField" promptText="••••••••" 
                                   style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12 14; -fx-font-size: 14px;"/>
                </VBox>
                
                <!-- Login Button -->
                <Button fx:id="loginBtn" text="Se connecter" onAction="#handleLogin" 
                        style="-fx-background-color: #0058be; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-padding: 14 0; -fx-cursor: hand;"
                        maxWidth="1.7976931348623157E308"/>
            </VBox>
            
            <!-- Divider -->
            <StackPane>
                <Line startX="0" endX="160" startY="0" endY="0" style="-fx-stroke: #e2e8f0;" StackPane.alignment="CENTER"/>
                <Text text="ou" style="-fx-font-size: 12px; -fx-fill: #94a3b8; -fx-background-color: white; -fx-padding: 4 8;" StackPane.alignment="CENTER"/>
            </StackPane>
            
            <!-- Google Login Button -->
            <Button fx:id="googleLoginBtn" text="Se connecter avec Google" 
                    onAction="#handleGoogleLogin" 
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-text-fill: #374151; -fx-font-size: 14px; -fx-font-weight: 500; -fx-padding: 12 0; -fx-cursor: hand;"
                    maxWidth="1.7976931348623157E308"/>
            
            <!-- Signup Link -->
            <HBox alignment="CENTER" spacing="6">
                <Text text="Pas encore de compte ?" style="-fx-font-size: 13px; -fx-fill: #64748b;"/>
                <Text text="Créer un compte" 
                      style="-fx-font-size: 13px; -fx-fill: #0058be; -fx-font-weight: 600; -fx-cursor: hand;"
                      onMouseClicked="#goToSignup"/>
            </HBox>
        </VBox>
    </StackPane>
</AnchorPane>