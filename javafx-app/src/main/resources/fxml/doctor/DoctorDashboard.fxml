<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.docbook.controllers.doctor.DoctorController"
            stylesheets="/css/style.css"
            prefHeight="800.0" prefWidth="1200.0">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="patient-sidebar" prefWidth="260" minWidth="260" maxWidth="260" spacing="0">
            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 20 16 20;" spacing="12">
                <StackPane style="-fx-background-color: #0058be; -fx-background-radius: 10;" minWidth="40" minHeight="40" prefWidth="40" prefHeight="40">
                    <Text text="✚" style="-fx-font-size: 20px; -fx-fill: white;"/>
                </StackPane>
                <Text text="DocBook" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-fill: #1e293b;"/>
            </HBox>
            
            <!-- Doctor Info -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 8 20;">
                <StackPane style="-fx-background-color: #e0e7ff; -fx-background-radius: 20;" prefWidth="40" prefHeight="40">
                    <Text text="DR" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #0058be;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="doctorNameLabel" text="Dr. Nom" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
                    <Text text="Médecin" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                </VBox>
            </HBox>
            
            <!-- Navigation -->
            <VBox styleClass="sidebar-nav" spacing="2" style="-fx-padding: 8 12;">
                <Button text="🏠  Tableau de bord" styleClass="nav-link-active" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="📹  Téléconsultations" onAction="#openTeleconsultationsView" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="👥  Patients" onAction="#openPatientListView" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="📄  Documents" styleClass="nav-link" prefWidth="220" onAction="#openDocumentView" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="📊  Statistiques" styleClass="nav-link" prefWidth="220" onAction="#openStatsView" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="👤  Mon Profil" styleClass="nav-link" prefWidth="220" onAction="#handleProfileNav" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Server Status -->
            <VBox style="-fx-padding: 16 20; -fx-background-color: #f1f5f9;">
                <Text text="STATUT SERVEUR" style="-fx-font-size: 10px; -fx-fill: #64748b; -fx-letter-spacing: 0.05em;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <StackPane>
                        <Circle radius="4" fill="#16a34a"/>
                    </StackPane>
                    <Text text="Opérationnel" style="-fx-font-size: 12px; -fx-fill: #16a34a;"/>
                </HBox>
            </VBox>
            
            <!-- Logout -->
            <Button text="Déconnexion" onAction="#logout"
                    style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-background-radius: 8; 
                           -fx-font-size: 12px; -fx-padding: 8 12; -fx-cursor: hand; -fx-margin: 0 16 16 16;"
                    prefWidth="220"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <!-- MAIN CONTENT AREA -->
        <ScrollPane fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
            <VBox style="-fx-padding: 24; -fx-background-color: #f9f9ff;" spacing="24">
                    
                    <!-- Page Header -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox>
                            <Text text="Tableau de bord" styleClass="h1"/>
                            <Text text="Bienvenue, voici le résumé de votre activité aujourd'hui." 
                                  styleClass="body" style="-fx-text-fill: #727785;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Ajouter un patient" styleClass="btn-add" onAction="#clearDossierPanel"/>
                    </HBox>
                    
                    <!-- STAT CARDS (Bento Grid) -->
                    <HBox spacing="24">
                        <!-- Card 1: Total Patients -->
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Text text="TOTAL PATIENTS" styleClass="stat-card-label"/>
                                    <Label fx:id="totalPatientsLabel" text="1,284" styleClass="stat-card-value"/>
                                    <HBox styleClass="stat-card-trend" style="-fx-text-fill: #16a34a;">
                                        <Text text="↑"/>
                                        <Text text="+12% ce mois"/>
                                    </HBox>
                                </VBox>
                                <StackPane styleClass="stat-card-icon, stat-card-icon-primary" prefWidth="48" prefHeight="48">
                                    <Text text="👥" style="-fx-font-size: 24px;"/>
                                </StackPane>
                            </HBox>
                        </VBox>
                        
                        <!-- Card 2: Consultations -->
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Text text="CONSULTATIONS DU JOUR" styleClass="stat-card-label"/>
                                    <Label fx:id="todayConsultationsLabel" text="0" styleClass="stat-card-value"/>
                                    <HBox styleClass="stat-card-trend" style="-fx-text-fill: #0058be;">
                                        <Text text="⏱"/>
                                        <Text text="En attente"/>
                                    </HBox>
                                </VBox>
                                <StackPane styleClass="stat-card-icon, stat-card-icon-secondary" prefWidth="48" prefHeight="48">
                                    <Text text="📅" style="-fx-font-size: 24px;"/>
                                </StackPane>
                            </HBox>
                        </VBox>
                        
                        <!-- Card 3: Messages -->
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Text text="DOSSIERS ACTIFS" styleClass="stat-card-label"/>
                                    <Label fx:id="activeDossiersLabel" text="0" styleClass="stat-card-value"/>
                                    <HBox styleClass="stat-card-trend" style="-fx-text-fill: #924700;">
                                        <Text text="📁"/>
                                        <Text text="Total"/>
                                    </HBox>
                                </VBox>
                                <StackPane styleClass="stat-card-icon, stat-card-icon-tertiary" prefWidth="48" prefHeight="48">
                                    <Text text="📧" style="-fx-font-size: 24px;"/>
                                </StackPane>
                            </HBox>
                        </VBox>
                    </HBox>
                    
                    <!-- MAIN CONTENT GRID -->
                    <HBox spacing="24" VBox.vgrow="ALWAYS">
                        <!-- Left: Patient Table -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="content-card" style="-fx-padding: 0;">
                            <HBox style="-fx-padding: 24 24 16 24;" alignment="CENTER_LEFT" spacing="16">
                                <Text text="Patients récents" styleClass="h2"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="searchField" promptText="🔍 Rechercher..." 
                                           onKeyReleased="#searchPatients"
                                           style="-fx-background-color: white; -fx-background-radius: 8; 
                                                  -fx-border-color: #e2e8f0; -fx-border-radius: 8; 
                                                  -fx-padding: 8 16; -fx-pref-width: 200;"/>
                                <Text text="Voir tout" styleClass="label" style="-fx-text-fill: #0058be; -fx-cursor: hand;"/>
                            </HBox>
                            
                            <TableView fx:id="patientTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                                <columns>
                                    <TableColumn fx:id="numCol" text="N° Dossier" prefWidth="120"/>
                                    <TableColumn fx:id="nameCol" text="Nom" prefWidth="150"/>
                                    <TableColumn fx:id="firstNameCol" text="Prénom" prefWidth="150"/>
                                    <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                        
                        <!-- Right: Sidebar Info -->
                        <VBox prefWidth="350" spacing="24">
                            <!-- Notifications Card -->
                            <VBox styleClass="content-card">
                                <Text text="Actualités &amp; Rappels" styleClass="h3" style="-fx-padding: 0 0 16 0;"/>
                                <VBox spacing="16">
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <StackPane prefWidth="8" prefHeight="8">
                                            <Circle radius="4" fill="#0058be"/>
                                        </StackPane>
                                        <VBox spacing="2">
                                            <Text text="Réunion d'équipe" styleClass="body-bold"/>
                                            <Text text="Demain à 08:00 - Salle A" styleClass="caption"/>
                                        </VBox>
                                    </HBox>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <StackPane prefWidth="8" prefHeight="8">
                                            <Circle radius="4" fill="#f59e0b"/>
                                        </StackPane>
                                        <VBox spacing="2">
                                            <Text text="Renouvellement licence" styleClass="body-bold"/>
                                            <Text text="Expire dans 5 jours" styleClass="caption"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </VBox>
                            
                            <!-- Goal Progress Card -->
                            <VBox styleClass="content-card" style="-fx-background-color: #2170e4; -fx-text-fill: white;">
                                <Text text="OBJECTIF MENSUEL" style="-fx-font-size: 10px; -fx-fill: rgba(255,255,255,0.7); -fx-letter-spacing: 0.05em;"/>
                                <Text text="85% Consultations" style="-fx-font-size: 20px; -fx-font-weight: 600; -fx-fill: white; -fx-padding: 8 0 16 0;"/>
                                <ProgressBar progress="0.85" styleClass="progress-bar-custom" 
                                             style="-fx-accent: white;"/>
                            </VBox>
                        </VBox>
                    </HBox>
                    
                    <!-- Patient Form Section (Hidden by default in real app, shown when selecting) -->
                    <VBox styleClass="content-card" spacing="16">
                        <Text text="Détails du Patient" styleClass="h2"/>
                        <Separator style="-fx-opacity: 0.2;"/>
                        
                        <GridPane hgap="20" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>

                            <VBox GridPane.columnIndex="0" spacing="5">
                                <Label text="N° Dossier" styleClass="label"/>
                                <TextField fx:id="numDossierField" styleClass="form-input"/>
                                <Text fx:id="numDossierError" style="-fx-fill: #ba1a1a; -fx-font-size: 11px;"/>
                            </VBox>

                            <VBox GridPane.columnIndex="1" spacing="5">
                                <Label text="Nom" styleClass="label"/>
                                <TextField fx:id="nomField" styleClass="form-input"/>
                                <Text fx:id="nomError" style="-fx-fill: #ba1a1a; -fx-font-size: 11px;"/>
                            </VBox>

                            <VBox GridPane.columnIndex="2" spacing="5">
                                <Label text="Prénom" styleClass="label"/>
                                <TextField fx:id="prenomField" styleClass="form-input"/>
                                <Text fx:id="prenomError" style="-fx-fill: #ba1a1a; -fx-font-size: 11px;"/>
                            </VBox>

                            <VBox GridPane.columnIndex="3" spacing="5">
                                <Label text="Genre (M/F)" styleClass="label"/>
                                <TextField fx:id="genreField" styleClass="form-input"/>
                                <Text fx:id="genreError" style="-fx-fill: #ba1a1a; -fx-font-size: 11px;"/>
                            </VBox>

                            <VBox GridPane.rowIndex="1" GridPane.columnIndex="0" spacing="5">
                                <Label text="Date Naissance" styleClass="label"/>
                                <DatePicker fx:id="dateNaissanceField" maxWidth="Infinity" styleClass="form-input"/>
                                <Text fx:id="dateNaissanceError" style="-fx-fill: #ba1a1a; -fx-font-size: 11px;"/>
                            </VBox>

                            <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2" spacing="5">
                                <Label text="Email" styleClass="label"/>
                                <TextField fx:id="emailPatientField" styleClass="form-input"/>
                                <Text fx:id="emailError" style="-fx-fill: #ba1a1a; -fx-font-size: 11px;"/>
                            </VBox>

                            <VBox GridPane.rowIndex="1" GridPane.columnIndex="3" spacing="5">
                                <Label text="Téléphone" styleClass="label"/>
                                <TextField fx:id="telephoneField" styleClass="form-input"/>
                                <Text fx:id="telephoneError" style="-fx-fill: #ba1a1a; -fx-font-size: 11px;"/>
                            </VBox>

                            <VBox GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2" spacing="5">
                                <Label text="Adresse" styleClass="label"/>
                                <TextField fx:id="adresseField" styleClass="form-input"/>
                                <Text fx:id="adresseError" style="-fx-fill: #ba1a1a; -fx-font-size: 11px;"/>
                            </VBox>

                            <VBox GridPane.rowIndex="2" GridPane.columnIndex="2" GridPane.columnSpan="2" spacing="5">
                                <Label text="Remarques" styleClass="label"/>
                                <TextArea fx:id="remarquesField" styleClass="form-input" prefHeight="60"/>
                                <HBox spacing="8">
                                    <Button text="🤖 Analyser" onAction="#generateInitialAnalysis" 
                                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 6; 
                                                   -fx-font-size: 11px; -fx-padding: 6 12;"/>
                                    <Button text="💡 Suggestions" onAction="#getAISuggestions" 
                                            style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 6; 
                                                   -fx-font-size: 11px; -fx-padding: 6 12;"/>
                                </HBox>
                            </VBox>
                        </GridPane>

                        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 16 0 0 0;">
                            <Button text="Ajouter" onAction="#addDossierPanel" styleClass="btn-primary" 
                                    style="-fx-padding: 12 32;"/>
                            <Button text="Modifier" onAction="#updateDossierPanel" 
                                    style="-fx-background-color: #6b38d4; -fx-text-fill: white; -fx-background-radius: 8; 
                                           -fx-font-weight: 600; -fx-padding: 12 32;"/>
                            <Button text="🗑️ Supprimer" onAction="#deleteDossierPanel" 
                                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 8; 
                                           -fx-font-weight: 600; -fx-padding: 12 32;"/>
                            <Button text="📥 Exporter CSV" onAction="#exportPatientsCSV" 
                                    style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 8; 
                                           -fx-font-weight: 600; -fx-padding: 12 24;"/>
                            <Button text="QR Code" onAction="#showPatientQrPopup" 
                                    style="-fx-background-color: #0891b2; -fx-text-fill: white; -fx-background-radius: 8; 
                                           -fx-font-weight: 600; -fx-padding: 12 24;"/>
                            <Button text="Réinitialiser" onAction="#clearDossierPanel" 
                                    style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-cursor: hand; 
                                           -fx-font-weight: 600; -fx-padding: 12 32;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Text fx:id="statusText"/>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
    </center>
    
    <!-- FAB (Floating Action Button) -->
    <bottom>
        <StackPane alignment="BOTTOM_RIGHT" AnchorPane.bottomAnchor="30" AnchorPane.rightAnchor="30">
            <Button styleClass="fab" prefWidth="56" prefHeight="56">
                <Text text="✎" styleClass="fab-icon"/>
            </Button>
        </StackPane>
    </bottom>
</BorderPane>