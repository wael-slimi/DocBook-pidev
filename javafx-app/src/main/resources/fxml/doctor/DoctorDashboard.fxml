<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.docbook.controllers.doctor.DoctorController"
            stylesheets="/css/style.css"
            prefHeight="800.0" prefWidth="1200.0">

    <left>
        <VBox styleClass="dashboard-sidebar" prefWidth="250" spacing="20" style="-fx-background-color: #1e293b; -fx-padding: 20;">
            <VBox alignment="CENTER" spacing="10">
                <Text text="DocBook" style="-fx-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                <Text text="Espace Médecin" style="-fx-fill: #94a3b8;"/>
            </VBox>

            <Separator style="-fx-opacity: 0.1;"/>

            <VBox spacing="10">
                <Button text="Dossiers Patients" styleClass="nav-link, nav-link-active" prefWidth="210" style="-fx-alignment: CENTER_LEFT;"/>
                <Button text="Documents" styleClass="nav-link" prefWidth="210" onAction="#openDocumentView" style="-fx-alignment: CENTER_LEFT;"/>
                <Button text="Historique Adhérence" styleClass="nav-link" prefWidth="210" onAction="#openAdherenceHistory" style="-fx-alignment: CENTER_LEFT;"/>
                <Button text="📊 Statistiques" styleClass="nav-link" prefWidth="210" onAction="#openStatsView" style="-fx-alignment: CENTER_LEFT;"/>
                <Button text="🗺️ Carte" styleClass="nav-link" prefWidth="210" onAction="#openMapView" style="-fx-alignment: CENTER_LEFT;"/>
                <Button text="Mon Profil" styleClass="nav-link" prefWidth="210" onAction="#handleProfileNav" style="-fx-alignment: CENTER_LEFT;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button text="Déconnexion" onAction="#logout"
                    style="-fx-background-color: #334155; -fx-text-fill: #fca5a5; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"
                    prefWidth="210" styleClass="logout-btn"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: #f8fafc;">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox>
                        <Text text="Gestion des Dossiers" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                        <Text text="Consultez et gérez les informations médicales de vos patients." style="-fx-fill: #64748b;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalPatientsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3b82f6; -fx-background-color: white; -fx-padding: 10 20; -fx-background-radius: 10;"/>
                </HBox>

                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="numCol" text="N° Dossier" prefWidth="100"/>
                                <TableColumn fx:id="nameCol" text="Nom" prefWidth="150"/>
                                <TableColumn fx:id="firstNameCol" text="Prénom" prefWidth="150"/>
                                <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        </TableView>
                    </VBox>

                    <VBox prefWidth="450" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Text text="Détails du Patient" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-fill: #1e293b;"/>
                        <Separator style="-fx-padding: 10 0;"/>

                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <GridPane hgap="10" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>

                                <VBox GridPane.columnIndex="0" GridPane.columnSpan="2" spacing="5">
                                    <Label text="Numéro de Dossier" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="numDossierField"/><Text fx:id="numDossierError" style="-fx-fill: #ef4444;"/>
                                </VBox>

                                <VBox GridPane.rowIndex="1" GridPane.columnIndex="0" spacing="5">
                                    <Label text="Nom" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="nomField"/><Text fx:id="nomError" style="-fx-fill: #ef4444;"/>
                                </VBox>

                                <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="5">
                                    <Label text="Prénom" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="prenomField"/><Text fx:id="prenomError" style="-fx-fill: #ef4444;"/>
                                </VBox>

                                <VBox GridPane.rowIndex="2" GridPane.columnIndex="0" spacing="5">
                                    <Label text="Date Naissance" style="-fx-font-weight: bold;"/>
                                    <DatePicker fx:id="dateNaissanceField" maxWidth="Infinity"/><Text fx:id="dateNaissanceError" style="-fx-fill: #ef4444;"/>
                                </VBox>

                                <VBox GridPane.rowIndex="2" GridPane.columnIndex="1" spacing="5">
                                    <Label text="Genre (M/F)" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="genreField"/><Text fx:id="genreError" style="-fx-fill: #ef4444;"/>
                                </VBox>

                                <VBox GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2" spacing="5">
                                    <Label text="Email (Lien Compte)" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="emailPatientField"/><Text fx:id="emailError" style="-fx-fill: #ef4444;"/>
                                </VBox>

                                <VBox GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2" spacing="5">
                                    <Label text="Téléphone" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="telephoneField"/><Text fx:id="telephoneError" style="-fx-fill: #ef4444;"/>
                                </VBox>

                                <VBox GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2" spacing="5">
                                    <Label text="Adresse" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="adresseField"/><Text fx:id="adresseError" style="-fx-fill: #ef4444;"/>
                                </VBox>

                                <VBox GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="2" spacing="5">
                                    <Label text="Remarques" style="-fx-font-weight: bold;"/>
                                    <TextArea fx:id="remarquesField" prefHeight="80" wrapText="true"/>
                                </VBox>
                            </GridPane>
                        </ScrollPane>

                        <VBox spacing="10" style="-fx-padding: 15 0 0 0;">
                            <HBox spacing="10">
                                <Button text="Ajouter" onAction="#addDossierPanel" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="Modifier" onAction="#updateDossierPanel" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                            <Button text="Réinitialiser"
                                    onAction="#clearDossierPanel"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-cursor: hand;"/>
                            <Text fx:id="statusText" textAlignment="CENTER" wrappingWidth="360"/>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>