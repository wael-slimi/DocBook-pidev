<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.docbook.controllers.doctor.PatientListController"
            stylesheets="/css/style.css"
            prefHeight="800.0" prefWidth="1200.0">

    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="patient-sidebar" prefWidth="260" minWidth="260" maxWidth="260" spacing="0">
            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 20 16 20;" spacing="12">
                <StackPane style="-fx-background-color: #0058be; -fx-background-radius: 10;" minWidth="40" minHeight="40" prefWidth="40" prefHeight="40">
                    <Text text="✚" style="-fx-font-size: 20px; -fx-fill: white;"/>
                </StackPane>
                <Text text="DocBook" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-fill: #1e293b;"/>
            </HBox>
            
            <!-- Navigation -->
            <VBox styleClass="sidebar-nav" spacing="2" style="-fx-padding: 8 12;">
                <Button text="🏠  Tableau de bord" onAction="#goToDashboard" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="📄  Documents" onAction="#openDocumentView" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="📊  Statistiques" onAction="#openStatsView" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="👤  Mon Profil" onAction="#handleProfileNav" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Logout -->
            <Button text="Déconnexion" onAction="#logout"
                    style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-background-radius: 8; 
                           -fx-font-size: 12px; -fx-padding: 8 12; -fx-cursor: hand; -fx-margin: 0 16 16 16;"
                    prefWidth="220"/>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <HBox spacing="0">
            <!-- Patient List -->
            <VBox prefWidth="350" style="-fx-background-color: white; -fx-padding: 20;">
                <Text text="Mes Patients" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <TextField fx:id="searchField" promptText="🔍 Rechercher..." 
                           onKeyReleased="#searchPatients"
                           style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; 
                                  -fx-padding: 10 16; -fx-margin: 16 0;"/>
                
                <ListView fx:id="patientList" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                </ListView>
            </VBox>
            
            <!-- Patient Details & AI Tools -->
            <VBox HBox.hgrow="ALWAYS" style="-fx-padding: 30; -fx-background-color: #f8fafc;">
                <!-- Selected Patient Info -->
                <VBox fx:id="patientDetailsPane" visible="true" managed="true" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 24; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <Text text="Patient Sélectionné" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Text fx:id="selectedPatientName" text="Sélectionnez un patient" style="-fx-font-size: 14px; -fx-fill: #64748b; -fx-margin: 8 0 16 0;"/>
                    
                    <GridPane hgap="20" vgap="15">
                        <Label text="Numéro Dossier:" style="-fx-font-size: 12px; -fx-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Text fx:id="dossierNumText" text="-" style="-fx-font-size: 14px; -fx-font-weight: 500;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        
                        <Label text="Email:" style="-fx-font-size: 12px; -fx-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Text fx:id="dossierEmailText" text="-" style="-fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        
                        <Label text="Téléphone:" style="-fx-font-size: 12px; -fx-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Text fx:id="dossierTelText" text="-" style="-fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        
                        <Label text="Adresse:" style="-fx-font-size: 12px; -fx-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Text fx:id="dossierAdresseText" text="-" style="-fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>
                </VBox>
                
                <!-- AI Tools Section -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 24; -fx-margin: 20 0 0 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <Text text="Outils AI" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Text text="Sélectionnez un patient puis utilisez les outils ci-dessous" style="-fx-font-size: 12px; -fx-fill: #64748b; -fx-margin: 8 0 16 0;"/>
                    
                    <VBox spacing="12">
                        <!-- AI Snapshot -->
                        <VBox style="-fx-background-color: #eff6ff; -fx-background-radius: 10; -fx-padding: 16;">
                            <Text text="📸 AI Snapshot" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-fill: #1e40af;"/>
                            <Text text="Générez un résumé médical en 3 phrases" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                            <Button text="Générer Snapshot" onAction="#generateSnapshot" 
                                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 6; 
                                           -fx-font-size: 12px; -fx-padding: 8 16; -fx-cursor: hand; -fx-margin: 8 0 0 0;"/>
                        </VBox>
                        
                        <!-- AI Assistant -->
                        <VBox style="-fx-background-color: #fdf4ff; -fx-background-radius: 10; -fx-padding: 16;">
                            <Text text="💡 AI Assistant" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-fill: #9d174d;"/>
                            <Text text="Obtenez des suggestions de diagnostic" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                            <Button text="Démarrer Assistant" onAction="#runDiagnosticAssistant" 
                                    style="-fx-background-color: #db2777; -fx-text-fill: white; -fx-background-radius: 6; 
                                           -fx-font-size: 12px; -fx-padding: 8 16; -fx-cursor: hand; -fx-margin: 8 0 0 0;"/>
                        </VBox>
                        
                        <!-- QR Code -->
                        <VBox style="-fx-background-color: #ecfeff; -fx-background-radius: 10; -fx-padding: 16;">
                            <Text text="📱 QR Code Patient" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-fill: #155e75;"/>
                            <Text text="Générez un QR code pour le patient" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                            <Button text="Générer QR" onAction="#generateQRCode" 
                                    style="-fx-background-color: #0891b2; -fx-text-fill: white; -fx-background-radius: 6; 
                                           -fx-font-size: 12px; -fx-padding: 8 16; -fx-cursor: hand; -fx-margin: 8 0 0 0;"/>
                        </VBox>
                        
                        <!-- Export -->
                        <VBox style="-fx-background-color: #ecfdf5; -fx-background-radius: 10; -fx-padding: 16;">
                            <Text text="📥 Export" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-fill: #166534;"/>
                            <Text text="Exportez la liste des patients" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                            <Button text="Exporter CSV" onAction="#exportPatientsCSV" 
                                    style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 6; 
                                           -fx-font-size: 12px; -fx-padding: 8 16; -fx-cursor: hand; -fx-margin: 8 0 0 0;"/>
                        </VBox>
                    </VBox>
                </VBox>
                
                <Text fx:id="statusText" style="-fx-fill: #10b981; -fx-font-size: 12px; -fx-margin: 20 0 0 0;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>