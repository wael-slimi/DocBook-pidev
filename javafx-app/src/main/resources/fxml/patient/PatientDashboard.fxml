<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.docbook.controllers.patient.PatientController"
            stylesheets="@../../css/style.css"
            prefHeight="800.0" prefWidth="1200.0">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="patient-sidebar" prefWidth="260" minWidth="260" maxWidth="260" spacing="0">
            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 20 16 20;" spacing="12">
                <StackPane style="-fx-background-color: #0058be; -fx-background-radius: 10;" minWidth="40" minHeight="40" prefWidth="40" prefHeight="40">
                    <Text text="✚" style="-fx-font-size: 20px; -fx-fill: white;"/>
                </StackPane>
                <Text text="DocBook" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-fill: #1e293b;"/>
            </HBox>

            <!-- Navigation -->
            <VBox styleClass="sidebar-nav" spacing="2" style="-fx-padding: 8 12;">
                <Button text="🏠  Dashboard" onAction="#showHome" styleClass="nav-link-active" prefWidth="220"
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="📄  Documents" onAction="#openDocuments" styleClass="nav-link" prefWidth="220"
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="🔍  Médecins" onAction="#handleSearchNav" styleClass="nav-link" prefWidth="220"
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="🗺️  Carte" onAction="#openMap" styleClass="nav-link" prefWidth="220"
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="👤  Mon Profil" onAction="#handleProfileNav" styleClass="nav-link" prefWidth="220"
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- User Info -->
            <VBox style="-fx-padding: 16 20; -fx-background-color: #f1f5f9;" spacing="8">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane style="-fx-background-color: #e0e7ff; -fx-background-radius: 20;" prefWidth="36" prefHeight="36">
                        <Text text="PN" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-fill: #0058be;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="patientNameText" text="Patient" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
                        <Text text="Patient" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                    </VBox>
                </HBox>
                <Button text="Déconnexion" onAction="#logout"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-background-radius: 8;
                               -fx-font-size: 12px; -fx-padding: 8 12; -fx-cursor: hand;"
                        prefWidth="220"/>
            </VBox>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
                <VBox style="-fx-padding: 24; -fx-background-color: #f8fafc;" spacing="24">

                    <!-- Page Header -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="4">
                            <Text text="Bienvenue sur DocBook" style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-fill: #1e293b;"/>
                            <Text text="Gérez vos dossiers médicaux et regardez vos prescriptions."
                                  style="-fx-font-size: 14px; -fx-fill: #64748b;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- STAT CARDS -->
                    <HBox spacing="20">
                        <!-- Card 1 -->
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0.3, 0, 2);"
                              HBox.hgrow="ALWAYS">
                            <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 20;">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Text text="DOSSIERS MÉDICAUX" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                                    <Label fx:id="dossiersCountLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #1e293b;"/>
                                    <Text text="Actifs" style="-fx-font-size: 12px; -fx-fill: #16a34a;"/>
                                </VBox>
                                <StackPane style="-fx-background-color: #dbeafe; -fx-background-radius: 10;" prefWidth="48" prefHeight="48">
                                    <Text text="📁" style="-fx-font-size: 22px;"/>
                                </StackPane>
                            </HBox>
                        </VBox>

                        <!-- Card 2 -->
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0.3, 0, 2);"
                              HBox.hgrow="ALWAYS">
                            <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 20;">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Text text="PRESCRIPTIONS" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                                    <Label fx:id="prescriptionsCountLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #1e293b;"/>
                                    <Text text="En cours" style="-fx-font-size: 12px; -fx-fill: #7c3aed;"/>
                                </VBox>
                                <StackPane style="-fx-background-color: #ede9fe; -fx-background-radius: 10;" prefWidth="48" prefHeight="48">
                                    <Text text="💊" style="-fx-font-size: 22px;"/>
                                </StackPane>
                            </HBox>
                        </VBox>

                        <!-- Card 3 -->
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0.3, 0, 2);"
                              HBox.hgrow="ALWAYS">
                            <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 20;">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Text text="RENDEZ-VOUS" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                                    <Label fx:id="appointmentsCountLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #1e293b;"/>
                                    <Text text="À venir" style="-fx-font-size: 12px; -fx-fill: #ea580c;"/>
                                </VBox>
                                <StackPane style="-fx-background-color: #ffedd5; -fx-background-radius: 10;" prefWidth="48" prefHeight="48">
                                    <Text text="📅" style="-fx-font-size: 22px;"/>
                                </StackPane>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- MAIN CONTENT GRID -->
                    <HBox spacing="24" VBox.vgrow="ALWAYS">
                        <!-- Left: Medical History -->
                        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0.3, 0, 2);">
                            <HBox style="-fx-padding: 20 20 16 20;" alignment="CENTER_LEFT" spacing="16">
                                <Text text="Historique Médical" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-fill: #1e293b;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="+ Nouveau" style="-fx-background-color: #0058be; -fx-text-fill: white;
                                            -fx-font-size: 12px; -fx-font-weight: 600; -fx-background-radius: 6;
                                            -fx-padding: 8 16; -fx-cursor: hand;"/>
                            </HBox>

                            <VBox fx:id="dossiersContainer" spacing="0">
                                <!-- Header — Label used so prefWidth works -->
                                <HBox style="-fx-background-color: #f8fafc; -fx-padding: 14 24; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                                    <Label text="Date"    prefWidth="100" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #64748b;"/>
                                    <Label text="Type"    prefWidth="160" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #64748b;"/>
                                    <Label text="Médecin" prefWidth="140" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #64748b;"/>
                                    <Label text="Statut"  prefWidth="100" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #64748b;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Right: Quick Actions -->
                        <VBox prefWidth="320" spacing="16">
                            <!-- Quick Search -->
                            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0.3, 0, 2); -fx-padding: 20;">
                                <Text text="Trouver un Médecin" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-fill: #1e293b;"/>
                                <TextField promptText="Spécialité, nom..."
                                           style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-background-radius: 8;
                                                  -fx-padding: 12; -fx-font-size: 14px;"/>
                                <Button text="Rechercher" style="-fx-background-color: #0058be; -fx-text-fill: white;
                                            -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>
                            </VBox>

                            <!-- Upcoming Appointments -->
                            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0.3, 0, 2); -fx-padding: 20;">
                                <Text text="Prochains Rendez-vous" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-fill: #1e293b;"/>
                                <VBox fx:id="appointmentsContainer" spacing="12">
                                    <Text text="Aucun rendez-vous prévu" style="-fx-font-size: 13px; -fx-fill: #94a3b8;"/>
                                </VBox>
                            </VBox>

                            <!-- Health Info -->
                            <VBox style="-fx-background-color: #0058be; -fx-background-radius: 12; -fx-padding: 20;">
                                <Text text="INFORMATIONS DE SANTÉ" style="-fx-font-size: 10px; -fx-fill: rgba(255,255,255,0.7);"/>
                                <HBox spacing="24" style="-fx-padding: 12 0;">
                                    <VBox spacing="4">
                                        <Text text="Groupe Sanguin" style="-fx-font-size: 10px; -fx-fill: rgba(255,255,255,0.7);"/>
                                        <Label fx:id="bloodTypeLabel" text="-" style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: white;"/>
                                    </VBox>
                                    <VBox spacing="4">
                                        <Text text="Allergies" style="-fx-font-size: 10px; -fx-fill: rgba(255,255,255,0.7);"/>
                                        <Label fx:id="allergiesLabel" text="-" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
    </center>
</BorderPane>