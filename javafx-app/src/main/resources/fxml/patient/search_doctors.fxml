<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.docbook.controllers.patient.SearchController"
            stylesheets="/css/style.css"
            prefHeight="800.0" prefWidth="1200.0">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="patient-sidebar" prefWidth="260" minWidth="260" maxWidth="260" spacing="0">
            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 20 16 20;" spacing="12">
                <StackPane style="-fx-background-color: #0058be; -fx-background-radius: 10;" minWidth="40" minHeight="40" prefWidth="40" prefHeight="40">
                    <Text text="✚" style="-fx-font-size: 20px; -fx-fill: white;"/>
                </StackPane>
                <Text text="DocBook" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-fill: #1e293b;"/>
            </HBox>
            
            <!-- Navigation -->
            <VBox styleClass="sidebar-nav" spacing="2" style="-fx-padding: 8 12;">
                <Button text="🏠  Dashboard" onAction="#showHome" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="📄  Documents" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="🔍  Médecins" styleClass="nav-link-active" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="🗺️  Carte" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="👤  Mon Profil" onAction="#goToProfile" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- User Info -->
            <VBox style="-fx-padding: 16 20; -fx-background-color: #f1f5f9;" spacing="8">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane style="-fx-background-color: #e0e7ff; -fx-background-radius: 20;" prefWidth="36" prefHeight="36">
                        <Text text="PN" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-fill: #0058be;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Patient" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
                        <Text text="Patient" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                    </VBox>
                </HBox>
                <Button text="Déconnexion" onAction="#logout"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-background-radius: 8; 
                               -fx-font-size: 12px; -fx-padding: 8 12; -fx-cursor: hand;"
                        prefWidth="220"/>
            </VBox>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox style="-fx-background-color: #f9f9ff; -fx-padding: 24;" spacing="24">
            
            <!-- Page Header -->
            <VBox spacing="8">
                <Text text="Trouver un Spécialiste" styleClass="h1"/>
                <Text text="Recherchez et contactez des médecins selon leur spécialité ou prix." 
                      styleClass="body" style="-fx-text-fill: #727785;"/>
            </VBox>
            
            <!-- Filter Bar -->
            <HBox spacing="20" alignment="BOTTOM_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Nom du médecin" styleClass="label"/>
                    <TextField fx:id="nameSearchField" promptText="Ex: Jean Dupont" 
                               styleClass="form-input"/>
                </VBox>
                
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Spécialité" styleClass="label"/>
                    <TextField fx:id="specialtySearchField" promptText="Ex: Cardiologue" 
                               styleClass="form-input"/>
                </VBox>
                
                <VBox spacing="6">
                    <Label text="Prix Max (TND)" styleClass="label"/>
                    <TextField fx:id="priceSearchField" promptText="Ex: 80" 
                               styleClass="form-input"/>
                </VBox>
            </HBox>
            
            <!-- Doctor Table -->
            <VBox styleClass="content-card" style="-fx-padding: 0;" VBox.vgrow="ALWAYS">
                <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colName" text="Nom" prefWidth="200"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
                        <TableColumn fx:id="colRole" text="Spécialité" prefWidth="180"/>
                        <TableColumn fx:id="colPrice" text="Prix (TND)" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
            
            <!-- Footer Tip -->
            <HBox alignment="CENTER_RIGHT">
                <Text text="💡 Astuce: Cliquez sur les colonnes pour trier par prix ou par nom." 
                      styleClass="caption" style="-fx-text-fill: #727785;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>