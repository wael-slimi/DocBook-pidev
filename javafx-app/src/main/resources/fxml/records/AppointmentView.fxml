<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.docbook.controllers.records.AppointmentController"
            prefWidth="1200" prefHeight="800">

    <!-- LEFT SIDEBAR for Navigation -->
    <left>
        <VBox style="-fx-background-color: #1e293b; -fx-padding: 20;" prefWidth="260">
            <Label text="DocBook" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="← Retour" onAction="#goBack" style="-fx-font-size: 14px; -fx-padding: 10 20;" />
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="0">
            <!-- Top Bar -->
            <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Rendez-vous / Appointments" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnNew" text="+ Nouveau" style="-fx-font-size: 12; -fx-padding: 10 20; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;" onAction="#onNewAppointment" />
                    <Button fx:id="btnRefresh" text="Actualiser" style="-fx-font-size: 12; -fx-padding: 10 20; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;" onAction="#loadAppointments" />
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Rechercher..." style="-fx-font-size: 12; -fx-padding: 8;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnSearch" text="Rechercher" style="-fx-font-size: 12; -fx-padding: 8 20; -fx-background-color: #FF9800; -fx-text-fill: white;" onAction="#onSearch" />
                    <ComboBox fx:id="statusFilter" promptText="Filtrer par statut" style="-fx-font-size: 11;" />
                </HBox>
            </VBox>

            <!-- Content -->
            <ScrollPane fitToWidth="true" style="-fx-padding: 0; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="cardContainer" spacing="15" style="-fx-padding: 20; -fx-background-color: #fff;" />
            </ScrollPane>

            <!-- Bottom Status Bar -->
            <HBox style="-fx-padding: 15; -fx-background-color: #f5f5f5; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                <Label fx:id="statusLabel" text="Total: 0" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="messageLabel" style="-fx-font-size: 11; -fx-text-fill: #666;" />
            </HBox>
        </VBox>
    </center>
</BorderPane>