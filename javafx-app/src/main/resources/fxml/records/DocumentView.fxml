<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.docbook.controllers.records.DocumentController"
            stylesheets="/css/style.css"
            prefHeight="800.0" prefWidth="1200.0">

<!-- Left Sidebar - Doctor Version -->
    <left>
        <VBox styleClass="patient-sidebar" prefWidth="260" minWidth="260" maxWidth="260" spacing="0">
            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 20 16 20;" spacing="12">
                <StackPane style="-fx-background-color: #0058be; -fx-background-radius: 10;" minWidth="40" minHeight="40" prefWidth="40" prefHeight="40">
                    <Text text="✚" style="-fx-font-size: 20px; -fx-fill: white;"/>
                </StackPane>
                <Text text="DocBook" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-fill: #1e293b;"/>
            </HBox>
            
            <!-- Doctor Info -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 8 20;">
                <StackPane style="-fx-background-color: #e0e7ff; -fx-background-radius: 20;" prefWidth="40" prefHeight="40">
                    <Text text="DR" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #0058be;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="doctorNameLabel" text="Dr. Médecin" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
                    <Text text="Médecin" style="-fx-font-size: 11px; -fx-fill: #64748b;"/>
                </VBox>
            </HBox>
            
            <!-- Navigation -->
            <VBox styleClass="sidebar-nav" spacing="2" style="-fx-padding: 8 12;">
                <Button text="🏠  Dashboard" onAction="#openDoctorDashboard" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="📄  Documents" styleClass="nav-link-active" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="📊  Statistiques" onAction="#openStatsView" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="🤖  AI Snapshot" onAction="#generatePatientSnapshot" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="💡  AI Assistant" onAction="#runDiagnosticAssistant" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
                <Button text="👤  Mon Profil" onAction="#handleProfileNav" styleClass="nav-link" prefWidth="220" 
                        style="-fx-alignment: CENTER_LEFT; -fx-padding: 14 16; -fx-font-size: 14px;"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- User Info -->
            <VBox style="-fx-padding: 16 20; -fx-background-color: #f1f5f9;" spacing="8">
                <Button text="Déconnexion" onAction="#logout"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-background-radius: 8; 
                               -fx-font-size: 12px; -fx-padding: 8 12; -fx-cursor: hand;"
                        prefWidth="220"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="25" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Text text="Documents et Prescriptions" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="🔍 Rechercher document..." 
                           onKeyReleased="#filterDocuments"
                           style="-fx-background-color: white; -fx-background-radius: 8; 
                                  -fx-border-color: #e2e8f0; -fx-border-radius: 8; 
                                  -fx-padding: 8 16; -fx-pref-width: 250;"/>
            </HBox>
            
            <!-- Table and Form Container -->
            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <TableView fx:id="documentTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>

                            <TableColumn fx:id="titreCol" text="Titre" prefWidth="180"/>
                            <TableColumn fx:id="typeCol" text="Type" prefWidth="120"/>
                            <TableColumn fx:id="dateCol" text="Date" prefWidth="120"/>
                            <TableColumn fx:id="fileCol" text="Fichier Actif" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
                
                <!-- Document Form -->
                <VBox prefWidth="400" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
                    <ScrollPane fitToWidth="true" styleClass="edge-to-edge">
                        <VBox spacing="15" style="-fx-padding: 20;">
                            <Text text="Détails du Document" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                            <VBox spacing="2"><ComboBox fx:id="dossierIdCombo" promptText="Dossier Patient (Requis)" maxWidth="Infinity"/><Text fx:id="dossierIdError" style="-fx-fill: #ef4444; -fx-font-size: 11px;"/></VBox>
                            <VBox spacing="2"><TextField fx:id="titreField" promptText="Titre de la consultation"/><Text fx:id="titreError" style="-fx-fill: #ef4444; -fx-font-size: 11px;"/></VBox>
                            <VBox spacing="2"><ComboBox fx:id="typeCombo" promptText="Type de Document" maxWidth="Infinity"/><Text fx:id="typeError" style="-fx-fill: #ef4444; -fx-font-size: 11px;"/></VBox>
                            <VBox spacing="2"><DatePicker fx:id="dateField" promptText="Date du Document" maxWidth="Infinity"/><Text fx:id="dateError" style="-fx-fill: #ef4444; -fx-font-size: 11px;"/></VBox>
                            <VBox spacing="2"><TextArea fx:id="contenuField" promptText="Contenu (SOAP / Description)..." prefHeight="150" wrapText="true"/><Text fx:id="contenuError" style="-fx-fill: #ef4444; -fx-font-size: 11px;"/></VBox>
                            
                            <!-- File Upload Section -->
                            <VBox spacing="5" alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Button text="Joindre PDF/Image" style="-fx-background-color: #64748b; -fx-text-fill: white;" onAction="#uploadFile"/>
                                    <Text fx:id="fileNameText" text="Aucun fichier" style="-fx-fill: #94a3b8;"/>
                                </HBox>
                            </VBox>

                            <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                                <Button text="Ajouter" styleClass="patient-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#addDocument"/>
                                <Button text="Modifier" styleClass="doctor-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#updateDocument"/>
                                <Button text="📥 CSV" onAction="#exportDocumentsCSV" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 8 16;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                            <HBox spacing="10">
                                <Button text="Supprimer" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#deleteDocument"/>
                                <Button text="Vider" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#clearForm"/>
                            </HBox>
                            <HBox spacing="10" style="-fx-padding: 8 0 0 0;">
                                <Button text="🤖 Titre Auto" onAction="#runAutoTitleAI" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 11px; -fx-padding: 6 10;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="🛡️ Sécurité" onAction="#runSafetyGuardAI" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 11px; -fx-padding: 6 10;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="💬 Patient" onAction="#runPatientFriendlyAI" style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 11px; -fx-padding: 6 10;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                            <Text fx:id="statusText" style="-fx-fill: #10b981; -fx-font-size: 12px;"/>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>


