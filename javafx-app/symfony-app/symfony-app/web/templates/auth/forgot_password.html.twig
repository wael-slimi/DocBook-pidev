{% extends 'base.html.twig' %}

{% block title %}
    {% if step == 'sent' %}Check Your Email
    {% elseif step == 'reset' %}Create New Password
    {% elseif step == 'success' %}Reset Successful
    {% else %}Forgot Password
    {% endif %} - DOCBOOK
{% endblock %}

{% block body %}
    {% include 'components/navbar.html.twig' %}

    <main class="flex-grow flex items-center justify-center px-4 py-12">
        <div class="max-w-[520px] w-full bg-white dark:bg-slate-900 p-8 md:p-10 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800">
            
            {# STEP 1: EMAIL INPUT #}
            {% if step == 'request' %}
                <div class="flex flex-col items-center mb-6">
                    <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-4 text-primary">
                        <span class="material-symbols-outlined" style="font-size: 36px;">lock_reset</span>
                    </div>
                    <h1 class="text-2xl font-bold text-center">Forgot Password?</h1>
                    <p class="text-slate-500 text-center mt-2">Enter your email and we'll send you a link to reset your password.</p>
                </div>
                <form method="POST">
                    <input type="hidden" name="current_step" value="request">
                    <div class="space-y-4">
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-3 text-slate-400">mail</span>
                            <input name="email" type="email" required class="w-full pl-10 h-12 rounded-lg border-slate-300 dark:bg-slate-800" placeholder="name@email.com">
                        </div>
                        <button type="submit" class="w-full h-12 bg-primary text-white font-bold rounded-lg hover:bg-primary/90">Send Reset Link</button>
                    </div>
                </form>

            {# STEP 2: EMAIL SENT #}
            {% elseif step == 'sent' %}
                <div class="flex flex-col items-center text-center gap-6">
                    <div class="size-24 bg-primary/10 rounded-full flex items-center justify-center text-primary relative">
                        <span class="material-symbols-outlined text-5xl">mail</span>
                        <span class="material-symbols-outlined absolute -bottom-1 -right-1 text-3xl bg-white dark:bg-slate-900 rounded-full">check_circle</span>
                    </div>
                    <h1 class="text-3xl font-bold">Check your email</h1>
                    <p class="text-slate-500">We've sent a password reset link to your email. Please check your inbox.</p>
                    <a href="https://mail.google.com" target="_blank" class="w-full h-12 flex items-center justify-center bg-primary text-white font-bold rounded-lg">Open Email App</a>
                    <p class="text-sm text-slate-400">Didn't get it? <a href="{{ path('app_forgot_password', {step: 'request'}) }}" class="text-primary font-bold">Resend</a></p>
                </div>

            {# STEP 3: CREATE NEW PASSWORD #}
            {% elseif step == 'reset' %}
                <div class="flex flex-col">
                    <h1 class="text-[#0c141d] dark:text-white tracking-light text-[32px] font-bold leading-tight text-center pb-3 pt-2">Create New Password</h1>
                    <p class="text-slate-600 dark:text-slate-400 text-base text-center pb-6">Your new password must be different from previously used passwords.</p>
                </div>

                <form method="POST" class="flex flex-col gap-2">
                    <input type="hidden" name="current_step" value="reset">

                    <div class="flex flex-col w-full py-3">
                        <label class="flex flex-col w-full">
                            <p class="text-[#0c141d] dark:text-slate-200 text-sm font-semibold pb-2">New Password</p>
                            <div class="relative">
                                <input name="password" type="password" id="new-password" required
                                       class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 h-12 p-[15px] focus:ring-2 focus:ring-primary/50" 
                                       placeholder="Enter new password">
                                <span class="material-symbols-outlined absolute right-3 top-3 text-slate-400 cursor-pointer select-none" onclick="togglePass('new-password')">visibility</span>
                            </div>
                        </label>
                    </div>

                    <div class="flex flex-col gap-2 py-2">
                        <div class="flex justify-between items-center">
                            <p class="text-sm font-medium">Strength: <span class="text-primary" id="strength-text">Weak</span></p>
                            <p class="text-slate-400 text-xs" id="strength-perc">0%</p>
                        </div>
                        <div class="rounded-full bg-slate-200 dark:bg-slate-700 h-2 overflow-hidden">
                            <div id="strength-bar" class="h-full bg-red-500 transition-all duration-500" style="width: 5%;"></div>
                        </div>
                    </div>

                    <div class="bg-slate-50 dark:bg-slate-800/50 p-4 rounded-lg my-2 border border-slate-100 dark:border-slate-800">
                        <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Requirements:</p>
                        <ul class="space-y-2">
                            <li class="flex items-center gap-2 text-sm text-slate-400" id="req-len">
                                <span class="material-symbols-outlined text-lg">radio_button_unchecked</span> At least 8 characters
                            </li>
                            <li class="flex items-center gap-2 text-sm text-slate-400" id="req-num">
                                <span class="material-symbols-outlined text-lg">radio_button_unchecked</span> At least one number
                            </li>
                        </ul>
                    </div>

                    <div class="flex flex-col w-full py-3">
                        <label class="flex flex-col w-full">
                            <p class="text-[#0c141d] dark:text-slate-200 text-sm font-semibold pb-2">Confirm New Password</p>
                            <div class="relative">
                                <input name="confirm_password" type="password" id="confirm-password" required
                                       class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 h-12 p-[15px] focus:ring-2 focus:ring-primary/50" 
                                       placeholder="Re-type new password">
                            </div>
                        </label>
                    </div>

                    <button type="submit" class="w-full h-14 bg-primary hover:bg-primary/90 text-white font-bold rounded-lg shadow-md mt-4 transition-all">
                        Reset Password
                    </button>
                </form>

                <script>
                    function togglePass(id) {
                        const el = document.getElementById(id);
                        el.type = el.type === 'password' ? 'text' : 'password';
                    }

                    // Basic logic for the strength meter
                    document.getElementById('new-password').addEventListener('input', function(e) {
                        const val = e.target.value;
                        let strength = 0;
                        if (val.length >= 8) strength += 50;
                        if (/\d/.test(val)) strength += 50;

                        const bar = document.getElementById('strength-bar');
                        const text = document.getElementById('strength-text');

                        bar.style.width = strength + '%';
                        if (strength === 0) { text.innerText = 'Weak'; bar.className = 'h-full bg-red-500'; }
                        else if (strength === 50) { text.innerText = 'Medium'; bar.className = 'h-full bg-yellow-500'; }
                        else { text.innerText = 'Strong'; bar.className = 'h-full bg-primary'; }

                        document.getElementById('strength-perc').innerText = strength + '%';
                    });
                </script>


            {# STEP 4: SUCCESS #}
            {% elseif step == 'success' %}
                <div class="flex flex-col items-center text-center gap-8">
                    <div class="size-24 bg-primary text-white rounded-full flex items-center justify-center shadow-lg shadow-primary/20">
                        <span class="material-symbols-outlined text-5xl">check_circle</span>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold mb-2">Reset Successful</h1>
                        <p class="text-slate-500">Your password has been updated. You can now log in with your new credentials.</p>
                    </div>
                    <a href="{{ path('app_login') }}" class="w-full h-12 flex items-center justify-center bg-primary text-white font-bold rounded-lg shadow-md">Proceed to Login</a>
                </div>
            {% endif %}

            <div class="mt-8 text-center">
                <a href="{{ path('app_login') }}" class="text-sm text-primary font-semibold flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-sm">arrow_back</span> Back to Login
                </a>
            </div>
        </div>
    </main>

    {% include 'components/footer.html.twig' %}
{% endblock %}