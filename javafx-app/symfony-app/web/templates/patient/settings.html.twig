{% extends 'dashboard_base.html.twig' %}

{% block title %}Account Settings - DOCBOOK{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-black text-slate-900 dark:text-white">Account Settings</h1>
        <p class="text-slate-500 text-sm">Update your personal information and security preferences.</p>
    </div>

    {# --- MAIN PROFILE FORM --- #}
    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'space-y-8'}}) }}
        <div class="bg-white dark:bg-slate-900 rounded-3xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex flex-col md:flex-row gap-8 items-start">
                
                {# Profile Picture Section #}
                <div class="flex flex-col items-center gap-4">
                    <div class="relative group">
                        <div class="size-32 rounded-full bg-slate-100 dark:bg-slate-800 border-4 border-white dark:border-slate-900 overflow-hidden shadow-xl">
                            {% if app.user.profilePicture %}
                                <img src="{{ asset('uploads/profiles/' ~ app.user.profilePicture) }}" class="w-full h-full object-cover">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center text-slate-400">
                                    <span class="material-symbols-outlined text-4xl">person</span>
                                </div>
                            {% endif %}
                        </div>
                        <label for="{{ form.profilePicture.vars.id }}" class="absolute bottom-0 right-0 p-2 bg-primary text-white rounded-full cursor-pointer hover:scale-110 transition-transform border-2 border-white dark:border-slate-900 shadow-lg">
                            <span class="material-symbols-outlined text-sm">photo_camera</span>
                        </label>
                    </div>
                    <div class="hidden">{{ form_widget(form.profilePicture) }}</div>
                </div>

                {# Input Fields #}
                <div class="flex-1 space-y-6 w-full">
                    <div class="flex flex-col gap-2">
                        <label class="text-sm font-bold text-slate-700 dark:text-slate-300">Display Name</label>
                        {{ form_widget(form.name, {
                            'attr': {'class': 'flex h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-base focus:ring-2 focus:ring-primary/20 outline-none transition-all dark:bg-slate-800 dark:border-slate-700 dark:text-white'}
                        }) }}
                        <div class="text-red-500 text-xs">{{ form_errors(form.name) }}</div>
                    </div>

                    <div class="flex items-center justify-end pt-4">
                        <button type="submit" class="bg-primary text-white font-black px-8 py-3 rounded-xl shadow-lg shadow-primary/30 hover:bg-primary/90 transition-all">
                            Save Profile Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {{ form_end(form) }}

    {# --- TWO-FACTOR AUTHENTICATION FORM (STANDALONE) --- #}
    <div class="mt-8 bg-white dark:bg-slate-900 rounded-3xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-primary text-3xl">shield_lock</span>
            <h2 class="text-xl font-black text-slate-900 dark:text-white">Security: 2FA via SMS</h2>
        </div>

        <form action="{{ path('app_2fa_toggle_settings') }}" method="POST" class="space-y-6">
            <div class="flex flex-col gap-2">
                <label for="phone" class="text-sm font-bold text-slate-700 dark:text-slate-300">Phone Number (Tunisia: +216XXXXXXXX)</label>
                <input type="text" name="phone" id="phone" 
                       class="flex h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-base focus:ring-2 focus:ring-primary/20 outline-none transition-all dark:bg-slate-800 dark:border-slate-700 dark:text-white" 
                       placeholder="+21654530449" 
                       value="{{ app.user.phone }}">
                <p class="text-slate-500 text-xs">Required to receive your login verification codes.</p>
            </div>
            
            <div class="flex items-center gap-3 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl">
                <label class="relative inline-flex items-center cursor-pointer">
                    {# The checkbox must have the name 'enable_2fa' #}
                    <input type="checkbox" name="enable_2fa" id="2faSwitch" class="sr-only peer" {{ app.user.is2faEnabled ? 'checked' : '' }}>
                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                    <span class="ml-3 text-sm font-bold text-slate-700 dark:text-slate-300">Enable 2FA via SMS</span>
                </label>
            </div>

            <div class="flex justify-end">
                <button type="submit" class="bg-slate-900 dark:bg-white dark:text-slate-900 text-white font-black px-8 py-3 rounded-xl hover:opacity-90 transition-all">
                    Update Security
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}