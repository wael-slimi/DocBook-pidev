{% extends 'base.html.twig' %}

{% block title %}Reset your password - DOCBOOK{% endblock %}

{% block body %}
<div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden bg-[#f5f7f8] dark:bg-[#0f1923]">
    <div class="layout-container flex h-full grow flex-col">
        {% include 'components/navbar.html.twig' %}

        <main class="flex flex-1 items-center justify-center py-10 px-4">
            <div class="max-w-[480px] w-full bg-white dark:bg-slate-900 rounded-xl shadow-sm p-8 border border-[#e6edf4] dark:border-slate-800">
                <div class="flex flex-col items-center mb-6">
                    <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-primary" style="font-size: 36px;">lock_reset</span>
                    </div>
                    <h1 class="text-[#0c141d] dark:text-slate-100 text-[28px] font-bold text-center">Forgot Password?</h1>
                    <p class="text-slate-600 dark:text-slate-400 text-base pt-2 text-center">Enter your email and we'll send a reset link.</p>
                </div>

                {% for flash_error in app.flashes('reset_password_error') %}
                    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg">{{ flash_error|trans }}</div>
                {% endfor %}

                {{ form_start(requestForm, {'attr': {'class': 'flex flex-col gap-4'}}) }}
                    <div class="flex flex-col gap-2">
                        <label>
                            <p class="text-sm font-medium pb-2 dark:text-slate-200">Email Address</p>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-3 text-slate-400">mail</span>
                                {{ form_widget(requestForm.email, {
                                    'attr': {
                                        'class': 'w-full rounded-lg border-[#cddbea] dark:border-slate-700 dark:bg-slate-800 dark:text-white pl-10 h-12 focus:ring-primary focus:border-primary',
                                        'placeholder': 'name@example.com'
                                    }
                                }) }}
                            </div>
                        </label>
                    </div>
                    <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white font-bold h-12 rounded-lg transition-colors">
                        Send Reset Link
                    </button>
                    <div class="flex justify-center pt-4">
                        <a class="flex items-center gap-2 text-primary text-sm font-semibold hover:underline" href="{{ path('app_login') }}">
                            <span class="material-symbols-outlined text-sm">arrow_back</span> Back to Login
                        </a>
                    </div>
                {{ form_end(requestForm) }}
            </div>
        </main>
        {% include 'components/footer.html.twig' %}
    </div>
</div>
{% endblock %}