<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controller.AppointmentListController"
            fitToWidth="true"
            style="-fx-padding: 0; -fx-border-color: transparent;">

    <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #ecf0f1;">

        <!-- Header with Controls -->
        <VBox spacing="15" styleClass="card-container" style="-fx-padding: 20;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Appointments Management" styleClass="title-label" HBox.hgrow="ALWAYS"/>
                <Button text="+ New Appointment" styleClass="btn-primary" onAction="#onNewAppointment"/>
            </HBox>

            <!-- Search and Filter Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="tfSearch"
                           promptText="Search by doctor, department, or message..."
                           styleClass="form-field"
                           HBox.hgrow="ALWAYS"
                           onKeyReleased="#onSearch"/>
                <ComboBox fx:id="cbStatusFilter"
                          styleClass="form-field"
                          promptText="Filter by Status"
                          prefWidth="150"
                          onAction="#onStatusFilterChanged"/>
                <Button text="Refresh" styleClass="btn-success" onAction="#loadAppointments"/>
            </HBox>

            <!-- Status Summary -->
            <HBox spacing="15">
                <Label fx:id="lblTotalCount" text="Total: 0" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblPendingCount" text="Pending: 0" style="-fx-font-size: 12px; -fx-text-fill: #f39c12;"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblConfirmedCount" text="Confirmed: 0" style="-fx-font-size: 12px; -fx-text-fill: #27ae60;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- Appointments Container -->
        <VBox fx:id="appointmentsContainer"
              spacing="12"
              style="-fx-padding: 0;">
            <!-- Cards will be added here dynamically -->
        </VBox>

        <!-- Empty State Message -->
        <VBox fx:id="emptyStateContainer"
              alignment="CENTER"
              spacing="10"
              style="-fx-padding: 60 20; -fx-background-color: white; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
              managed="false"
              visible="false">
            <Label text="📭" style="-fx-font-size: 48px;"/>
            <Label text="No appointments found" styleClass="subtitle-label"/>
            <Label text="Create a new appointment to get started" style="-fx-text-fill: #95a5a6; -fx-font-size: 12px;"/>
        </VBox>

    </VBox>

</ScrollPane>
