<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controller.MainViewController"
            prefWidth="1400" prefHeight="900">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="0">
            <!-- Logo/Title Area -->
            <VBox styleClass="sidebar-title" alignment="TOP_CENTER" spacing="10">
                <Label text="💊 Healthcare" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                <Label text="Management" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
            </VBox>

            <!-- Navigation Buttons -->
            <VBox spacing="5" style="-fx-padding: 20 0;">
                <!-- Home Button -->
                <Button fx:id="btnHome"
                        text="🏠 Home"
                        styleClass="sidebar-button, active"
                        prefWidth="250"
                        onAction="#onNavigateHome"/>

                <!-- Appointments Button -->
                <Button fx:id="btnAppointments"
                        text="📅 Appointments"
                        styleClass="sidebar-button"
                        prefWidth="250"
                        onAction="#onNavigateAppointments"/>

                <!-- Teleconsultations Button -->
                <Button fx:id="btnTeleconsultations"
                        text="🎥 Teleconsultations"
                        styleClass="sidebar-button"
                        prefWidth="250"
                        onAction="#onNavigateTeleconsultations"/>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Footer -->
            <VBox style="-fx-padding: 20; -fx-border-color: #1a252f; -fx-border-width: 1 0 0 0;" spacing="5">
                <Label text="Version 2.0" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
                <Label text="Premium Dashboard" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
            </VBox>
        </VBox>
    </left>

    <!-- CENTER CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea">
            <VBox alignment="CENTER" spacing="20">
                <Label text="Loading..." style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
