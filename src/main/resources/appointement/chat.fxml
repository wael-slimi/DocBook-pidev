<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controller.ChatController"
      spacing="10"
      style="-fx-background-color: #ffffff; -fx-padding: 0;">

    <!-- Header -->
    <VBox spacing="5" style="-fx-padding: 15; -fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-border-color: #ecf0f1; -fx-border-width: 0 0 1 0;">
        <Label text="🤖 Medilab AI Assistant" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Your healthcare management companion" style="-fx-font-size: 11px; -fx-text-fill: #ecf0f1;"/>
    </VBox>

    <!-- Chat Messages Area -->
    <ScrollPane fx:id="chatScrollPane"
                fitToWidth="true"
                style="-fx-background-color: #f5f5f5; -fx-padding: 0; -fx-border-color: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox fx:id="chatMessagesContainer"
              spacing="10"
              style="-fx-background-color: #f5f5f5; -fx-padding: 15;">
            <Label text="👋 Welcome to Medilab Assistant!" 
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label text="Ask me anything about your clinic, appointments, or how to use this dashboard. I'm here to help!" 
                   style="-fx-font-size: 12px; -fx-text-fill: #95a5a6; -fx-wrap-text: true;"/>
        </VBox>
    </ScrollPane>

    <!-- Divider -->
    <Separator style="-fx-padding: 0;"/>

    <!-- Status Line -->
    <HBox spacing="10" style="-fx-padding: 8 15; -fx-background-color: #f8f9fa;">
        <Label fx:id="statusLabel" 
               text="✓ Ready" 
               style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 11px;"
               HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Input Area -->
    <HBox spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-width: 1 0 0 0;">
        
        <!-- Text Input Field -->
        <TextField fx:id="messageInputField"
                   promptText="Type your message here... (Press Enter to send)"
                   style="-fx-font-size: 12px; -fx-padding: 10; -fx-border-radius: 4; -fx-background-radius: 4;"
                   HBox.hgrow="ALWAYS"/>
        
        <!-- Send Button -->
        <Button fx:id="sendButton"
                text="Send 📤"
                style="-fx-font-size: 11px; -fx-padding: 10 20; -fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 4; -fx-cursor: hand;"
                prefWidth="90"/>
        
        <!-- Clear Button -->
        <Button fx:id="clearButton"
                text="Clear 🗑️"
                style="-fx-font-size: 11px; -fx-padding: 10 15; -fx-background-color: #e74c3c; -fx-text-fill: white; -fx-border-radius: 4; -fx-cursor: hand;"
                prefWidth="80"/>
    </HBox>

</VBox>
