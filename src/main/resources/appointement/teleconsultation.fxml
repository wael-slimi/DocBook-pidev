<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controller.teleconsultationController"
            prefWidth="1000" prefHeight="700">

    <!-- Top Bar: Title and Buttons -->
    <top>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Teleconsultations Management" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnNew" text="+ New Teleconsultation" style="-fx-font-size: 12; -fx-padding: 10 20; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;" onAction="#onNewTeleconsultation" />
                <Button fx:id="btnRefresh" text="Refresh" style="-fx-font-size: 12; -fx-padding: 10 20; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;" onAction="#loadTeleconsultations" />
            </HBox>

            <!-- Search and Filter Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="tfSearch" promptText="Search by doctor, department, or meeting URL..." style="-fx-font-size: 12; -fx-padding: 8;" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSearch" text="Search" style="-fx-font-size: 12; -fx-padding: 8 20; -fx-background-color: #FF9800; -fx-text-fill: white;" onAction="#onSearch" />
                <ComboBox fx:id="modeFilter" promptText="Filter by Mode" style="-fx-font-size: 11;" />
            </HBox>
        </VBox>
    </top>

    <!-- Center: Card Layout with ScrollPane -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-padding: 0; -fx-border-color: transparent;">
            <VBox fx:id="cardContainer" spacing="15" style="-fx-padding: 20; -fx-background-color: #fff;" />
        </ScrollPane>
    </center>

    <!-- Bottom: Status Bar -->
    <bottom>
        <HBox style="-fx-padding: 15; -fx-background-color: #f5f5f5; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
            <Label fx:id="statusLabel" text="Total Teleconsultations: 0" style="-fx-font-size: 12; -fx-text-fill: #666;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="messageLabel" style="-fx-font-size: 11; -fx-text-fill: #666;" />
        </HBox>
    </bottom>
</BorderPane>
