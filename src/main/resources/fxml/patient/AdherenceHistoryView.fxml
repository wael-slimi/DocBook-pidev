<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.docbook.controllers.patient.AdherenceHistoryController"
            stylesheets="/css/style.css"
            prefHeight="800.0" prefWidth="1200.0">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 16;">
            <Text text="DocBook" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Retour" onAction="#goBack"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="12">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Text text="Historique d'Adhérence"/>
            <Text text="Vue en cours de préparation." style="-fx-fill: #64748b;"/>
        </VBox>
    </center>
</BorderPane>
