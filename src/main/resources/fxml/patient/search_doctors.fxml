<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" style="-fx-background-color: #f3f4f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.docbook.controllers.patient.SearchController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Rechercher un Spécialiste" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <HBox spacing="15.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Nom du docteur" />
                    <TextField fx:id="nameSearchField" promptText="Rechercher par nom..." />
                </VBox>
                <VBox>
                    <Label text="Prix Maximum (DT)" />
                    <TextField fx:id="priceSearchField" prefWidth="120.0" promptText="Ex: 60" />
                </VBox>
            </children>
        </HBox>

        <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" prefWidth="200.0" text="Nom" />
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
                <TableColumn fx:id="colRole" prefWidth="150.0" text="Spécialité" />
                <TableColumn fx:id="colPrice" prefWidth="100.0" text="Prix (DT)" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>