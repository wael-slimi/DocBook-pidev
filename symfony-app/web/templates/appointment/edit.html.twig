{% extends "dashboard_base.html.twig" %}

{% block title %}Edit Appointment{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>Edit Appointment #{{ appointment.id }}</h1>
            <hr />

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="form-group mb-3">
                    {{ form_label(form.scheduledAt, 'Date & Time') }}
                    {{ form_widget(form.scheduledAt, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.scheduledAt) }}
                </div>

                <div class="form-group mb-3">
                    {{ form_label(form.department, 'Department') }}
                    {{ form_widget(form.department, {'attr': {'class': 'form-control', 'placeholder': 'e.g., Cardiology'}}) }}
                    {{ form_errors(form.department) }}
                </div>

                <div class="form-group mb-3">
                    {{ form_label(form.doctor, 'Doctor Name') }}
                    {{ form_widget(form.doctor, {'attr': {'class': 'form-control', 'placeholder': 'Enter doctor name'}}) }}
                    {{ form_errors(form.doctor) }}
                </div>

<div class="form-group mb-3">
                     {{ form_label(form.reason, 'Message / Notes') }}
                     {{ form_widget(form.reason, {'attr': {'class': 'form-control', 'rows': '4', 'placeholder': 'Any additional notes...'}}) }}
                     {{ form_errors(form.reason) }}
                 </div>

                 {% if form.status is defined %}
                 <div class="form-group mb-3">
                     {{ form_label(form.status, 'Status') }}
                     {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
                     {{ form_errors(form.status) }}
                 </div>
                 {% endif %}

                <div class="d-flex justify-content-between">
                    <button class="btn btn-primary" type="submit">Update Appointment</button>
                    <a href="{{ path('app_appointment_show', {'id': appointment.id}) }}" class="btn btn-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
