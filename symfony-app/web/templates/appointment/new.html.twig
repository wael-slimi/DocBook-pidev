{% extends 'dashboard_base.html.twig' %}

{% block title %}Schedule New Appointment - DOCBOOK{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto space-y-8">
    <div class="flex flex-col gap-1">
        <h1 class="text-4xl font-black text-slate-900 dark:text-white">Schedule New Appointment</h1>
        <p class="text-slate-500">Fill in the details below to book an appointment with a doctor.</p>
    </div>

    <div class="flex flex-wrap gap-4">
        <a href="{{ path('app_appointment_index') }}" class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-6 py-3 rounded-lg font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            <span class="material-symbols-outlined mr-2">arrow_back</span> Back to Appointments
        </a>
        <a href="{{ path('app_doctor_search') }}" class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-6 py-3 rounded-lg font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            <span class="material-symbols-outlined mr-2">search</span> Find Doctors
        </a>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden p-8">
        {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

            <div>
                {{ form_label(form.scheduledAt, 'Date & Time', {'label_attr': {'class': 'block text-sm font-bold text-slate-900 dark:text-white mb-2'}}) }}
                <div class="relative">
                    {{ form_widget(form.scheduledAt, {'attr': {'class': 'w-full rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 px-4 py-2 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary'}}) }}
                </div>
                {% if form_errors(form.scheduledAt) %}
                    <div class="mt-2 text-sm text-red-600 dark:text-red-400">
                        {{ form_errors(form.scheduledAt) }}
                    </div>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.doctor, 'Select Doctor', {'label_attr': {'class': 'block text-sm font-bold text-slate-900 dark:text-white mb-2'}}) }}
                <div class="relative">
                    {{ form_widget(form.doctor, {'attr': {'class': 'w-full rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 px-4 py-2 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary'}}) }}
                </div>
                {% if form_errors(form.doctor) %}
                    <div class="mt-2 text-sm text-red-600 dark:text-red-400">
                        {{ form_errors(form.doctor) }}
                    </div>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.reason, 'Message / Reason for Visit', {'label_attr': {'class': 'block text-sm font-bold text-slate-900 dark:text-white mb-2'}}) }}
                <div class="relative">
                    {{ form_widget(form.reason, {'attr': {'class': 'w-full rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 px-4 py-2 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary', 'rows': '4', 'placeholder': 'Describe your reason for the appointment...'}}) }}
                </div>
                {% if form_errors(form.reason) %}
                    <div class="mt-2 text-sm text-red-600 dark:text-red-400">
                        {{ form_errors(form.reason) }}
                    </div>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.status, 'Status', {'label_attr': {'class': 'block text-sm font-bold text-slate-900 dark:text-white mb-2'}}) }}
                <div class="relative">
                    {{ form_widget(form.status, {'attr': {'class': 'w-full rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 px-4 py-2 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary'}}) }}
                </div>
                {% if form_errors(form.status) %}
                    <div class="mt-2 text-sm text-red-600 dark:text-red-400">
                        {{ form_errors(form.status) }}
                    </div>
                {% endif %}
            </div>

            <div class="flex gap-4 pt-4">
                <button type="submit" class="flex-1 bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors shadow-lg shadow-primary/20">
                    <span class="material-symbols-outlined mr-2">check</span> Create Appointment
                </button>
                <a href="{{ path('app_appointment_index') }}" class="flex-1 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-6 py-3 rounded-lg font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors text-center">
                    <span class="material-symbols-outlined mr-2">close</span> Cancel
                </a>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
