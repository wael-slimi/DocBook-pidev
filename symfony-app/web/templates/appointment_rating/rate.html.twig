{% extends 'layout_authenticated.html.twig' %}

{% block title %}Noter le rendez-vous - DOCBOOK{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto space-y-8">
    <div class="flex flex-col gap-1">
        <h1 class="text-4xl font-black text-slate-900 dark:text-white">Noter le rendez-vous</h1>
        <p class="text-slate-500">Donnez votre avis sur le rendez-vous avec Dr. {{ appointment.doctor.name }}</p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm p-6">
        {{ form_start(form) }}

        <div class="space-y-6">
            <div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Votre note</h3>
                <div class="flex gap-2">
                    {{ form_widget(form.stars) }}
                </div>
                {{ form_errors(form.stars) }}
            </div>

            <div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Commentaire</h3>
                {{ form_widget(form.comment, { 'attr': { 'rows': 4, 'placeholder': 'Partagez votre expérience...' } }) }}
            </div>
        </div>

        <div class="flex justify-end gap-4 mt-8">
            <a href="{{ path('app_appointment_show', { id: appointment.id }) }}" class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-6 py-3 rounded-lg font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                Annuler
            </a>
            <button type="submit" class="bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors shadow-lg shadow-primary/20">
                Envoyer
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}