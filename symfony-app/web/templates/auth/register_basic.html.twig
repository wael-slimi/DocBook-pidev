{% extends 'base.html.twig' %}

{% block title %}Register: Basic Information - DOCBOOK{% endblock %}

{% block body %}
    {% include 'components/navbar.html.twig' %}

    <main class="flex flex-1 justify-center py-10 px-4 md:px-40">
        <div class="layout-content-container flex flex-col max-w-[560px] flex-1 bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-[#cedbe8] dark:border-slate-800 p-8">
            {% for message in app.flashes('error') %}
                <div class="mb-6 p-4 bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 text-red-700 dark:text-red-400 flex items-center gap-3 rounded shadow-sm">
                    <span class="material-symbols-outlined">error</span>
                    <p class="text-sm font-semibold">{{ message }}</p>
                </div>
            {% endfor %}
            <div class="flex flex-col gap-3 pb-8">
                <div class="flex gap-6 justify-between items-center">
                    <p class="text-slate-900 dark:text-white text-sm font-semibold uppercase tracking-wider">Step 1 of 4</p>
                    <p class="text-primary text-sm font-bold leading-normal">25% Complete</p>
                </div>
                <div class="rounded-full bg-slate-100 dark:bg-slate-800 h-2.5 overflow-hidden">
                    <div class="h-full rounded-full bg-primary" style="width: 25%;"></div>
                </div>
            </div>

            <h1 class="text-slate-900 dark:text-white tracking-tight text-3xl font-bold leading-tight mb-2">Let's get started</h1>
            <p class="text-slate-600 dark:text-slate-400 text-base mb-8 pb-6 border-b border-slate-100">Please provide your basic contact details.</p>

            <form action="{{ path('app_register') }}" method="POST" class="flex flex-col gap-6">
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-200 text-sm font-semibold">Full Name</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">person</span>
                        <input name="full_name" type="text" class="form-input w-full rounded-lg border-[#cedbe8] dark:bg-slate-800 h-14 pl-12" placeholder="John Doe" required>
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-200 text-sm font-semibold">Email Address</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">mail</span>
                        <input name="email" type="email" class="form-input w-full rounded-lg border-[#cedbe8] dark:bg-slate-800 h-14 pl-12" placeholder="name@email.com" required>
                    </div>
                </div>


                {% set maxDob = "now -16 years"|date("Y-m-d") %}
                {% set minDob = "now -120 years"|date("Y-m-d") %}
                
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-200 text-sm font-semibold flex justify-between">
                        <span>Date of Birth</span>
                    </label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">cake</span>
                        <input 
                            name="dob" 
                            type="date" 
                            required 
                            min="{{ minDob }}"
                            max="{{ maxDob }}"
                            class="form-input w-full rounded-lg border-[#cedbe8] dark:border-slate-700 dark:bg-slate-800 h-14 pl-12 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all "
                        >
                    </div>
                </div>

                <button type="submit" class="w-full bg-primary text-white h-14 rounded-lg font-bold hover:bg-primary/90 transition-all">
                    Continue to Role Selection
                </button>
            </form>
        </div>
    </main>
    
    {% include 'components/footer.html.twig' %}
{% endblock %}

