{% extends 'dashboard_base.html.twig' %}

{% block title %}Teleconsultation Room{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-6 text-center">
    <h1 class="text-2xl font-bold text-gray-800 mb-4">Teleconsultation Room</h1>

    {% set apt = teleconsultation.appointment %}
    <div class="bg-white rounded-xl border border-gray-100 p-8 shadow-sm max-w-lg mx-auto">
        <div class="mb-6">
            {% if teleconsultation.mode == 'video' %}
                <p class="text-5xl mb-2">📹</p>
            {% elseif teleconsultation.mode == 'audio' %}
                <p class="text-5xl mb-2">🎧</p>
            {% else %}
                <p class="text-5xl mb-2">💬</p>
            {% endif %}
            <p class="text-lg font-semibold text-gray-700">{{ teleconsultation.mode|default('video')|capitalize }} Consultation</p>
        </div>

        <div class="text-left space-y-2 mb-6 text-sm text-gray-600">
            {% if apt %}
                <p><span class="font-medium">Patient:</span> {{ apt.patient.name ?? 'N/A' }}</p>
                <p><span class="font-medium">Doctor:</span> Dr. {{ apt.doctor.name ?? 'N/A' }}</p>
                <p><span class="font-medium">Date:</span> {{ apt.scheduledAt ? apt.scheduledAt|date('M d, Y H:i') : 'N/A' }}</p>
                {% if teleconsultation.duration %}
                    <p><span class="font-medium">Duration:</span> {{ teleconsultation.duration }} minutes</p>
                {% endif %}
            {% endif %}
        </div>

        <a href="{{ teleconsultation.videoLink }}" target="_blank"
           class="inline-block bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium text-lg transition">
            🔗 Join Meeting
        </a>

        <p class="mt-4 text-xs text-gray-400 break-all">
            Meeting URL: <a href="{{ teleconsultation.videoLink }}" target="_blank" class="text-blue-600 hover:underline">{{ teleconsultation.videoLink }}</a>
        </p>

        <div class="mt-6">
            <a href="{{ path('app_teleconsultation_index') }}" class="text-blue-600 hover:underline text-sm">← Back to Teleconsultations</a>
        </div>
    </div>
</div>
{% endblock %}
