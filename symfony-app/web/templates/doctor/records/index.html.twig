{% extends 'dashboard_base.html.twig' %}

{% block title %}Medical Records - DOCBOOK{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-8">
    <div class="flex flex-col gap-1">
        <h1 class="text-4xl font-black text-slate-900 dark:text-white">Medical Records</h1>
        <p class="text-slate-500">Manage all patient medical records and documents.</p>
    </div>

    {% if dossiers is not empty %}
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-800">
            <h3 class="text-xl font-black text-slate-900 dark:text-white">Patient Medical Records ({{ dossiers|length }})</h3>
        </div>
        <div class="p-6">
            <div class="space-y-4">
                {% for dossier in dossiers %}
                <div class="flex items-center justify-between p-6 bg-slate-50 dark:bg-slate-800/50 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <div class="flex items-center gap-4">
                        <div class="size-12 bg-blue-50 dark:bg-blue-900/20 text-blue-600 rounded-2xl flex items-center justify-center">
                            <span class="material-symbols-outlined">folder</span>
                        </div>
                        <div>
                            <p class="font-bold text-slate-900 dark:text-white">
                                Dossier #{{ dossier.numeroDossier ?? dossier.id }} — {{ dossier.patientNom }} {{ dossier.patientPrenom }}
                            </p>
                            <p class="text-sm text-slate-500">
                                {% if dossier.dateNaissance %}DOB: {{ dossier.dateNaissance|date('d/m/Y') }}{% endif %}
                                {% if dossier.email %} · {{ dossier.email }}{% endif %}
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <a href="{{ path('app_medecin_document_index', {dossierId: dossier.id}) }}" class="bg-primary text-white px-4 py-2 rounded-lg font-semibold hover:bg-primary/90 transition-colors text-sm">
                            View Documents ({{ dossier.documents|length }})
                        </a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% else %}
    <div class="bg-white dark:bg-slate-900 rounded-3xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="text-center py-8">
            <span class="material-symbols-outlined text-5xl text-slate-300 mb-4">folder_off</span>
            <h3 class="text-slate-900 dark:text-white font-bold text-lg mb-2">No Medical Records Found</h3>
            <p class="text-slate-500">No patient medical records are associated with your account yet.</p>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}