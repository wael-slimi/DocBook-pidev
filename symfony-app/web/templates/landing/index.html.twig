<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>DOCBOOK | Your Health, A Click Away</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0066cc",
                        "background-light": "#f5f7f8",
                        "background-dark": "#0f1923",
                    },
                    fontFamily: { "display": ["Inter", "sans-serif"] },
                },
            },
        }
    </script>
    <style>
        .fill-1 { font-variation-settings: 'FILL' 1; }
    </style>
</head>
<body class="font-display bg-background-light dark:bg-background-dark text-[#0c141d] dark:text-slate-50 min-h-screen">
<div class="relative flex flex-col w-full overflow-x-hidden">
    
    <header class="sticky top-0 z-50 w-full border-b border-[#e6edf4] dark:border-slate-800 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md px-4 md:px-20 lg:px-40 py-3">
        <div class="flex items-center justify-between max-w-[1280px] mx-auto w-full">
            <div class="flex items-center gap-4">
                <div class="size-6 text-primary">
                    <svg fill="currentColor" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><path clip-rule="evenodd" d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z" fill-rule="evenodd"></path></svg>
                </div>
                <h2 class="text-lg font-bold leading-tight tracking-tight">DOCBOOK</h2>
            </div>
            <div class="hidden md:flex flex-1 justify-end gap-8">
                <nav class="flex items-center gap-9">
                    <a class="text-sm font-medium hover:text-primary transition-colors" href="#how-it-works">How it Works</a>
                    <a class="text-sm font-medium hover:text-primary transition-colors" href="#benefits">Benefits</a>
                    <a class="text-sm font-medium hover:text-primary transition-colors" href="#doctors">Doctors</a>
                </nav>
                <div class="flex gap-2">
                    <a href="{{ path('app_login') }}" class="flex min-w-[84px] items-center justify-center rounded-lg h-10 px-4 border border-[#e6edf4] dark:border-slate-700 text-sm font-bold">Sign In</a>
                    <a href="{{ path('app_register') }}" class="flex min-w-[84px] items-center justify-center rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold">Get Started</a>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-1">
        <section class="px-4 md:px-20 lg:px-40 py-10 md:py-20">
            <div class="max-w-[1280px] mx-auto">
                <div class="flex flex-col gap-6 lg:flex-row items-center">
                    <div class="w-full bg-center bg-no-repeat aspect-video bg-cover rounded-xl shadow-2xl lg:w-1/2" style='background-image: url("https://images.unsplash.com/photo-1576091160550-2173dba999ef?q=80&w=2070");'></div>
                    <div class="flex flex-col gap-6 lg:w-1/2 lg:pl-12">
                        <h1 class="text-4xl font-black leading-tight md:text-6xl">Your Health, <br/><span class="text-primary">A Click Away</span></h1>
                        <p class="text-base md:text-xl text-slate-600 dark:text-slate-400">Experience the future of healthcare. Connect with top-rated doctors instantly from the comfort of your home.</p>
                        <div class="flex flex-col sm:flex-row gap-4">
                            <a href="{{ path('app_register') }}" class="flex min-w-[160px] items-center justify-center rounded-xl h-14 px-8 bg-primary text-white text-lg font-bold shadow-lg shadow-primary/30">Get Started</a>
                            <button class="flex min-w-[160px] items-center justify-center rounded-xl h-14 px-8 bg-white dark:bg-slate-800 border border-[#e6edf4] dark:border-slate-700 text-lg font-bold">Learn More</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="how-it-works" class="px-4 md:px-20 lg:px-40 py-16 bg-white dark:bg-slate-900/50">
            <div class="max-w-[1280px] mx-auto">
                <div class="flex flex-col items-center text-center mb-12">
                    <h2 class="text-3xl font-bold">How it Works</h2>
                    <div class="h-1.5 w-12 bg-primary mt-2 rounded-full"></div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
                    <div class="flex flex-col items-center text-center">
                        <div class="bg-primary/10 text-primary p-4 rounded-full mb-4"><span class="material-symbols-outlined text-4xl">search</span></div>
                        <h3 class="text-xl font-bold mb-2">Find Your Doctor</h3>
                        <p class="text-slate-600 dark:text-slate-400">Search through verified specialists by specialty, location, or rating.</p>
                    </div>
                    <div class="flex flex-col items-center text-center">
                        <div class="bg-primary/10 text-primary p-4 rounded-full mb-4"><span class="material-symbols-outlined text-4xl">calendar_month</span></div>
                        <h3 class="text-xl font-bold mb-2">Book an Appointment</h3>
                        <p class="text-slate-600 dark:text-slate-400">Choose a time slot that fits your schedule and book instantly.</p>
                    </div>
                    <div class="flex flex-col items-center text-center">
                        <div class="bg-primary/10 text-primary p-4 rounded-full mb-4"><span class="material-symbols-outlined text-4xl">video_chat</span></div>
                        <h3 class="text-xl font-bold mb-2">Consult Online</h3>
                        <p class="text-slate-600 dark:text-slate-400">Meet your doctor via HD video call and get digital prescriptions.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="benefits" class="px-4 md:px-20 lg:px-40 py-20">
            <div class="max-w-[1280px] mx-auto">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-black mb-4">Why Choose DOCBOOK?</h2>
                    <p class="text-slate-600 dark:text-slate-400 max-w-[600px] mx-auto">Quality healthcare available 24/7, anywhere in the world.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="p-8 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                        <div class="bg-primary/10 w-12 h-12 rounded-lg flex items-center justify-center text-primary mb-4">
                            <span class="material-symbols-outlined">shield</span>
                        </div>
                        <h3 class="text-xl font-bold mb-2">Verified Trust</h3>
                        <p class="text-sm text-slate-500">Every doctor is vetted with background checks and medical license verification.</p>
                    </div>
                    <div class="p-8 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                        <div class="bg-primary/10 w-12 h-12 rounded-lg flex items-center justify-center text-primary mb-4">
                            <span class="material-symbols-outlined">lightbulb</span>
                        </div>
                        <h3 class="text-xl font-bold mb-2">Smart Tools</h3>
                        <p class="text-sm text-slate-500">HD Video calls, AI symptom checkers, and secure digital medical records.</p>
                    </div>
                    <div class="p-8 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                        <div class="bg-primary/10 w-12 h-12 rounded-lg flex items-center justify-center text-primary mb-4">
                            <span class="material-symbols-outlined">globe</span>
                        </div>
                        <h3 class="text-xl font-bold mb-2">Accessibility</h3>
                        <p class="text-sm text-slate-500">No more waiting rooms. Consult with specialists from any device, anywhere.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="doctors" class="px-4 md:px-20 lg:px-40 py-20 bg-primary/5">
            <div class="max-w-[1280px] mx-auto">
                <div class="flex justify-between items-end mb-12">
                    <div>
                        <h2 class="text-3xl font-bold">Featured Doctors</h2>
                        <p class="text-slate-600">Top-rated world-class specialists</p>
                    </div>
                    <div class="flex gap-2">
                        <button class="w-10 h-10 rounded-full border border-slate-300 flex items-center justify-center hover:bg-white"><span class="material-symbols-outlined">chevron_left</span></button>
                        <button class="w-10 h-10 rounded-full border border-slate-300 flex items-center justify-center hover:bg-white"><span class="material-symbols-outlined">chevron_right</span></button>
                    </div>
                </div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                     {% for doctor in doctors[:4] if doctor is not null %}
                     <div class="bg-white dark:bg-slate-900 rounded-xl overflow-hidden shadow-sm border border-slate-100 dark:border-slate-800">
                         <div class="h-48 bg-slate-200 bg-cover bg-center" style="background-image: url('{{ doctor.profileImage ? asset('uploads/profiles/' ~ doctor.profileImage) : 'https://ui-avatars.com/api/?name=' ~ doctor.name|url_encode ~ '&size=300' }}');"></div>
                         <div class="p-5">
                             <h3 class="font-bold text-lg">Dr. {{ doctor.name }}</h3>
                             <p class="text-primary text-sm font-medium mb-2">{{ doctor.specialty ? doctor.specialty.value|capitalize : 'General Practitioner' }}</p>
                             <div class="flex items-center gap-1 text-yellow-500 mb-4">
                                 <span class="material-symbols-outlined text-sm fill-1">star</span>
                                 <span class="text-sm font-bold text-slate-700 dark:text-slate-300">{{ doctor.averageRating|default('0.00') }}</span>
                             </div>
                             <a href="{{ path('app_appointment_new', { doctor: doctor.id }) }}" class="w-full py-2 rounded-lg bg-primary/10 text-primary font-bold text-sm hover:bg-primary hover:text-white transition-all text-center">View Profile</a>
                         </div>
                     </div>
                     {% endfor %}
                </div>
            </div>
        </section>
    </main>

    <footer class="bg-white dark:bg-slate-950 border-t border-[#e6edf4] dark:border-slate-800 px-4 md:px-20 lg:px-40 py-16">
        <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
            <div class="flex flex-col gap-6">
                <div class="flex items-center gap-4">
                    <div class="size-6 text-primary">
                        <svg fill="currentColor" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><path d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z"></path></svg>
                    </div>
                    <h2 class="text-lg font-bold">DOCBOOK</h2>
                </div>
                <p class="text-slate-500 text-sm">Redefining healthcare through technology. Connect with the best medical minds anywhere.</p>
            </div>
            <div>
                <h4 class="font-bold mb-6">Services</h4>
                <ul class="flex flex-col gap-4 text-sm text-slate-600">
                    <li><a class="hover:text-primary" href="#">Online Consultation</a></li>
                    <li><a class="hover:text-primary" href="#">E-Prescription</a></li>
                    <li><a class="hover:text-primary" href="#">Health Monitoring</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-6">Company</h4>
                <ul class="flex flex-col gap-4 text-sm text-slate-600">
                    <li><a class="hover:text-primary" href="#">About Us</a></li>
                    <li><a class="hover:text-primary" href="#">Privacy Policy</a></li>
                    <li><a class="hover:text-primary" href="#">Careers</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-6">Contact</h4>
                <ul class="flex flex-col gap-4 text-sm text-slate-600">
                    <li class="flex items-center gap-2"><span class="material-symbols-outlined text-sm">mail</span> support@docbook.com</li>
                    <li class="flex items-center gap-2"><span class="material-symbols-outlined text-sm">call</span> +1 (555) 000-1111</li>
                </ul>
            </div>
        </div>
        <div class="max-w-[1280px] mx-auto mt-16 pt-8 border-t border-slate-100 dark:border-slate-800 text-center text-xs text-slate-400">
            © 2026 DOCBOOK. All rights reserved.
        </div>
    </footer>
</div>
</body>
</html>