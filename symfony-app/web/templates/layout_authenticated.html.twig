{# templates/layout_authenticated.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
    <div class="flex min-h-screen bg-slate-50 dark:bg-slate-950">
        
        <aside class="w-64 border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col h-screen sticky top-0">
            <div class="p-6 flex items-center gap-3 text-primary">
                <div class="size-8 bg-primary rounded-lg flex items-center justify-center text-white">
                    <span class="material-symbols-outlined">medical_services</span>
                </div>
                <h1 class="text-xl font-bold tracking-tight dark:text-white">DOCBOOK</h1>
            </div>

            <nav class="flex-1 px-4 space-y-2 mt-4">
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 px-3 py-2 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-all group">
                    <span class="material-symbols-outlined text-slate-400 group-hover:text-primary">dashboard</span>
                    <span class="font-medium">Dashboard</span>
                </a>
                
                <a href="{{ path('app_appointment_index') }}" class="flex items-center gap-3 px-3 py-2 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-all group">
                    <span class="material-symbols-outlined text-slate-400 group-hover:text-primary">calendar_today</span>
                    <span class="font-medium">Appointments</span>
                </a>
            </nav>

            <div class="p-4 border-t border-slate-200 dark:border-slate-800">
                <div class="flex items-center gap-3 mb-4 px-2">
                    <div class="size-10 rounded-full bg-primary/10 flex items-center justify-center font-bold text-primary">
                        {{ app.user.name|slice(0, 1)|upper }}
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-sm font-bold truncate dark:text-white">{{ app.user.name }}</p>
                        <p class="text-xs text-slate-500 truncate lowercase">Logged in</p>
                    </div>
                </div>

                <a href="{{ path('app_logout') }}" 
                   class="flex items-center gap-3 px-3 py-2 w-full text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-xl font-bold transition-all">
                    <span class="material-symbols-outlined">logout</span>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <main class="flex-1 p-8 lg:p-12 overflow-y-auto">
            {# This is where the specific dashboard content will go #}
            {% block dashboard_content %}{% endblock %}
        </main>
    </div>
{% endblock %}