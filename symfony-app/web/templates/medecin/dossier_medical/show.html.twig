{% extends 'dashboard_base.html.twig' %}

{% block title %}Dossier médical - {{ dossier.numeroDossier }} - DOCBOOK{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-8">
    <div class="flex flex-col gap-1">
        <h1 class="text-4xl font-black text-slate-900 dark:text-white">Dossier médical</h1>
        <p class="text-slate-500">Dossier #{{ dossier.numeroDossier }}</p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-black text-slate-900 dark:text-white">{{ dossier.patientNom }} {{ dossier.patientPrenom }}</h3>
                    <p class="text-sm text-slate-500">Né(e) le {{ dossier.dateNaissance|date('d/m/Y') }} | {{ dossier.genre }}</p>
                </div>
                <div class="flex gap-2">
                    <a href="{{ path('app_medecin_dossier_edit', {id: dossier.id}) }}" class="bg-primary text-white px-4 py-2 rounded-lg font-semibold hover:bg-primary/90 transition-colors">
                        <span class="material-symbols-outlined mr-1">edit</span> Modifier
                    </a>
                </div>
            </div>
        </div>

        <div class="p-6 grid grid-cols-2 gap-6">
            <div>
                <p class="text-sm text-slate-500">Email</p>
                <p class="font-medium text-slate-900 dark:text-white">{{ dossier.email ?? 'Non renseigné' }}</p>
            </div>
            <div>
                <p class="text-sm text-slate-500">Téléphone</p>
                <p class="font-medium text-slate-900 dark:text-white">{{ dossier.telephone ?? 'Non renseigné' }}</p>
            </div>
            <div>
                <p class="text-sm text-slate-500">Adresse</p>
                <p class="font-medium text-slate-900 dark:text-white">{{ dossier.adresse ?? 'Non renseignée' }}</p>
            </div>
            <div>
                <p class="text-sm text-slate-500">Date de création</p>
                <p class="font-medium text-slate-900 dark:text-white">{{ dossier.dateCreation|date('d/m/Y H:i') }}</p>
            </div>
        </div>

        {% if dossier.remarques %}
        <div class="px-6 pb-6">
            <div class="bg-slate-50 dark:bg-slate-800/50 rounded-xl p-4">
                <p class="text-sm text-slate-500 mb-1">Remarques</p>
                <p class="text-slate-900 dark:text-white">{{ dossier.remarques }}</p>
            </div>
        </div>
        {% endif %}

        <div class="px-6 pb-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-black text-slate-900 dark:text-white">Documents</h3>
                <a href="{{ path('app_medecin_document_new', {dossierId: dossier.id}) }}" class="bg-primary text-white px-4 py-2 rounded-lg font-semibold hover:bg-primary/90 transition-colors">
                    <span class="material-symbols-outlined mr-1">add</span> Ajouter
                </a>
            </div>

            {% if dossier.documents is not empty %}
                <div class="space-y-3">
                    {% for document in dossier.documents %}
                        <a href="{{ path('app_medecin_document_show', {dossierId: dossier.id, id: document.id}) }}" class="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="size-10 bg-blue-50 dark:bg-blue-900/20 text-blue-600 rounded-lg flex items-center justify-center">
                                    <span class="material-symbols-outlined">description</span>
                                </div>
                                <div>
                                    <p class="font-medium text-slate-900 dark:text-white">{{ document.titre }}</p>
                                    <p class="text-xs text-slate-500">
                                        {{ document.typeDocument|capitalize }} • {{ document.dateDocument|date('d/m/Y') }}
                                    </p>
                                </div>
                            </div>
                            <span class="text-slate-400">→</span>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-slate-500 text-center py-8">Aucun document pour ce dossier</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}