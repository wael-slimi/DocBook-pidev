{% extends 'dashboard_base.html.twig' %}

{% block title %}Nouveau document - Dossier #{{ dossier.numeroDossier }} - DOCBOOK{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto space-y-8">
    <div class="flex flex-col gap-1">
        <h1 class="text-4xl font-black text-slate-900 dark:text-white">Nouveau document</h1>
        <p class="text-slate-500">Dossier #{{ dossier.numeroDossier }} - {{ dossier.patientNom }} {{ dossier.patientPrenom }}</p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm p-6">
        {{ form_start(form) }}

        <div class="space-y-6">
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Titre</label>
                {{ form_widget(form.titre, { 'attr': { 'class': 'w-full' } }) }}
                {{ form_errors(form.titre) }}
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Type</label>
                {{ form_widget(form.typeDocument, { 'attr': { 'class': 'w-full' } }) }}
                {{ form_errors(form.typeDocument) }}
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Date du document</label>
                {{ form_widget(form.dateDocument, { 'attr': { 'class': 'w-full' } }) }}
                {{ form_errors(form.dateDocument) }}
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Contenu</label>
                {{ form_widget(form.contenu, { 'attr': { 'class': 'w-full', 'rows': 8 } }) }}
                {{ form_errors(form.contenu) }}
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Chemin du fichier</label>
                {{ form_widget(form.fichierPath, { 'attr': { 'class': 'w-full' } }) }}
                {{ form_errors(form.fichierPath) }}
            </div>
        </div>

        <div class="flex justify-end gap-4 mt-8">
            <a href="{{ path('app_patient_document_index', {dossierId: dossier.id}) }}" class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-6 py-3 rounded-lg font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                Annuler
            </a>
            <button type="submit" class="bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors shadow-lg shadow-primary/20">
                Créer
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}