{% for dossier in dossiers %}
    <div class="flex items-center justify-between p-6 bg-slate-50 dark:bg-slate-800/50 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
        <div class="flex items-center gap-4">
            <div class="size-12 bg-blue-50 dark:bg-blue-900/20 text-blue-600 rounded-2xl flex items-center justify-center">
                <span class="material-symbols-outlined">folder</span>
            </div>
            <div>
                <p class="font-bold text-slate-900 dark:text-white">{{ dossier.numeroDossier }}</p>
                <p class="text-sm text-slate-500">
                    {{ dossier.patientNom }} {{ dossier.patientPrenom }}
                    {% if dossier.dateNaissance %} • Né(e) le {{ dossier.dateNaissance|date('d/m/Y') }}{% endif %}
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('app_patient_document_index', {dossierId: dossier.id}) }}" class="bg-primary text-white px-4 py-2 rounded-lg font-semibold hover:bg-primary/90 transition-colors">
                <span class="material-symbols-outlined mr-1">description</span> Documents
            </a>
            {% if can_edit_dossier is defined and can_edit_dossier %}
                <a href="{{ path('app_patient_dossier_edit', {id: dossier.id}) }}" class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-4 py-2 rounded-lg font-semibold hover:bg-slate-200 dark:hover:bg-slate-700">
                    Modifier
                </a>
            {% endif %}
        </div>
    </div>
{% else %}
    <div class="text-center py-12">
        <div class="size-16 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined text-3xl text-slate-400">folder_off</span>
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Aucun dossier médical</h3>
        <p class="text-slate-500 mb-6">Créez votre premier dossier médical.</p>
        <a href="{{ path('app_patient_dossier_new') }}" class="bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors inline-flex items-center gap-2">
            <span class="material-symbols-outlined">add</span> Nouveau dossier
        </a>
    </div>
{% endfor %}
