{% extends 'dashboard_base.html.twig' %}

{% block title %}Find Doctors - DOCBOOK{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-8">
    <div class="flex flex-col gap-1">
        <h1 class="text-4xl font-black text-slate-900 dark:text-white">Find your doctor</h1>
        <p class="text-slate-500">Book an appointment with top-rated specialists in Tunisia.</p>
    </div>

    <div class="flex flex-wrap gap-4">
        <a href="{{ path('app_appointment_index') }}" class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-6 py-3 rounded-lg font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            <span class="material-symbols-outlined mr-2">calendar_month</span> My Appointments
        </a>
        <a href="{{ path('app_teleconsultation_index') }}" class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-6 py-3 rounded-lg font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            <span class="material-symbols-outlined mr-2">videocam</span> Teleconsultations
        </a>
        <a href="{{ path('app_patient_dashboard') }}" class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-6 py-3 rounded-lg font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            <span class="material-symbols-outlined mr-2">dashboard</span> Back to Dashboard
        </a>
    </div>

    <div class="grid grid-cols-12 gap-8">

        <aside class="col-span-12 lg:col-span-3">
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 shadow-sm border border-slate-200 dark:border-slate-800 sticky top-24">
                <h3 class="text-lg font-bold mb-6 text-slate-900 dark:text-white">Filters</h3>

                <form action="{{ path('app_doctor_search') }}" method="GET" class="space-y-6">
                    <input type="hidden" name="q" value="{{ searchTerm }}">

                    <div class="space-y-2">
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-500">Specialty</label>
                        <select name="specialty" onchange="this.form.submit()" class="w-full rounded-xl border border-slate-200 dark:bg-slate-800 dark:border-slate-700 text-sm px-3 py-2">
                            <option value="All">All Specialties</option>
                            {% for spec in specialties %}
                                <option value="{{ spec.value }}" {{ selectedSpecialty|lower == spec.value ? 'selected' }}>
                                    {{ spec.value|capitalize }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-500">Price Range (TND)</label>
                        <div class="flex gap-2">
                            <input type="number" name="minPrice" value="{{ minPrice }}" placeholder="Min" class="w-full rounded-xl border border-slate-200 dark:bg-slate-800 dark:border-slate-700 text-sm px-3 py-2">
                            <input type="number" name="maxPrice" value="{{ maxPrice }}" placeholder="Max" class="w-full rounded-xl border border-slate-200 dark:bg-slate-800 dark:border-slate-700 text-sm px-3 py-2">
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white py-3 rounded-xl font-bold transition-all shadow-lg shadow-primary/20">
                        Update Results
                    </button>
                </form>
            </div>
        </aside>

        <div class="col-span-12 lg:col-span-9 space-y-4">
            {% for doctor in doctors %}
                <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200 dark:border-slate-800 hover:border-primary/30 transition-all shadow-sm">
                    <div class="flex flex-col md:flex-row gap-6">
                        <div class="size-32 rounded-2xl bg-cover bg-center flex-shrink-0 shadow-inner border border-slate-100 dark:border-slate-800"
                             style="background-image: url('{{ doctor.profilePicture ? asset('uploads/profiles/' ~ doctor.profilePicture) : 'https://ui-avatars.com/api/?name=' ~ doctor.name|url_encode }}');">
                        </div>

                        <div class="flex-1">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Dr. {{ doctor.name }}</h2>
                                    <p class="text-primary font-medium text-sm">
                                        {% if doctor.specialty %}
                                            {{ doctor.specialty.value|capitalize }}
                                        {% else %}
                                            General Practitioner
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="text-right">
                                    <p class="text-[10px] font-bold uppercase text-slate-400">Consultation</p>
                                    <p class="text-xl font-black text-slate-900 dark:text-white">{{ doctor.consultationFee|default('0') }} TND</p>
                                </div>
                            </div>

                            <p class="text-slate-500 dark:text-slate-400 text-sm mt-3 line-clamp-2">
                                {{ doctor.bio ?: 'Experienced healthcare professional dedicated to providing high-quality patient care.' }}
                            </p>

                            <div class="mt-6 flex items-center justify-between">
<div class="flex items-center gap-2">
                                     <div class="flex text-yellow-400">
                                         <span class="material-symbols-outlined text-sm fill-1">star</span>
                                     </div>
                                     <span class="text-xs font-bold text-slate-600 dark:text-slate-300">{{ doctor.averageRating|default('0.00') }} ({{ doctor.totalReviews|default(0) }} reviews)</span>
                                 </div>
                                </div>
                                <a href="{{ path('app_appointment_new', { doctor: doctor.id }) }}" class="bg-primary text-white px-6 py-2 rounded-lg text-sm font-bold hover:bg-primary/90 transition-colors shadow-lg shadow-primary/20">
                                    Book Appointment
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="py-20 text-center bg-white dark:bg-slate-900 rounded-3xl border-2 border-dashed border-slate-200 dark:border-slate-800">
                    <div class="size-16 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-3xl text-slate-400">search_off</span>
                    </div>
                    <h3 class="text-slate-900 dark:text-white font-bold mt-4">No doctors found</h3>
                    <p class="text-slate-500 text-sm mt-1">Try adjusting your filters or search keywords.</p>
                    <a href="{{ path('app_doctor_search') }}" class="inline-block mt-6 text-primary font-bold text-sm hover:text-primary/80 transition-colors">Clear all filters</a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
