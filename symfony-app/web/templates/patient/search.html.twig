{# templates/patient/search.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Search Doctors - DOCBOOK{% endblock %}

{% block body %}
<div class="flex flex-col w-full bg-slate-50 dark:bg-slate-950 font-sans text-slate-900 dark:text-slate-100 min-h-screen">
    
    {# Header Section #}
    <header class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-10 py-3 sticky top-0 z-50">
        <div class="flex items-center gap-8">
            <div class="flex items-center gap-4 text-blue-600">
                <div class="size-6">
                    <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                        <path clip-rule="evenodd" d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z" fill="currentColor" fill-rule="evenodd"></path>
                    </svg>
                </div>
                <h2 class="text-slate-900 dark:text-white text-lg font-bold">DOCBOOK</h2>
            </div>
            
            <form action="{{ path('app_doctor_search') }}" method="GET" class="flex items-stretch rounded-lg bg-slate-100 dark:bg-slate-800 h-10 w-64">
                <div class="flex items-center pl-3 text-slate-500">
                    <span class="material-symbols-outlined text-sm">search</span>
                </div>
                <input 
                    name="q" 
                    value="{{ searchTerm }}" 
                    class="bg-transparent border-none focus:ring-0 text-sm w-full" 
                    placeholder="Search doctors..."
                />
            </form>
        </div>
        
        <div class="flex items-center gap-6">
            <a class="text-blue-600 text-sm font-semibold" href="{{ path('app_dashboard') }}">Dashboard</a>
            <div class="size-10 rounded-full border-2 border-blue-100 bg-cover bg-center" 
                 style="background-image: url('https://ui-avatars.com/api/?name={{ app.user.name|url_encode }}');">
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto w-full px-6 py-10">
        <div class="mb-10">
            <h1 class="text-4xl font-black text-slate-900 dark:text-white tracking-tight">Find your doctor</h1>
            <p class="text-slate-500 mt-2">Book an appointment with top-rated specialists in Tunisia.</p>
        </div>

        <div class="grid grid-cols-12 gap-8">
            {# Filters Sidebar #}
            <aside class="col-span-12 lg:col-span-3">
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-sm border border-slate-200 dark:border-slate-800 sticky top-24">
                    <h3 class="text-lg font-bold mb-6">Filters</h3>

                    <form action="{{ path('app_doctor_search') }}" method="GET" class="space-y-6">
                        <input type="hidden" name="q" value="{{ searchTerm }}">

                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-slate-500">Specialty</label>
                            <select name="specialty" onchange="this.form.submit()" class="w-full rounded-xl border-slate-200 dark:bg-slate-800 dark:border-slate-700 text-sm">
                                <option value="All">All Specialties</option>
                                {% for spec in specialties %}
                                    {# Compare using spec.value (lowercase) #}
                                    <option value="{{ spec.value }}" {{ selectedSpecialty|lower == spec.value ? 'selected' }}>
                                        {{ spec.value|capitalize }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-wider text-slate-500">Price Range (TND)</label>
                            <div class="flex gap-2">
                                <input type="number" name="minPrice" value="{{ minPrice }}" placeholder="Min" class="w-full rounded-xl border-slate-200 dark:bg-slate-800 text-sm">
                                <input type="number" name="maxPrice" value="{{ maxPrice }}" placeholder="Max" class="w-full rounded-xl border-slate-200 dark:bg-slate-800 text-sm">
                            </div>
                        </div>

                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-bold transition-all shadow-lg shadow-blue-200 dark:shadow-none">
                            Update Results
                        </button>
                    </form>
                </div>
            </aside>

            {# Results Area #}
            <div class="col-span-12 lg:col-span-9 space-y-4">
                {% for doctor in doctors %}
                    <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200 dark:border-slate-800 hover:border-blue-300 transition-all flex flex-col md:flex-row gap-6">
                        <div class="size-32 rounded-2xl bg-cover bg-center flex-shrink-0 shadow-inner" 
                             style="background-image: url('{{ doctor.profilePicture ? asset('uploads/profiles/' ~ doctor.profilePicture) : 'https://ui-avatars.com/api/?name=' ~ doctor.name|url_encode }}');">
                        </div>
                        
                        <div class="flex-1">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Dr. {{ doctor.name }}</h2>
                                    <p class="text-blue-600 font-medium text-sm">
                                        {% if doctor.specialty %}
                                            {{ doctor.specialty.value|capitalize }}
                                        {% else %}
                                            General Practitioner
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="text-right">
                                    <p class="text-[10px] font-bold uppercase text-slate-400">Consultation</p>
                                    <p class="text-xl font-black text-slate-900 dark:text-white">{{ doctor.consultationFee|default('0') }} TND</p>
                                </div>
                            </div>
                            
                            <p class="text-slate-500 dark:text-slate-400 text-sm mt-3 line-clamp-2">
                                {{ doctor.bio ?: 'Experienced healthcare professional dedicated to providing high-quality patient care.' }}
                            </p>
                            
                            <div class="mt-6 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="flex text-yellow-400">
                                        <span class="material-symbols-outlined text-sm">star</span>
                                    </div>
                                    <span class="text-xs font-bold text-slate-600 dark:text-slate-300">4.9 ({{ random(10, 50) }} reviews)</span>
                                </div>
                                <button class="bg-slate-900 dark:bg-white dark:text-slate-900 text-white px-6 py-2 rounded-lg text-sm font-bold">Book Now</button>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="py-20 text-center bg-white dark:bg-slate-900 rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-800">
                        <span class="material-symbols-outlined text-slate-300 text-6xl">search_off</span>
                        <h3 class="text-slate-900 dark:text-white font-bold mt-4">No doctors found</h3>
                        <p class="text-slate-500 text-sm mt-1">Try adjusting your filters or search keywords.</p>
                        <a href="{{ path('app_doctor_search') }}" class="inline-block mt-6 text-blue-600 font-bold text-sm underline">Clear all filters</a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </main>
</div>
{% endblock %}