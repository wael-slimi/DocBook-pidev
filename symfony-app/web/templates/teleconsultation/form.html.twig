{% extends 'dashboard_base.html.twig' %}

{% block title %}{{ is_edit ? 'Edit' : 'New' }} Teleconsultation{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-6 max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">{{ is_edit ? 'Edit Teleconsultation' : 'New Teleconsultation' }}</h1>
    <p class="text-sm text-gray-500 mb-6">{{ is_edit ? 'Update teleconsultation details' : 'Create a new teleconsultation session' }}</p>

    {{ form_start(form, {attr: {class: 'space-y-6'}}) }}

        <div>
            {{ form_label(form.appointment, 'Associated Appointment *', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.appointment, {attr: {class: 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.appointment, {attr: {class: 'text-red-500 text-sm mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.mode, 'Consultation Mode *', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.mode, {attr: {class: 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.mode, {attr: {class: 'text-red-500 text-sm mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.duration, 'Duration (minutes)', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.duration, {attr: {class: 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500', placeholder: '30'}}) }}
            {{ form_errors(form.duration, {attr: {class: 'text-red-500 text-sm mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.videoLink, 'Meeting URL *', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.videoLink, {attr: {class: 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500', placeholder: 'https://meet.google.com/abc-defg-hij'}}) }}
            {{ form_errors(form.videoLink, {attr: {class: 'text-red-500 text-sm mt-1'}}) }}
        </div>

        <div class="flex gap-4">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium transition">
                {{ is_edit ? 'Update' : 'Create' }}
            </button>
            <a href="{{ path('app_teleconsultation_index') }}" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition text-center">
                Cancel
            </a>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}
