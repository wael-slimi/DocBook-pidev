{% extends 'dashboard_base.html.twig' %}

{% block title %}Teleconsultations{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Teleconsultations</h1>
        <a href="{{ path('app_teleconsultation_new') }}" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
            + Nouveau
        </a>
    </div>

    <form method="get" action="{{ path('app_teleconsultation_index') }}" class="flex gap-4 mb-6">
        <input type="text" name="q" value="{{ q|default('') }}" placeholder="Search by URL..." class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        <select name="mode" class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">All</option>
            <option value="video" {{ current_mode == 'video' ? 'selected' }}>Video</option>
            <option value="chat" {{ current_mode == 'chat' ? 'selected' }}>Chat</option>
            <option value="audio" {{ current_mode == 'audio' ? 'selected' }}>Audio</option>
        </select>
        <button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition">
            Filter
        </button>
    </form>

    {% if teleconsultations is empty %}
        <div class="text-center py-16">
            <p class="text-5xl mb-4">👋</p>
            <p class="text-lg font-semibold text-gray-600">No teleconsultations found</p>
        </div>
    {% else %}
        <div class="space-y-4">
            {% for tc in teleconsultations %}
                {% set apt = tc.appointment %}
                <div class="bg-white rounded-xl border border-gray-100 p-4 shadow-sm hover:shadow-md transition">
                    <div class="flex items-start justify-between">
                        <div class="space-y-1">
                            {% if is_granted('ROLE_DOCTOR') and apt.patient %}
                                <p class="font-semibold text-gray-800">👤 Patient #{{ apt.patient.id }}</p>
                            {% elseif is_granted('ROLE_PATIENT') and apt.doctor %}
                                <p class="font-semibold text-gray-800">👨‍⚕️ Dr. {{ apt.doctor.name }}</p>
                            {% endif %}
                            {% if apt.department %}
                                <p class="text-sm text-gray-500">🏥 {{ apt.department }}</p>
                            {% endif %}
                            {% if apt.scheduledAt %}
                                <p class="text-sm text-gray-500">📅 {{ apt.scheduledAt|date('M d, Y H:i') }}</p>
                            {% endif %}
                        </div>

                        <div class="text-right space-y-2">
                            {% if tc.mode %}
                                <span class="inline-block px-3 py-1 rounded text-xs font-bold text-white
                                    {% if tc.mode == 'video' %}bg-green-500
                                    {% elseif tc.mode == 'chat' %}bg-blue-500
                                    {% elseif tc.mode == 'audio' %}bg-orange-500
                                    {% else %}bg-gray-500{% endif %}">
                                    {{ tc.mode|upper }}
                                </span>
                            {% endif %}
                            <div class="flex gap-1">
                                <a href="{{ path('app_teleconsultation_edit', {id: tc.id}) }}" class="bg-blue-500 hover:bg-blue-600 text-white text-xs px-3 py-1 rounded transition">✏️ Edit</a>
                                <form method="post" action="{{ path('app_teleconsultation_delete', {id: tc.id}) }}" onsubmit="return confirm('Delete this teleconsultation?')" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tc.id) }}">
                                    <button type="submit" class="bg-red-500 hover:bg-red-600 text-white text-xs px-3 py-1 rounded transition">🗑️ Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 grid grid-cols-3 gap-4 text-sm text-gray-600">
                        {% if tc.mode %}
                            <div><span class="font-medium">Mode:</span> {{ tc.mode }}</div>
                        {% endif %}
                        {% if tc.duration %}
                            <div><span class="font-medium">Duration:</span> {{ tc.duration }} minutes</div>
                        {% endif %}
                        {% if tc.videoLink %}
                            <div class="col-span-full">
                                <span class="font-medium">Meeting URL:</span>
                                <a href="{{ tc.videoLink }}" target="_blank" class="text-blue-600 hover:underline ml-1 break-all">{{ tc.videoLink }}</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        <p class="mt-4 text-sm text-gray-500">Total: {{ teleconsultations|length }}</p>
    {% endif %}
</div>
{% endblock %}
