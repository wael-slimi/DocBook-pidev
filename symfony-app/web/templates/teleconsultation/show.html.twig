{% extends 'dashboard_base.html.twig' %}

{% block title %}Teleconsultation #{{ teleconsultation.id }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-6 max-w-2xl">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Teleconsultation #{{ teleconsultation.id }}</h1>
        <a href="{{ path('app_teleconsultation_index') }}" class="text-blue-600 hover:underline text-sm">← Back</a>
    </div>

    {% set apt = teleconsultation.appointment %}
    <div class="bg-white rounded-xl border border-gray-100 p-6 shadow-sm">
        <div class="space-y-4">
            <div class="flex justify-between">
                <div>
                    <p class="text-sm text-gray-500">Patient</p>
                    <p class="font-semibold">{{ apt.patient.name ?? 'N/A' }}</p>
                </div>
                <div class="text-right">
                    <p class="text-sm text-gray-500">Doctor</p>
                    <p class="font-semibold">Dr. {{ apt.doctor.name ?? 'N/A' }}</p>
                </div>
            </div>

            <div class="border-t pt-4 grid grid-cols-2 gap-4 text-sm">
                <div>
                    <p class="text-gray-500">Department</p>
                    <p class="font-medium">{{ apt.department ?? 'N/A' }}</p>
                </div>
                <div>
                    <p class="text-gray-500">Scheduled At</p>
                    <p class="font-medium">{{ apt.scheduledAt ? apt.scheduledAt|date('M d, Y H:i') : 'N/A' }}</p>
                </div>
                <div>
                    <p class="text-gray-500">Mode</p>
                    <p class="font-medium">{{ teleconsultation.mode ?? 'N/A' }}</p>
                </div>
                <div>
                    <p class="text-gray-500">Duration</p>
                    <p class="font-medium">{{ teleconsultation.duration ? teleconsultation.duration ~ ' minutes' : 'N/A' }}</p>
                </div>
            </div>

            <div class="border-t pt-4">
                <p class="text-sm text-gray-500 mb-1">Meeting URL</p>
                <a href="{{ teleconsultation.videoLink }}" target="_blank" class="text-blue-600 hover:underline break-all">{{ teleconsultation.videoLink }}</a>
            </div>

            {% if apt.reason %}
            <div class="border-t pt-4">
                <p class="text-sm text-gray-500 mb-1">Reason</p>
                <p class="text-gray-700">{{ apt.reason }}</p>
            </div>
            {% endif %}
        </div>

        <div class="mt-6 flex gap-3">
            <a href="{{ path('app_teleconsultation_edit', {id: teleconsultation.id}) }}" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm transition">✏️ Edit</a>
            <a href="{{ teleconsultation.videoLink }}" target="_blank" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg text-sm transition">🔗 Join Room</a>
        </div>
    </div>
</div>
{% endblock %}
