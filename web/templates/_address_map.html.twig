{# Leaflet address picker: search address or click on map to set the adresse field. Include with: include('_address_map.html.twig', { address_field_id: form.adresse.vars.id }) #}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<style>
    .address-map-wrap { margin-top: 0.75rem; }
    .address-map-search { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; }
    .address-map-search input { flex: 1; padding: 0.5rem 0.75rem; border: 1px solid var(--border, #dbe2ea); border-radius: 8px; font-size: 0.9rem; }
    .address-map-search button { padding: 0.5rem 1rem; background: var(--primary, #4f46e5); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 0.9rem; }
    .address-map-search button:hover { opacity: 0.9; }
    #address-map { height: 280px; width: 100%; border-radius: 8px; border: 1px solid var(--border, #dbe2ea); }
    .address-map-hint { font-size: 0.8rem; color: var(--text-muted, #718096); margin-top: 0.5rem; }
</style>
<div class="address-map-wrap" data-address-field-id="{{ address_field_id|default('dossier_medical_adresse') }}">
    <label class="address-map-label" style="font-size:0.8rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; margin-bottom:0.5rem;">Choisir l'adresse sur la carte</label>
    <div class="address-map-search">
        <input type="text" class="address-map-input" placeholder="Rechercher une adresse (ex: Tunis, Paris…)">
        <button type="button" class="address-map-btn-search">Rechercher</button>
    </div>
    <div id="address-map"></div>
    <p class="address-map-hint">Cliquez sur la carte pour définir l'adresse, ou recherchez puis validez.</p>
</div>
<script>
(function() {
    var wrap = document.querySelector('.address-map-wrap');
    if (!wrap) return;
    var fieldId = wrap.getAttribute('data-address-field-id');
    var addressField = document.getElementById(fieldId);
    var mapEl = document.getElementById('address-map');
    var searchInput = wrap.querySelector('.address-map-input');
    var searchBtn = wrap.querySelector('.address-map-btn-search');
    if (!mapEl || !addressField) return;

    var map = L.map('address-map').setView([33.5731, 7.5898], 5);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);
    var marker = null;

    function setMarker(lat, lng, addressText) {
        if (marker) map.removeLayer(marker);
        marker = L.marker([lat, lng]).addTo(map);
        if (addressText && addressField) addressField.value = addressText;
    }

    function geocodeSearch(q, done) {
        var url = 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(q) + '&limit=3';
        fetch(url, { headers: { 'Accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data[0]) {
                    var r = data[0];
                    done(null, { lat: parseFloat(r.lat), lng: parseFloat(r.lon), display_name: r.display_name });
                } else done('Aucun résultat');
            })
            .catch(function() { done('Erreur de recherche'); });
    }

    function reverseGeocode(lat, lng, done) {
        var url = 'https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lng;
        fetch(url, { headers: { 'Accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                done(null, data && data.display_name ? data.display_name : lat + ', ' + lng);
            })
            .catch(function() { done(null, lat + ', ' + lng); });
    }

    if (searchBtn && searchInput) {
        searchBtn.addEventListener('click', function() {
            var q = searchInput.value.trim();
            if (!q) return;
            searchBtn.disabled = true;
            searchBtn.textContent = 'Recherche…';
            geocodeSearch(q, function(err, result) {
                searchBtn.disabled = false;
                searchBtn.textContent = 'Rechercher';
                if (err) { alert(err); return; }
                map.setView([result.lat, result.lng], 15);
                setMarker(result.lat, result.lng, result.display_name);
            });
        });
        searchInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); searchBtn.click(); } });
    }

    map.on('click', function(e) {
        var lat = e.latlng.lat, lng = e.latlng.lng;
        setMarker(lat, lng, '');
        reverseGeocode(lat, lng, function(err, addr) {
            if (addr && addressField) addressField.value = addr;
        });
    });
})();
</script>
