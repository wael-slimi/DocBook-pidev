{% extends 'base.html.twig' %}

{% block title %}{{ document.id ? 'Modifier' : 'Nouveau' }} document - Admin{% endblock %}

{% block body %}
<div class="page-header">
    <h1>{{ document.id ? 'Modifier le document' : 'Nouveau document' }}</h1>
    <div class="page-actions">
        <a href="{{ path('app_admin_document_index', { dossierId: dossier.id }) }}" class="btn btn-secondary">Retour liste</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        {% if form.vars.errors|length > 0 %}
        <ul class="form-errors">
            {% for error in form.vars.errors %}
            <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
        {% endif %}

        <form method="post" novalidate="novalidate">
            {{ form_row(form.titre) }}
            {% if form.titre.vars.errors|length > 0 %}<ul class="field-error">{% for e in form.titre.vars.errors %}<li>{{ e.message }}</li>{% endfor %}</ul>{% endif %}
            {{ form_row(form.typeDocument) }}
            {% if form.typeDocument.vars.errors|length > 0 %}<ul class="field-error">{% for e in form.typeDocument.vars.errors %}<li>{{ e.message }}</li>{% endfor %}</ul>{% endif %}
            {{ form_row(form.dateDocument) }}
            {% if form.dateDocument.vars.errors|length > 0 %}<ul class="field-error">{% for e in form.dateDocument.vars.errors %}<li>{{ e.message }}</li>{% endfor %}</ul>{% endif %}
            {{ form_row(form.contenu) }}
            {% if form.contenu.vars.errors|length > 0 %}<ul class="field-error">{% for e in form.contenu.vars.errors %}<li>{{ e.message }}</li>{% endfor %}</ul>{% endif %}
            {{ form_row(form.fichierPath) }}
            {% if form.fichierPath.vars.errors|length > 0 %}<ul class="field-error">{% for e in form.fichierPath.vars.errors %}<li>{{ e.message }}</li>{% endfor %}</ul>{% endif %}
            {{ form_rest(form) }}
            <div class="actions"><button type="submit" class="btn btn-primary">Enregistrer</button></div>
        </form>
    </div>
</div>
{% endblock %}
