{% extends 'base.html.twig' %}

{% block title %}Dossiers médicaux - Admin{% endblock %}

{% block body %}
<h1>Dossiers médicaux (Admin)</h1>
{% if can_edit_dossier %}
<p><a href="{{ path('app_admin_dossier_new') }}" class="btn btn-primary">Nouveau dossier</a></p>
{% endif %}

<div class="filters" id="filters-dossiers">
    <div>
        <label for="q">Recherche</label>
        <input type="text" id="q" name="q" value="{{ q|default('') }}" placeholder="N° dossier, nom, prénom, email">
    </div>
    <div>
        <label for="tri">Tri</label>
        <select id="tri" name="tri">
            <option value="dateCreation" {{ tri == 'dateCreation' ? 'selected' : '' }}>Date création</option>
            <option value="dateModification" {{ tri == 'dateModification' ? 'selected' : '' }}>Date modification</option>
            <option value="patientNom" {{ tri == 'patientNom' ? 'selected' : '' }}>Nom</option>
            <option value="numeroDossier" {{ tri == 'numeroDossier' ? 'selected' : '' }}>N° dossier</option>
        </select>
    </div>
    <div>
        <label for="ordre">Ordre</label>
        <select id="ordre" name="ordre">
            <option value="DESC" {{ ordre == 'DESC' ? 'selected' : '' }}>Décroissant</option>
            <option value="ASC" {{ ordre == 'ASC' ? 'selected' : '' }}>Croissant</option>
        </select>
    </div>
    <div>
        <label for="date_debut">Date début</label>
        <input type="date" id="date_debut" name="date_debut" value="{{ date_debut|default('') }}">
    </div>
    <div>
        <label for="date_fin">Date fin</label>
        <input type="date" id="date_fin" name="date_fin" value="{{ date_fin|default('') }}">
    </div>
    <div>
        <label for="genre">Genre</label>
        <select id="genre" name="genre">
            <option value="">-- Tous --</option>
            <option value="M" {{ genre == 'M' ? 'selected' : '' }}>M</option>
            <option value="F" {{ genre == 'F' ? 'selected' : '' }}>F</option>
            <option value="Autre" {{ genre == 'Autre' ? 'selected' : '' }}>Autre</option>
        </select>
    </div>
    <div>
        <button type="button" class="btn btn-primary" id="btn-search">Rechercher</button>
    </div>
</div>

<p><span id="list-total">{{ total }}</span> dossier(s).</p>

<table>
    <thead>
        <tr>
            <th>N° dossier</th>
            <th>Patient</th>
            <th>Date création</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="dossier-tbody">
        {% include 'admin/dossier_medical/_list_rows.html.twig' %}
    </tbody>
</table>
{% endblock %}

{% block javascripts %}
<script>
(function() {
    const baseUrl = '{{ path('app_admin_dossier_index') }}';
    const tbody = document.getElementById('dossier-tbody');
    const totalEl = document.getElementById('list-total');
    const q = document.getElementById('q');
    const tri = document.getElementById('tri');
    const ordre = document.getElementById('ordre');
    const dateDebut = document.getElementById('date_debut');
    const dateFin = document.getElementById('date_fin');
    const genre = document.getElementById('genre');

    function doSearch() {
        const params = new URLSearchParams();
        params.set('ajax', '1');
        if (q.value) params.set('q', q.value);
        params.set('tri', tri.value);
        params.set('ordre', ordre.value);
        if (dateDebut.value) params.set('date_debut', dateDebut.value);
        if (dateFin.value) params.set('date_fin', dateFin.value);
        if (genre.value) params.set('genre', genre.value);
        fetch(baseUrl + '?' + params.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { const t = r.headers.get('X-Total-Count'); if (t !== null && totalEl) totalEl.textContent = t; return r.text(); })
            .then(html => { tbody.innerHTML = html; });
    }

    let debounceTimer;
    function doSearchDebounced() { clearTimeout(debounceTimer); debounceTimer = setTimeout(doSearch, 300); }
    document.getElementById('btn-search').addEventListener('click', doSearch);
    q.addEventListener('input', doSearchDebounced);
    q.addEventListener('keyup', function(e) { if (e.key === 'Enter') doSearch(); });
    tri.addEventListener('change', doSearch);
    ordre.addEventListener('change', doSearch);
    dateDebut.addEventListener('change', doSearch);
    dateFin.addEventListener('change', doSearch);
    genre.addEventListener('change', doSearch);
})();
</script>
{% endblock %}
