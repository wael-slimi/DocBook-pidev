{% extends 'dashboard_base.html.twig' %}

{% block title %}Appointments - DOCBOOK{% endblock %}

{% block body %}
<div class="layout-content-container flex flex-col w-full max-w-[1200px] px-6 lg:px-10 mx-auto">
    <h1 class="text-slate-900 dark:text-white text-3xl font-black mb-6">Appointments</h1>
    <p class="text-slate-500 dark:text-slate-400 mb-6">Use the Dashboard for today’s queue, or list all appointments here.</p>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        {% if appointments is defined and appointments is not empty %}
            <ul class="space-y-3">
                {% for appointment in appointments %}
                    <li class="flex items-center justify-between py-2 border-b border-slate-100 dark:border-slate-800 last:border-0">
                        <span class="text-slate-700 dark:text-slate-200">{{ appointment.patient.name ?? 'Patient' }} — {{ appointment.scheduledAt ? appointment.scheduledAt|date('M j, g:i A') : '—' }}</span>
                        <a href="{{ path('app_appointment_show', { id: appointment.id }) }}" class="text-primary text-sm font-bold hover:underline">View</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-slate-500 dark:text-slate-400">No appointments.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
