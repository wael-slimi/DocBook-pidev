{% extends 'dashboard_base.html.twig' %}

{% block title %}Appointment #{{ appointment.id }} - DOCBOOK{% endblock %}

{% block body %}
<div class="layout-content-container flex flex-col w-full max-w-[1200px] px-6 lg:px-10 mx-auto">
    <h1 class="text-slate-900 dark:text-white text-3xl font-black mb-6">Appointment #{{ appointment.id }}</h1>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-3 text-sm">
        <p><span class="font-bold text-slate-500">Patient:</span> {{ appointment.patient.name ?? '—' }}</p>
        <p><span class="font-bold text-slate-500">Scheduled:</span> {{ appointment.scheduledAt ? appointment.scheduledAt|date('M j, Y g:i A') : '—' }}</p>
        <p><span class="font-bold text-slate-500">Status:</span> {{ appointment.status|default('—') }}</p>
        <p><span class="font-bold text-slate-500">Reason:</span> {{ appointment.reason ?? '—' }}</p>
        {% if appointment.teleconsultation %}
            <p><a href="{{ path('app_teleconsultation_room', { id: appointment.teleconsultation.id }) }}" class="text-primary font-bold hover:underline">Start Teleconsultation</a></p>
        {% endif %}
    </div>
    <p class="mt-4"><a href="{{ path('app_dashboard') }}" class="text-primary font-bold hover:underline">← Back to Dashboard</a></p>
</div>
{% endblock %}
