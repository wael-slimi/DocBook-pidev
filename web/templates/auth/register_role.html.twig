{% extends 'base.html.twig' %}

{% block title %}Registration: Select Role - DOCBOOK{% endblock %}

{% block body %}
    {% include 'components/navbar.html.twig' %}
    
    <main class="flex-1 flex items-center justify-center p-6 sm:p-12">
        <div class="layout-content-container flex flex-col w-full max-w-[560px] bg-white dark:bg-slate-900 shadow-xl rounded-xl border border-slate-100 dark:border-slate-800">
            <div class="p-8 pb-0">
                <div class="flex justify-between items-center mb-2">
                    <p class="text-sm font-semibold uppercase">Step 2 of 4</p>
                    <p class="text-primary text-sm font-bold">50% Complete</p>
                </div>
                <div class="rounded-full bg-slate-100 dark:bg-slate-800 h-2.5 overflow-hidden">
                    <div class="h-full rounded-full bg-primary" style="width: 50%;"></div>
                </div>
            </div>

            <div class="p-8 text-center">
                <h1 class="text-3xl font-bold">Choose your path</h1>
                <p class="text-slate-500 mt-2">How do you intend to use the DOCBOOK platform?</p>
            </div>

            <form action="{{ path('app_register_role') }}" method="POST" class="p-8 pt-0 flex flex-col gap-4">
                {# Role: Patient #}
                <label class="flex p-4 cursor-pointer rounded-xl border-2 border-slate-100 hover:border-primary/50 has-[:checked]:border-primary transition-all">
                    <input type="radio" name="selected_role" value="ROLE_PATIENT" class="sr-only" checked>
                    <div class="flex gap-4 items-center">
                        <span class="material-symbols-outlined text-primary text-3xl">person</span>
                        <div class="text-left">
                            <h3 class="font-bold">Patient</h3>
                            <p class="text-sm text-slate-500">Book appointments and track your health.</p>
                        </div>
                    </div>
                </label>

                {# Role: Doctor #}
                <label class="flex p-4 cursor-pointer rounded-xl border-2 border-slate-100 hover:border-primary/50 has-[:checked]:border-primary transition-all">
                    <input type="radio" name="selected_role" value="ROLE_DOCTOR" class="sr-only">
                    <div class="flex gap-4 items-center">
                        <span class="material-symbols-outlined text-primary text-3xl">medical_services</span>
                        <div class="text-left">
                            <h3 class="font-bold">Doctor</h3>
                            <p class="text-sm text-slate-500">Provide care and manage your patients.</p>
                        </div>
                    </div>
                </label>

                {#Role: careGiver #}
                <label class="flex p-4 cursor-pointer rounded-xl border-2 border-slate-100 hover:border-primary/50 has-[:checked]:border-primary transition-all mb-4">
                    <input type="radio" name="selected_role" value="ROLE_CAREGIVER" class="sr-only">
                    <div class="flex gap-4 items-center">
                        <span class="material-symbols-outlined text-primary text-3xl">volunteer_activism</span>
                        <div class="text-left">
                            <h3 class="font-bold">Caregiver</h3>
                            <p class="text-sm text-slate-500">Support patients and manage their treatments.</p>
                        </div>
                    </div>
                </label>

                <div class="mt-6 flex gap-4">
                    <a href="{{ path('app_register') }}" class="flex-1 flex items-center justify-center rounded-lg h-14 border border-slate-200 font-bold">Back</a>
                    <button type="submit" class="flex-[2] bg-primary text-white rounded-lg h-14 font-bold hover:bg-primary/90">Continue</button>
                </div>
            </form>
        </div>
    </main>
{% endblock %}