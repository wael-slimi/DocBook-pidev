{% extends 'dashboard_base.html.twig' %}

{% block title %}
    Teleconsultation Room{% if teleconsultation is defined and teleconsultation.appointment is not null and teleconsultation.appointment.patient is not null %} - {{ teleconsultation.appointment.patient.name }}{% endif %} - DOCBOOK
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
{% set patientName = teleconsultation is defined and teleconsultation.appointment is not null and teleconsultation.appointment.patient is not null ? teleconsultation.appointment.patient.name : null %}
<div class="layout-content-container flex flex-col w-full max-w-[1200px] px-6 lg:px-10 mx-auto">
    <div class="flex flex-wrap justify-between items-end gap-4 mb-6">
        <div class="flex min-w-72 flex-col gap-1">
            <p class="text-slate-900 dark:text-white text-3xl md:text-4xl font-black leading-tight tracking-[-0.033em]">Teleconsultation Room</p>
            <p class="text-slate-500 dark:text-slate-400 text-sm md:text-base font-normal leading-normal">
                {% if patientName %}Secure session with {{ patientName }}.{% else %}Secure real-time teleconsultation with your patient.{% endif %}
            </p>
        </div>
    </div>

    <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 lg:col-span-8">
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm flex flex-col">
                <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">
                            {% if patientName %}{{ patientName|first|upper }}{% else %}<span class="material-symbols-outlined text-lg">person</span>{% endif %}
                        </div>
                        <div class="flex flex-col">
                            <span class="text-slate-900 dark:text-white text-sm font-bold">{% if patientName %}{{ patientName }}{% else %}Teleconsultation Session{% endif %}</span>
                            <span class="text-[11px] text-slate-400 font-bold uppercase tracking-widest">LIVE SESSION</span>
                        </div>
                    </div>
                    {% if teleconsultation is defined and teleconsultation.appointment is not null %}
                        <div class="flex flex-col items-end gap-1 text-right">
                            <p class="text-[11px] text-slate-400 font-bold uppercase tracking-widest">Appointment #{{ teleconsultation.appointment.id }}</p>
                            {% if teleconsultation.appointment.scheduledAt is defined and teleconsultation.appointment.scheduledAt %}
                                <p class="text-xs text-slate-500">{{ teleconsultation.appointment.scheduledAt|date('M j, Y · g:i A') }}</p>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>

                <div class="relative bg-slate-950 flex items-center justify-center overflow-hidden min-h-[400px]">
                    <div class="relative w-full max-w-3xl aspect-video bg-black rounded-xl overflow-hidden shadow-lg">
                        <video id="remoteVideo" class="w-full h-full object-cover" autoplay playsinline data-role="remote-video"></video>
                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none" id="videoPlaceholder">
                            <div class="flex flex-col items-center gap-3 text-slate-300">
                                <span class="material-symbols-outlined text-5xl">video_chat</span>
                                <p class="text-sm font-medium">Waiting for the teleconsultation to start…</p>
                            </div>
                        </div>
                        <div class="absolute bottom-3 right-3 w-32 md:w-40 aspect-video rounded-lg overflow-hidden border border-slate-700 bg-slate-900/80 shadow-lg">
                            <video id="localVideo" class="w-full h-full object-cover" autoplay muted playsinline data-role="local-video"></video>
                        </div>
                    </div>
                </div>

                <div class="px-4 md:px-6 py-3 border-t border-slate-100 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900/80 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span class="text-[11px] font-bold text-slate-500 uppercase tracking-[0.2em]">LIVE TELECONSULTATION</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" class="flex items-center justify-center size-10 rounded-full bg-slate-900 text-slate-100 hover:bg-slate-800 transition-all" data-action="toggle-mic">
                            <span class="material-symbols-outlined text-xl">mic</span>
                        </button>
                        <button type="button" class="flex items-center justify-center size-10 rounded-full bg-slate-900 text-slate-100 hover:bg-slate-800 transition-all" data-action="toggle-camera">
                            <span class="material-symbols-outlined text-xl">videocam</span>
                        </button>
                        <button type="button" class="hidden md:flex items-center justify-center h-10 px-3 rounded-full bg-slate-900 text-slate-100 hover:bg-slate-800 text-xs font-bold gap-1 transition-all" data-action="toggle-screen">
                            <span class="material-symbols-outlined text-base">screen_share</span> Share Screen
                        </button>
                        <button type="button" class="flex items-center justify-center h-10 px-5 rounded-full bg-red-600 text-white hover:bg-red-700 text-xs font-bold gap-1 transition-all shadow-md" data-action="end-call">
                            <span class="material-symbols-outlined text-base">call_end</span> End Call
                        </button>
                    </div>
                </div>
            </div>

            {% if teleconsultation is defined and teleconsultation.videoLink is not empty %}
                <div class="mt-4 flex items-center justify-between gap-3 text-xs text-slate-500">
                    <span class="truncate">External meeting URL: <a href="{{ teleconsultation.videoLink }}" target="_blank" rel="noopener" class="text-primary font-medium underline decoration-dotted">{{ teleconsultation.videoLink }}</a></span>
                    <a href="{{ teleconsultation.videoLink }}" target="_blank" rel="noopener" class="flex items-center gap-1 text-xs font-bold text-primary hover:text-primary/80">
                        <span class="material-symbols-outlined text-sm">open_in_new</span> Open Meeting
                    </a>
                </div>
            {% endif %}
        </div>

        <div class="col-span-12 lg:col-span-4 flex flex-col gap-6">
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col h-80">
                <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                    <h3 class="text-slate-900 dark:text-white text-sm font-bold">Chat</h3>
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-[0.2em]">PRIVATE</span>
                </div>
                <div id="chatMessages" class="flex-1 px-4 py-3 space-y-3 overflow-y-auto text-sm text-slate-800 dark:text-slate-100" data-role="chat-messages"></div>
                <form id="chatForm" class="px-3 pb-3 pt-1 border-t border-slate-100 dark:border-slate-800 flex items-end gap-2" data-role="chat-form" autocomplete="off">
                    <input type="hidden" name="roomId" value="{{ teleconsultation.id ?? '' }}">
                    <div class="flex-1">
                        <label for="chatInput" class="sr-only">Type a message</label>
                        <textarea id="chatInput" name="message" rows="1" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/70 px-3 py-2 text-xs text-slate-900 dark:text-white resize-none focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none" placeholder="Type a message…" data-role="chat-input"></textarea>
                    </div>
                    <button type="submit" class="flex items-center justify-center h-9 w-9 rounded-full bg-primary text-white hover:bg-primary/90 text-sm shadow-md transition-all">
                        <span class="material-symbols-outlined text-base">send</span>
                    </button>
                </form>
            </div>

            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm p-5 space-y-3">
                <h3 class="text-slate-900 dark:text-white text-sm font-bold mb-1">Session Details</h3>
                <dl class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
                    <div class="flex justify-between gap-4"><dt class="font-semibold">Teleconsultation ID</dt><dd class="font-mono">{{ teleconsultation.id ?? '—' }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="font-semibold">Video Link</dt><dd>{% if teleconsultation.videoLink %}<span class="break-all text-[11px]">{{ teleconsultation.videoLink }}</span>{% else %}Not set{% endif %}</dd></div>
                    {% if teleconsultation is defined and teleconsultation.appointment is not null %}
                        <div class="flex justify-between gap-4"><dt class="font-semibold">Appointment</dt><dd class="text-right"><a href="{{ path('app_appointment_show', { id: teleconsultation.appointment.id }) }}" class="text-primary font-semibold hover:text-primary/80">#{{ teleconsultation.appointment.id }}</a></dd></div>
                    {% endif %}
                </dl>
                <div class="pt-2 mt-1 border-t border-dashed border-slate-200 dark:border-slate-700 flex flex-wrap gap-2">
                    <a href="{{ path('app_teleconsultation_index') }}" class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-200"><span class="material-symbols-outlined text-sm">chevron_left</span> Back to teleconsultations</a>
                    {% if teleconsultation is defined and teleconsultation.appointment is not null %}
                        <a href="{{ path('app_appointment_show', { id: teleconsultation.appointment.id }) }}" class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-200"><span class="material-symbols-outlined text-sm">calendar_month</span> View appointment</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/teleconsultation_room.js') }}"></script>
    <script>
        window.teleconsultationConfig = {
            id: {{ teleconsultation.id ?? 'null' }},
            meetingUrl: {{ teleconsultation.videoLink ? ('"' ~ teleconsultation.videoLink|e('js') ~ '"') : 'null' }},
            appointmentId: {{ teleconsultation.appointment is defined and teleconsultation.appointment ? teleconsultation.appointment.id : 'null' }}
        };
    </script>
{% endblock %}
