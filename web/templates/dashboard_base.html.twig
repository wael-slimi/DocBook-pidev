<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>{% block title %}Dashboard - DOCBOOK{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: { "primary": "#0066cc", "background-light": "#f5f7f8", "background-dark": "#0f1923" },
                    fontFamily: { "display": ["Inter"] },
                },
            },
        }
    </script>
    <style>.fill-1 { font-variation-settings: 'FILL' 1; }</style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display min-h-screen">
    <div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
        <header class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-6 py-3 lg:px-40 sticky top-0 z-50">
            <div class="flex items-center gap-8">
                <a href="{{ path('home') }}" class="flex items-center gap-4 text-primary">
                    <div class="size-6">
                        <svg fill="currentColor" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><path d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z"/></svg>
                    </div>
                    <h2 class="text-slate-900 dark:text-white text-lg font-bold tracking-tight">DOCBOOK</h2>
                </a>
                {% block search_bar %}{% endblock %}
            </div>
            <div class="flex flex-1 justify-end gap-8">
                <nav class="hidden lg:flex items-center gap-9">
                    {% block nav_links %}{% endblock %}
                </nav>
                <div class="bg-center bg-cover rounded-full size-10 ring-2 ring-primary/20" style='background-image: url("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&q=80&w=100");'></div>
            </div>
        </header>

        <main class="flex flex-1 justify-center py-8">
            <div class="layout-content-container flex flex-col w-full max-w-[1200px] px-6">
                {% block body %}{% endblock %}
            </div>
        </main>

        <footer class="border-t border-slate-200 dark:border-slate-800 py-8 px-6 lg:px-40 bg-white dark:bg-slate-900">
             <div class="flex justify-between items-center text-xs text-slate-400">
                <span>DOCBOOK © 2026. Encrypted Health Data.</span>
                <div class="flex gap-4">
                    <a href="#">Privacy</a><a href="#">Terms</a>
                </div>
             </div>
        </footer>
    </div>
</body>
</html>