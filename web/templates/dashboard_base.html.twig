<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>{% block title %}Dashboard - DOCBOOK{% endblock %}</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: { 
                        "primary": "#0066cc", 
                        "background-light": "#f5f7f8", 
                        "background-dark": "#0f1923" 
                    },
                    fontFamily: { "display": ["Inter"] },
                },
            },
        }
    </script>
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .fill-1 { font-variation-settings: 'FILL' 1; }
        
        /* Custom scrollbar for a cleaner look */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .dark ::-webkit-scrollbar-thumb { background: #334155; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-background-light dark:bg-background-dark font-display min-h-screen overflow-x-hidden">
    
    <div class="flex min-h-screen">
        
        <aside class="w-72 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col h-screen sticky top-0 z-50 hidden lg:flex">
            
            <div class="p-8 flex items-center gap-3">
                <div class="size-9 bg-primary rounded-xl flex items-center justify-center text-white shadow-lg shadow-primary/30">
                    <svg fill="currentColor" viewbox="0 0 48 48" class="size-6"><path d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z"/></svg>
                </div>
                <h1 class="text-xl font-black tracking-tight text-slate-900 dark:text-white">DOCBOOK</h1>
            </div>

            <nav class="flex-1 px-4 space-y-2">
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] px-4 mb-2">Main Menu</p>
                
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 px-4 py-3 bg-primary/5 text-primary rounded-2xl font-bold transition-all">
                    <span class="material-symbols-outlined">dashboard</span>
                    Dashboard
                </a>

                {% if is_granted('ROLE_DOCTOR') %}
                    <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-2xl font-bold transition-all group">
                        <span class="material-symbols-outlined text-slate-400 group-hover:text-primary">groups</span>
                        Patients
                    </a>
                {% endif %}

                <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-2xl font-bold transition-all group">
                    <span class="material-symbols-outlined text-slate-400 group-hover:text-primary">calendar_month</span>
                    Appointments
                </a>
            </nav>

            <div class="p-6 border-t border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-3 mb-6 px-2">
                    <div class="size-10 rounded-full bg-slate-200 ring-2 ring-primary/20 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&q=80&w=100" alt="Avatar">
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-black text-slate-900 dark:text-white truncate w-32">{{ app.user.name|default('User') }}</span>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Active Plan</span>
                    </div>
                </div>

                <a href="{{ path('app_logout') }}" 
                   class="flex items-center gap-3 px-4 py-3 w-full text-red-500 bg-red-50 hover:bg-red-500 hover:text-white rounded-2xl font-black text-sm transition-all border border-red-100 dark:bg-red-900/10 dark:border-red-900/20">
                    <span class="material-symbols-outlined text-xl">logout</span>
                    Logout
                </a>
            </div>
        </aside>

        <div class="flex-1 flex flex-col min-w-0">
            
            <header class="lg:hidden flex items-center justify-between p-4 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50">
                <div class="flex items-center gap-2 text-primary font-black">
                    <svg fill="currentColor" viewbox="0 0 48 48" class="size-5"><path d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z"/></svg>
                    DOCBOOK
                </div>
                <button class="material-symbols-outlined p-2 bg-slate-100 rounded-lg">menu</button>
            </header>

            <main class="flex-1 p-6 lg:p-12">
                <div class="max-w-6xl mx-auto">
                    
                    {# Flash Messages for Success/Error Notifications #}
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="mb-8 p-4 rounded-2xl border flex items-center gap-3 animate-bounce-in {{ label == 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-red-50 border-red-200 text-red-800' }}">
                                <span class="material-symbols-outlined text-lg">{{ label == 'success' ? 'check_circle' : 'error' }}</span>
                                <span class="text-sm font-bold">{{ message }}</span>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </div>
            </main>

            <footer class="p-8 border-t border-slate-200 dark:border-slate-800 text-center lg:text-left">
                <p class="text-xs text-slate-400 font-medium tracking-tight">
                    &copy; 2026 DOCBOOK Health Systems. All patient data is encrypted under HIPAA standards.
                </p>
            </footer>

        </div>
    </div>

    {% block javascripts %}{% endblock %}
</body>
</html>