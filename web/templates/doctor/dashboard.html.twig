{% extends 'dashboard_base.html.twig' %}

{% block title %}Doctor Dashboard - DOCBOOK{% endblock %}

{% block body %}
<div class="layout-content-container flex flex-col w-full max-w-[1200px] px-6 lg:px-10 mx-auto">
    <div class="flex flex-wrap justify-between items-end gap-4 mb-6">
        <div class="flex min-w-72 flex-col gap-1">
            <p class="text-slate-900 dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]">Clinical Overview</p>
            <p class="text-slate-500 dark:text-slate-400 text-base font-normal leading-normal">Welcome back, Dr. Sarah. You have 12 appointments today.</p>
        </div>
        <div class="flex gap-3">
            <button class="flex h-10 items-center justify-center rounded-lg px-4 bg-slate-200 dark:bg-slate-800 text-slate-900 dark:text-white font-medium text-sm gap-2">
                <span class="material-symbols-outlined text-lg">history</span> Patient History
            </button>
            <button class="flex h-10 items-center justify-center rounded-lg px-4 bg-primary text-white font-medium text-sm gap-2">
                <span class="material-symbols-outlined text-lg">add_box</span> Create Prescription
            </button>
        </div>
    </div>

    <div class="flex flex-wrap gap-4 pb-8">
        <div class="flex min-w-[200px] flex-1 flex-col gap-2 rounded-xl p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-slate-500 text-sm font-bold uppercase tracking-wider">Patients Today</p>
                <span class="material-symbols-outlined text-primary">groups</span>
            </div>
            <p class="text-slate-900 dark:text-white text-3xl font-black">12</p>
        </div>
        <div class="flex min-w-[200px] flex-1 flex-col gap-2 rounded-xl p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-slate-500 text-sm font-bold uppercase tracking-wider">Pending Reports</p>
                <span class="material-symbols-outlined text-amber-500">description</span>
            </div>
            <p class="text-amber-600 text-3xl font-black">5</p>
        </div>
        <div class="flex min-w-[200px] flex-1 flex-col gap-2 rounded-xl p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-slate-500 text-sm font-bold uppercase tracking-wider">Avg. Wait Time</p>
                <span class="material-symbols-outlined text-emerald-500">schedule</span>
            </div>
            <p class="text-emerald-600 text-3xl font-black">14 <span class="text-sm">min</span></p>
        </div>
    </div>

    <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 lg:col-span-8">
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
                <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center">
                    <h3 class="text-slate-900 dark:text-white text-xl font-bold">Upcoming Consultations</h3>
                    <div class="flex gap-2">
                        <span class="flex h-3 w-3 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span class="text-xs font-bold text-slate-400">LIVE QUEUE</span>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 dark:bg-slate-800/50">
                            <tr class="text-slate-500 text-xs font-bold uppercase tracking-wider">
                                <th class="px-6 py-4">Patient</th>
                                <th class="px-6 py-4">Time</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            <tr>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="size-10 rounded-full bg-slate-200" style="background-image: url('https://i.pravatar.cc/150?u=1'); background-size: cover;"></div>
                                        <div>
                                            <p class="text-slate-900 dark:text-white font-bold">John Doe</p>
                                            <p class="text-slate-400 text-xs">Annual Checkup</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-500 text-sm">02:00 PM</td>
                                <td class="px-6 py-4">
                                    <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700">IN WAITING ROOM</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <button class="bg-primary text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-primary/90">START</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="size-10 rounded-full bg-slate-200" style="background-image: url('https://i.pravatar.cc/150?u=2'); background-size: cover;"></div>
                                        <div>
                                            <p class="text-slate-900 dark:text-white font-bold">Sarah Wilson</p>
                                            <p class="text-slate-400 text-xs">Video Call - Results</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-500 text-sm">02:30 PM</td>
                                <td class="px-6 py-4">
                                    <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500">SCHEDULED</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <button class="text-primary font-bold text-sm hover:underline">View File</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-span-12 lg:col-span-4 flex flex-col gap-6">
            <div class="rounded-xl bg-slate-900 text-white p-6 shadow-lg">
                <p class="text-xs font-bold uppercase text-slate-400 mb-1">Today's Performance</p>
                <p class="text-2xl font-black">$1,450.00</p>
                <div class="w-full bg-slate-800 h-1.5 rounded-full mt-4">
                    <div class="bg-primary h-full w-[75%]" style="width: 75%"></div>
                </div>
                <p class="text-[10px] text-slate-500 mt-2 font-bold">75% OF DAILY REVENUE TARGET</p>
            </div>

            <div class="rounded-xl bg-white dark:bg-slate-900 p-6 border border-slate-200 dark:border-slate-800">
                <h3 class="text-slate-900 dark:text-white text-lg font-bold mb-4">Urgent Notifications</h3>
                <div class="flex flex-col gap-4">
                    <div class="p-3 bg-red-50 dark:bg-red-900/10 rounded-lg border-l-4 border-red-500">
                        <p class="text-xs font-bold text-red-700 dark:text-red-400">CRITICAL LAB RESULT</p>
                        <p class="text-slate-900 dark:text-white text-sm font-medium mt-1">Robert Brown: Blood Sugar High</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}