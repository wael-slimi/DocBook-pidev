{% extends 'base.html.twig' %}
{% block title %}{{ document.id ? 'Modifier' : 'Nouveau' }} document - Médecin{% endblock %}
{% block body %}
<div class="page-header">
    <div>
        <h1>{{ document.id ? 'Modifier le document' : 'Nouveau document' }}</h1>
        <p class="text-muted">Ajoutez des rapports, prescriptions ou imageries au dossier.</p>
    </div>
    <div class="page-actions">
        <a href="{{ path('app_medecin_document_index', { dossierId: dossier.id }) }}" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Retour dossier
        </a>
    </div>
</div>

<div class="card" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header">
        <h2><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg> Détails du Document</h2>
    </div>
    <div class="card-body">
        {% if form.vars.errors|length > 0 %}
        <ul class="form-errors">
            {% for error in form.vars.errors %}
            <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
        {% endif %}

        <form method="post" novalidate="novalidate">
            <div class="form-row">
                {{ form_row(form.titre) }}
                {% if form.titre.vars.errors|length > 0 %}
                <ul class="field-error">{% for e in form.titre.vars.errors %}<li>{{ e.message }}</li>{% endfor %}</ul>
                {% endif %}
            </div>

            <div class="form-row">
                {{ form_row(form.typeDocument) }}
                {% if form.typeDocument.vars.errors|length > 0 %}
                <ul class="field-error">{% for e in form.typeDocument.vars.errors %}<li>{{ e.message }}</li>{% endfor %}</ul>
                {% endif %}
            </div>

            <div class="form-row">
                {{ form_row(form.dateDocument) }}
                {% if form.dateDocument.vars.errors|length > 0 %}
                <ul class="field-error">{% for e in form.dateDocument.vars.errors %}<li>{{ e.message }}</li>{% endfor %}</ul>
                {% endif %}
            </div>

            <div class="form-row" style="grid-column: span 2;">
                {{ form_row(form.contenu) }}
                {% if form.contenu.vars.errors|length > 0 %}
                <ul class="field-error">{% for e in form.contenu.vars.errors %}<li>{{ e.message }}</li>{% endfor %}</ul>
                {% endif %}
            </div>

            <div class="form-row" style="grid-column: span 2;">
                {{ form_row(form.fichierPath) }}
                {% if form.fichierPath.vars.errors|length > 0 %}
                <ul class="field-error">{% for e in form.fichierPath.vars.errors %}<li>{{ e.message }}</li>{% endfor %}</ul>
                {% endif %}
            </div>

            {{ form_rest(form) }}
            <div class="actions">
                <button type="submit" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                    Enregistrer le document
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
