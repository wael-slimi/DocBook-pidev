{% extends 'base.html.twig' %}

{% block title %}Patient Dashboard - DOCBOOK{% endblock %}

{% block body %}
<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden bg-background-light dark:bg-background-dark font-display">
    <div class="layout-container flex h-full grow flex-col">
        
        <header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-6 py-3 lg:px-40 sticky top-0 z-50">
            <div class="flex items-center gap-8">
                <div class="flex items-center gap-4 text-primary">
                    <div class="size-6">
                        <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                            <path clip-rule="evenodd" d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z" fill="currentColor" fill-rule="evenodd"></path>
                        </svg>
                    </div>
                    <h2 class="text-slate-900 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]">DOCBOOK</h2>
                </div>
                <label class="hidden md:flex flex-col min-w-40 !h-10 max-w-64">
                    <div class="flex w-full flex-1 items-stretch rounded-lg h-full">
                        <div class="text-slate-500 flex border-none bg-slate-100 dark:bg-slate-800 items-center justify-center pl-4 rounded-l-lg border-r-0">
                            <span class="material-symbols-outlined">search</span>
                        </div>
                        <input class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-slate-900 dark:text-white focus:outline-0 focus:ring-0 border-none bg-slate-100 dark:bg-slate-800 h-full placeholder:text-slate-500 px-4 rounded-l-none pl-2 text-base font-normal" placeholder="Search records, doctors..."/>
                    </div>
                </label>
            </div>
        
            <div class="flex flex-1 justify-end gap-8">
                <div class="hidden lg:flex items-center gap-9">
                    <a class="text-primary text-sm font-semibold" href="{{ path('app_dashboard') }}">Dashboard</a>
                    <a class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors" href="#">Appointments</a>
                    <a class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors" href="#">Records</a>
                    <a class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors flex items-center gap-1" href="#">
                        Notifications
                        <span class="w-2 h-2 bg-red-500 rounded-full"></span>
                    </a>
                </div>
                
                <div class="relative">
                    <button 
                        onclick="toggleDropdown()"
                        class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 border-2 border-primary/20 cursor-pointer focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-all shadow-sm" 
                        style="background-image: url('{{ app.user.profilePicture ? asset('uploads/profiles/' ~ app.user.profilePicture) : 'https://ui-avatars.com/api/?name=' ~ app.user.name|url_encode }}');">
                    </button>
        
                    <div id="profileDropdown" class="hidden absolute right-0 mt-2 w-56 bg-white dark:bg-slate-800 rounded-xl shadow-xl border border-slate-200 dark:border-slate-700 py-2 z-[100]">
                        <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-700">
                            <p class="text-sm font-bold text-slate-900 dark:text-white">{{ app.user.name }}</p>
                            <p class="text-[10px] text-slate-500 truncate uppercase tracking-widest font-bold">Patient Account</p>
                        </div>
                        
                        <a href="{{ path('app_patient_settings') }}" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                            <span class="material-symbols-outlined text-lg">settings</span> Account Settings
                        </a>
                        
                        <hr class="my-1 border-slate-100 dark:border-slate-700">
                        
                        <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 font-bold transition-colors">
                            <span class="material-symbols-outlined text-lg">logout</span> Logout
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex flex-1 justify-center py-8">
            <div class="layout-content-container flex flex-col w-full max-w-[1200px] px-6 lg:px-10">
                
                <div class="flex flex-wrap justify-between items-end gap-4 mb-6">
                    <div class="flex min-w-72 flex-col gap-1">
                        <p class="text-slate-900 dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]">Welcome back, {{ app.user.name|split(' ')[0] }}!</p>
                        <p class="text-slate-500 dark:text-slate-400 text-base font-normal leading-normal">Manage your health and upcoming consultations.</p>
                    </div>
                    <div class="flex gap-3">
                        <button class="flex h-10 items-center justify-center rounded-lg px-4 bg-slate-200 dark:bg-slate-800 text-slate-900 dark:text-white font-medium text-sm gap-2 hover:bg-slate-300 transition-colors">
                            <span class="material-symbols-outlined text-lg">chat</span> Contact Doctor
                        </button>
                        <button class="flex h-10 items-center justify-center rounded-lg px-4 bg-primary text-white font-medium text-sm gap-2 hover:bg-primary/90 transition-shadow shadow-md">
                            <span class="material-symbols-outlined text-lg">calendar_month</span> Book Appointment
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-12 gap-6">
                    <div class="col-span-12 lg:col-span-8 flex flex-col gap-6">
                        
                        <div class="rounded-xl bg-white dark:bg-slate-900 p-6 shadow-sm border border-slate-200 dark:border-slate-800">
                            <div class="flex flex-col md:flex-row items-stretch justify-between gap-6">
                                <div class="flex flex-[2_2_0px] flex-col gap-4">
                                    <div class="flex flex-col gap-1">
                                        <p class="text-primary text-xs font-bold uppercase tracking-wider">Next Appointment</p>
                                        <p class="text-slate-900 dark:text-white text-2xl font-bold leading-tight">Dr. Sarah Smith</p>
                                        <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
                                            <span class="material-symbols-outlined text-base">medical_services</span>
                                            <p class="text-sm">Cardiology Specialist</p>
                                        </div>
                                        <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
                                            <span class="material-symbols-outlined text-base">schedule</span>
                                            <p class="text-sm">Today at 2:00 PM (EDT)</p>
                                        </div>
                                    </div>
                                    <button class="flex min-w-[160px] items-center justify-center rounded-lg h-11 px-6 bg-primary text-white gap-2 text-base font-bold transition-all hover:bg-primary/90 shadow-lg shadow-primary/20">
                                        <span class="material-symbols-outlined">videocam</span> Join Video Call
                                    </button>
                                </div>
                                <div class="w-full md:w-64 h-40 md:h-auto bg-slate-100 dark:bg-slate-800 rounded-lg flex items-center justify-center bg-center bg-no-repeat bg-cover" style="background-image: url('https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=300&q=80');">
                                    <div class="bg-black/20 inset-0 w-full h-full rounded-lg flex items-center justify-center backdrop-blur-[2px]">
                                         <span class="material-symbols-outlined text-white text-5xl">play_circle</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col">
                            <h2 class="text-slate-900 dark:text-white text-[22px] font-bold leading-tight tracking-[-0.015em] pb-4">Health Metrics Overview</h2>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="flex flex-col gap-2 rounded-xl p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
                                    <div class="flex justify-between items-start">
                                        <p class="text-slate-500 dark:text-slate-400 text-sm font-medium">Heart Rate</p>
                                        <span class="material-symbols-outlined text-red-500">favorite</span>
                                    </div>
                                    <p class="text-slate-900 dark:text-white text-2xl font-bold">72 <span class="text-sm font-normal text-slate-500">BPM</span></p>
                                    <p class="text-emerald-600 dark:text-emerald-400 text-sm font-medium flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs font-black">trending_up</span> +2% vs last week
                                    </p>
                                </div>
                                <div class="flex flex-col gap-2 rounded-xl p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
                                    <div class="flex justify-between items-start">
                                        <p class="text-slate-500 dark:text-slate-400 text-sm font-medium">Blood Pressure</p>
                                        <span class="material-symbols-outlined text-primary">blood_pressure</span>
                                    </div>
                                    <p class="text-slate-900 dark:text-white text-2xl font-bold">120/80 <span class="text-sm font-normal text-slate-500">mmHg</span></p>
                                    <p class="text-slate-500 dark:text-slate-400 text-sm font-medium flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs font-black">horizontal_rule</span> Stable
                                    </p>
                                </div>
                                <div class="flex flex-col gap-2 rounded-xl p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
                                    <div class="flex justify-between items-start">
                                        <p class="text-slate-500 dark:text-slate-400 text-sm font-medium">Glucose</p>
                                        <span class="material-symbols-outlined text-amber-500">opacity</span>
                                    </div>
                                    <p class="text-slate-900 dark:text-white text-2xl font-bold">95 <span class="text-sm font-normal text-slate-500">mg/dL</span></p>
                                    <p class="text-red-500 text-sm font-medium flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs font-black">trending_down</span> -3% vs last week
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col">
                            <div class="flex items-center justify-between pb-4">
                                <h2 class="text-slate-900 dark:text-white text-[22px] font-bold leading-tight">Recent Medical Records</h2>
                                <a class="text-primary text-sm font-semibold hover:underline" href="#">View All</a>
                            </div>
                            <div class="flex flex-col gap-4">
                                <div class="flex items-center gap-4 p-4 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm hover:border-primary/30 transition-colors group">
                                    <div class="size-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all">
                                        <span class="material-symbols-outlined">description</span>
                                    </div>
                                    <div class="flex flex-1 flex-col">
                                        <p class="text-slate-900 dark:text-white text-base font-bold">Blood Test Results</p>
                                        <p class="text-slate-500 dark:text-slate-400 text-sm">Central Lab • Oct 24, 2023</p>
                                    </div>
                                    <button class="p-2 text-slate-400 hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined">download</span>
                                    </button>
                                </div>
                                </div>
                        </div>
                    </div>

                    <div class="col-span-12 lg:col-span-4 flex flex-col gap-6">
                        
                        <div class="rounded-xl bg-primary text-white p-6 shadow-lg shadow-primary/20 relative overflow-hidden group">
                            <div class="relative z-10">
                                <h3 class="text-lg font-bold mb-4">Quick Health Tips</h3>
                                <p class="text-white/80 text-sm mb-4 leading-relaxed">Remember to stay hydrated! Drinking at least 8 glasses of water daily helps maintain BP and improves metabolism.</p>
                                <div class="bg-white/10 rounded-lg p-3 flex items-center gap-3">
                                    <span class="material-symbols-outlined text-white">info</span>
                                    <p class="text-xs font-medium">Your next check-up is in 14 days.</p>
                                </div>
                            </div>
                            <span class="material-symbols-outlined absolute -right-4 -bottom-4 text-white/10 text-9xl rotate-12 group-hover:rotate-0 transition-transform duration-500">water_drop</span>
                        </div>

                        <div class="rounded-xl bg-white dark:bg-slate-900 p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                            <h3 class="text-slate-900 dark:text-white text-lg font-bold mb-4">My Care Team</h3>
                            <div class="flex flex-col gap-4">
                                <div class="flex items-center gap-3">
                                    <div class="size-10 rounded-full bg-slate-100 dark:bg-slate-800 bg-center bg-cover" style="background-image: url('https://i.pravatar.cc/150?u=sarah')"></div>
                                    <div class="flex flex-col">
                                        <p class="text-sm font-bold text-slate-900 dark:text-white">Dr. Sarah Smith</p>
                                        <p class="text-xs text-slate-500 uppercase font-bold tracking-tighter">Cardiologist</p>
                                    </div>
                                    <button class="ml-auto text-primary hover:bg-primary/10 p-1.5 rounded-full transition-colors">
                                        <span class="material-symbols-outlined text-lg">mail</span>
                                    </button>
                                </div>
                                <div class="flex items-center gap-3 border-t border-slate-100 dark:border-slate-800 pt-4 cursor-pointer hover:text-primary transition-colors group">
                                    <div class="size-10 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all">
                                        <span class="material-symbols-outlined">add</span>
                                    </div>
                                    <p class="text-sm font-bold">Add Provider</p>
                                </div>
                            </div>
                        </div>

                        <div class="rounded-xl bg-slate-100 dark:bg-slate-800 p-6 border border-transparent dark:border-slate-700/50">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest">Insurance Status</p>
                                <span class="text-emerald-500 text-[10px] font-black flex items-center gap-1 border border-emerald-500/20 px-2 py-0.5 rounded-full">
                                    <span class="material-symbols-outlined text-[10px] font-black">check_circle</span> ACTIVE
                                </span>
                            </div>
                            <p class="text-slate-900 dark:text-white font-black text-lg">BlueShield Health Plus</p>
                            <p class="text-slate-500 dark:text-slate-400 text-xs font-medium">ID: #990-2342-X1</p>
                            <div class="mt-6 flex justify-between items-end">
                                <span class="text-[10px] uppercase font-bold text-slate-400">Deductible met</span>
                                <span class="text-xs font-black text-slate-900 dark:text-white">$1,200 / $2,000</span>
                            </div>
                            <div class="w-full bg-slate-200 dark:bg-slate-700 h-2 rounded-full mt-2 overflow-hidden">
                                <div class="bg-primary h-full rounded-full transition-all duration-1000" style="width: 60%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        
        <footer class="border-t border-slate-200 dark:border-slate-800 py-8 px-6 lg:px-40 bg-white dark:bg-slate-900 mt-auto">
            <div class="max-w-[1200px] mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="flex items-center gap-2 text-slate-400">
                    <div class="size-5">
                        <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                            <path clip-rule="evenodd" d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z" fill="currentColor" fill-rule="evenodd"></path>
                        </svg>
                    </div>
                    <span class="text-xs font-bold tracking-tight uppercase">DOCBOOK © 2026. SECURE HEALTH PORTAL.</span>
                </div>
                <div class="flex gap-8">
                    <a class="text-xs font-bold text-slate-500 hover:text-primary transition-colors" href="#">PRIVACY</a>
                    <a class="text-xs font-bold text-slate-500 hover:text-primary transition-colors" href="#">TERMS</a>
                    <a class="text-xs font-bold text-slate-500 hover:text-primary transition-colors" href="#">SUPPORT</a>
                </div>
            </div>
        </footer>
    </div>
</div>

<script>
    function toggleDropdown() {
        const dropdown = document.getElementById('profileDropdown');
        dropdown.classList.toggle('hidden');
    }

    // Close dropdown if clicked outside
    window.addEventListener('click', function(e) {
        const dropdown = document.getElementById('profileDropdown');
        const button = dropdown.previousElementSibling;
        if (!button.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.add('hidden');
        }
    });
</script>
{% endblock %}