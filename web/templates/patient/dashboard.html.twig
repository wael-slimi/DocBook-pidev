{% extends 'dashboard_base.html.twig' %}

{% block title %}Patient Dashboard - DOCBOOK{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-8">
    <div class="flex flex-col gap-1">
        <h1 class="text-4xl font-black text-slate-900 dark:text-white">Welcome back, {{ app.user.name }}</h1>
        <p class="text-slate-500">Manage your appointments, medical records, and healthcare needs.</p>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="{{ path('app_appointment_index') }}" class="bg-white dark:bg-slate-900 rounded-3xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all group">
            <div class="flex items-center justify-between mb-4">
                <div class="size-12 bg-blue-50 dark:bg-blue-900/20 text-blue-600 rounded-2xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">calendar_month</span>
                </div>
                <span class="material-symbols-outlined text-slate-400 group-hover:text-blue-600 transition-colors">arrow_forward</span>
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">My Appointments</h3>
            <p class="text-slate-500 text-sm">View and manage your scheduled appointments</p>
        </a>

        <a href="{{ path('app_teleconsultation_index') }}" class="bg-white dark:bg-slate-900 rounded-3xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all group">
            <div class="flex items-center justify-between mb-4">
                <div class="size-12 bg-green-50 dark:bg-green-900/20 text-green-600 rounded-2xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">videocam</span>
                </div>
                <span class="material-symbols-outlined text-slate-400 group-hover:text-green-600 transition-colors">arrow_forward</span>
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">Teleconsultations</h3>
            <p class="text-slate-500 text-sm">Join your video consultation sessions</p>
        </a>

        <a href="{{ path('app_doctor_search') }}" class="bg-white dark:bg-slate-900 rounded-3xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all group">
            <div class="flex items-center justify-between mb-4">
                <div class="size-12 bg-purple-50 dark:bg-purple-900/20 text-purple-600 rounded-2xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">search</span>
                </div>
                <span class="material-symbols-outlined text-slate-400 group-hover:text-purple-600 transition-colors">arrow_forward</span>
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">Find Doctors</h3>
            <p class="text-slate-500 text-sm">Search and book appointments with specialists</p>
        </a>
    </div>

    <!-- Recent Activity -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-800">
            <h3 class="text-xl font-black text-slate-900 dark:text-white">Recent Activity</h3>
        </div>
        <div class="p-6">
            <div class="space-y-4">
                <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl">
                    <div class="size-10 bg-blue-50 dark:bg-blue-900/20 text-blue-600 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined">calendar_month</span>
                    </div>
                    <div class="flex-1">
                        <p class="font-bold text-slate-900 dark:text-white">Appointment Reminder</p>
                        <p class="text-sm text-slate-500">You have an appointment tomorrow at 2:00 PM</p>
                    </div>
                    <span class="text-xs text-slate-400">2h ago</span>
                </div>

                <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl">
                    <div class="size-10 bg-green-50 dark:bg-green-900/20 text-green-600 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined">description</span>
                    </div>
                    <div class="flex-1">
                        <p class="font-bold text-slate-900 dark:text-white">Medical Report Added</p>
                        <p class="text-sm text-slate-500">Your latest lab results have been added to your records</p>
                    </div>
                    <span class="text-xs text-slate-400">1d ago</span>
                </div>

                <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl">
                    <div class="size-10 bg-purple-50 dark:bg-purple-900/20 text-purple-600 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined">local_shipping</span>
                    </div>
                    <div class="flex-1">
                        <p class="font-bold text-slate-900 dark:text-white">Prescription Ready</p>
                        <p class="text-sm text-slate-500">Your prescription is ready for pickup at the pharmacy</p>
                    </div>
                    <span class="text-xs text-slate-400">3d ago</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}