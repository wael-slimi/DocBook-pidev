{% for document in documents %}
<tr>
    <td>{{ document.titre }}</td>
    <td><span class="badge badge-info">{{ document.typeDocument }}</span></td>
    <td>{{ document.dateDocument ? document.dateDocument|date('d/m/Y') : '—' }}</td>
    <td class="actions-cell">
        <span class="btn-group">
            <a href="{{ path('app_patient_document_show', { dossierId: dossier.id, id: document.id }) }}" class="btn btn-sm btn-secondary">Voir</a>
            <a href="{{ path('app_patient_document_edit', { dossierId: dossier.id, id: document.id }) }}" class="btn btn-sm btn-primary">Modifier</a>
            <form method="post" action="{{ path('app_patient_document_delete', { dossierId: dossier.id, id: document.id }) }}" style="display:inline;" onsubmit="return confirm('Supprimer ce document ?');">
                <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
            </form>
        </span>
    </td>
</tr>
{% else %}
<tr><td colspan="4" style="padding: 2rem; text-align: center; color: var(--text-muted);">Aucun document.</td></tr>
{% endfor %}
