{% extends 'base.html.twig' %}

{% block title %}Documents - {{ dossier.numeroDossier }} - Patient{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>Documents – {{ dossier.patientNom }} {{ dossier.patientPrenom }}</h1>
        <p style="margin: 0.25rem 0 0 0; font-size: 0.9rem; color: var(--text-muted);">Dossier {{ dossier.numeroDossier }}</p>
    </div>
    <div class="page-actions">
        <a href="{{ path('app_patient_dossier_show', { id: dossier.id }) }}" class="btn btn-secondary">Retour dossier</a>
        <a href="{{ path('app_patient_document_new', { dossierId: dossier.id }) }}" class="btn btn-primary">Nouveau document</a>
    </div>
</div>

<div class="layout-table-filters">
    <div class="card table-card">
        <div class="card-header">
            <h2>Mes documents</h2>
            <div class="list-count">
                <span class="badge badge-indigo" id="list-total">{{ total }}</span> document(s)
            </div>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="data-table-wrap" style="border: none; border-radius: 0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Type</th>
                            <th>Date doc.</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="document-tbody">
                        {% include 'patient/document/_list_rows.html.twig' %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card filters-card">
        <div class="card-header">
            <h2>Filtres – Recherche et Tri</h2>
        </div>
        <div class="card-body">
            <div class="filters-vertical" id="filters-documents">
                <div class="filter-group" style="margin-bottom: 1.25rem;">
                    <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Recherche</label>
                    <input type="text" id="q" value="{{ q|default('') }}" placeholder="Titre, contenu" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm);">
                </div>
                <div class="filter-group" style="margin-bottom: 1.25rem;">
                    <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Tri</label>
                    <select id="tri" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm);">
                        <option value="dateDocument" {{ tri == 'dateDocument' ? 'selected' : '' }}>Date document</option>
                        <option value="dateCreation" {{ tri == 'dateCreation' ? 'selected' : '' }}>Date création</option>
                        <option value="titre" {{ tri == 'titre' ? 'selected' : '' }}>Titre</option>
                        <option value="typeDocument" {{ tri == 'typeDocument' ? 'selected' : '' }}>Type</option>
                    </select>
                </div>
                <div class="filter-group" style="margin-bottom: 1.25rem;">
                    <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Ordre</label>
                    <select id="ordre" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm);">
                        <option value="DESC" {{ ordre == 'DESC' ? 'selected' : '' }}>Décroissant</option>
                        <option value="ASC" {{ ordre == 'ASC' ? 'selected' : '' }}>Croissant</option>
                    </select>
                </div>
                <div class="filter-group" style="margin-bottom: 1.25rem;">
                    <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Type</label>
                    <select id="type" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm);">
                        <option value="">Tous</option>
                        {% for t in ['ordonnance','rapport','examen','compte_rendu','autre'] %}
                        <option value="{{ t }}" {{ type == t ? 'selected' : '' }}>{{ t }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem;">
                    <div class="filter-group">
                        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Du</label>
                        <input type="date" id="date_debut" value="{{ date_debut|default('') }}" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.85rem;">
                    </div>
                    <div class="filter-group">
                        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Au</label>
                        <input type="date" id="date_fin" value="{{ date_fin|default('') }}" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.85rem;">
                    </div>
                </div>
                <div class="text-muted" style="font-size: 0.8rem; text-align: center; font-style: italic;">Actualisation automatique</div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
(function() {
    const baseUrl = '{{ path('app_patient_document_index', { dossierId: dossier.id }) }}';
    const tbody = document.getElementById('document-tbody');
    const totalEl = document.getElementById('list-total');
    function params() {
        const p = new URLSearchParams();
        p.set('ajax', '1');
        const q = document.getElementById('q');
        if (q.value) p.set('q', q.value);
        p.set('tri', document.getElementById('tri').value);
        p.set('ordre', document.getElementById('ordre').value);
        const type = document.getElementById('type');
        if (type.value) p.set('type', type.value);
        const d1 = document.getElementById('date_debut');
        if (d1.value) p.set('date_debut', d1.value);
        const d2 = document.getElementById('date_fin');
        if (d2.value) p.set('date_fin', d2.value);
        return p.toString();
    }
    function doSearch() {
        fetch(baseUrl + '?' + params(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { const t = r.headers.get('X-Total-Count'); if (t !== null && totalEl) totalEl.textContent = t; return r.text(); })
            .then(html => tbody.innerHTML = html);
    }
    let debounceTimer;
    function doSearchDebounced() { clearTimeout(debounceTimer); debounceTimer = setTimeout(doSearch, 300); }
    document.getElementById('q').addEventListener('input', doSearchDebounced);
    document.getElementById('tri').addEventListener('change', doSearch);
    document.getElementById('ordre').addEventListener('change', doSearch);
    document.getElementById('type').addEventListener('change', doSearch);
    document.getElementById('date_debut').addEventListener('change', doSearch);
    document.getElementById('date_fin').addEventListener('change', doSearch);
})();
</script>
{% endblock %}
