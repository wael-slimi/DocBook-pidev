{% extends 'base.html.twig' %}

{% block title %}Mes dossiers - Patient{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>Mes dossiers</h1>
        <p class="text-muted">Consultez et suivez l'historique de vos dossiers médicaux.</p>
    </div>
    <div class="page-actions">
        <a href="{{ path('app_patient_dossier_new') }}" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Nouveau dossier
        </a>
    </div>
</div>

<div class="dashboard-grid layout-table-filters">
    <div class="card table-card">
        <div class="card-header">
            <h2>Mes dossiers médicaux</h2>
            <div class="list-count">
                <span class="badge badge-indigo" id="list-total">{{ total }}</span> dossier(s)
            </div>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="data-table-wrap" style="border: none; border-radius: 0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>N° dossier</th>
                            <th>Patient</th>
                            <th>Date création</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="dossier-tbody">
                        {% include 'patient/dossier_medical/_list_rows.html.twig' %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card filters-card">
        <div class="card-header">
            <h2>Filtres – Recherche et Tri</h2>
        </div>
        <div class="card-body">
            <div class="filters-vertical" id="filters-dossiers">
                <div class="filter-group" style="margin-bottom: 1.25rem;">
                    <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Mots-clés</label>
                    <input type="text" id="q" name="q" value="{{ q|default('') }}" placeholder="Numéro, nom..." style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm);">
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                    <div class="filter-group">
                        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Tri</label>
                        <select id="tri" name="tri" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm);">
                            <option value="dateCreation" {{ tri == 'dateCreation' ? 'selected' : '' }}>Création</option>
                            <option value="dateModification" {{ tri == 'dateModification' ? 'selected' : '' }}>Modification</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Ordre</label>
                        <select id="ordre" name="ordre" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm);">
                            <option value="DESC" {{ ordre == 'DESC' ? 'selected' : '' }}>Récent</option>
                            <option value="ASC" {{ ordre == 'ASC' ? 'selected' : '' }}>Ancien</option>
                        </select>
                    </div>
                </div>

                <div class="filter-group" style="margin-bottom: 2rem;">
                    <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Période</label>
                    <div style="display: flex; gap: 0.5rem;">
                        <input type="date" id="date_debut" name="date_debut" value="{{ date_debut|default('') }}" style="flex: 1; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.8rem;">
                        <input type="date" id="date_fin" name="date_fin" value="{{ date_fin|default('') }}" style="flex: 1; padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.8rem;">
                    </div>
                </div>

                <div class="text-muted" style="font-size: 0.8rem; text-align: center; font-style: italic;">
                    Actualisation automatique
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function() {
    const baseUrl = '{{ path('app_patient_dossier_index') }}';
    const tbody = document.getElementById('dossier-tbody');
    const totalEl = document.getElementById('list-total');
    const q = document.getElementById('q');
    const tri = document.getElementById('tri');
    const ordre = document.getElementById('ordre');
    const dateDebut = document.getElementById('date_debut');
    const dateFin = document.getElementById('date_fin');

    function doSearch() {
        tbody.style.opacity = '0.5';
        const params = new URLSearchParams();
        params.set('ajax', '1');
        if (q.value) params.set('q', q.value);
        params.set('tri', tri.value);
        params.set('ordre', ordre.value);
        if (dateDebut.value) params.set('date_debut', dateDebut.value);
        if (dateFin.value) params.set('date_fin', dateFin.value);
        
        fetch(baseUrl + '?' + params.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { 
                const t = r.headers.get('X-Total-Count'); 
                if (t !== null && totalEl) totalEl.textContent = t; 
                return r.text(); 
            })
            .then(html => { 
                tbody.innerHTML = html; 
                tbody.style.opacity = '1';
            });
    }

    let debounceTimer;
    function doSearchDebounced() { 
        clearTimeout(debounceTimer); 
        debounceTimer = setTimeout(doSearch, 250); 
    }

    q.addEventListener('input', doSearchDebounced);
    tri.addEventListener('change', doSearch);
    ordre.addEventListener('change', doSearch);
    dateDebut.addEventListener('change', doSearch);
    dateFin.addEventListener('change', doSearch);
})();
</script>
{% endblock %}
