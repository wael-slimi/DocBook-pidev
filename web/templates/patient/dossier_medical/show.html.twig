{% extends 'base.html.twig' %}
{% block title %}Dossier {{ dossier.numeroDossier }} - Patient{% endblock %}
{% block body %}
<div class="page-header">
    <h1>Mon dossier {{ dossier.numeroDossier }}</h1>
    <div class="page-actions">
        <a href="{{ path('app_patient_dossier_index') }}" class="btn btn-secondary">Retour liste</a>
        <a href="{{ path('app_patient_dossier_edit', { id: dossier.id }) }}" class="btn btn-primary">Modifier</a>
        <a href="{{ path('app_patient_document_index', { dossierId: dossier.id }) }}" class="btn btn-primary">Documents ({{ dossier.documents|length }})</a>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <table class="detail-table">
            <tr><th>N° dossier</th><td>{{ dossier.numeroDossier }}</td></tr>
            <tr><th>Nom</th><td>{{ dossier.patientNom }}</td></tr>
            <tr><th>Prénom</th><td>{{ dossier.patientPrenom }}</td></tr>
            <tr><th>Date naissance</th><td>{{ dossier.dateNaissance ? dossier.dateNaissance|date('d/m/Y') : '—' }}</td></tr>
            <tr><th>Genre</th><td>{{ dossier.genre }}</td></tr>
            <tr><th>Email</th><td>{{ dossier.email ?: '—' }}</td></tr>
            <tr><th>Téléphone</th><td>{{ dossier.telephone ?: '—' }}</td></tr>
            <tr><th>Adresse</th><td>{{ dossier.adresse ? dossier.adresse|nl2br : '—' }}</td></tr>
            <tr><th>Remarques</th><td>{{ dossier.remarques ? dossier.remarques|nl2br : '—' }}</td></tr>
            <tr><th>Créé le</th><td>{{ dossier.dateCreation ? dossier.dateCreation|date('d/m/Y H:i') : '—' }}</td></tr>
        </table>
    </div>
</div>
{% endblock %}
