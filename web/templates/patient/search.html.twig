{% extends 'base.html.twig' %}

{% block title %}Search Doctors - DOCBOOK{% endblock %}

{% block body %}
<div class="flex flex-col w-full bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 min-h-screen">
    
    <header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-10 py-3 sticky top-0 z-50">
        <div class="flex items-center gap-8">
            <div class="flex items-center gap-4 text-primary">
                <div class="size-6">
                    <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                        <path clip-rule="evenodd" d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z" fill="currentColor" fill-rule="evenodd"></path>
                    </svg>
                </div>
                <h2 class="text-slate-900 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]">DOCBOOK</h2>
            </div>
            
            <form action="{{ path('app_doctor_search') }}" method="GET" class="flex flex-col min-w-40 !h-10 max-w-64">
                <div class="flex w-full flex-1 items-stretch rounded-lg h-full">
                    <div class="text-slate-500 flex border-none bg-slate-100 dark:bg-slate-800 items-center justify-center pl-4 rounded-l-lg border-r-0">
                        <span class="material-symbols-outlined">search</span>
                    </div>
                    <input 
                        name="q" 
                        value="{{ searchTerm }}" 
                        class="form-input flex w-full min-w-0 flex-1 rounded-lg text-slate-900 dark:text-white focus:outline-0 focus:ring-0 border-none bg-slate-100 dark:bg-slate-800 h-full placeholder:text-slate-500 px-4 rounded-l-none pl-2 text-base font-normal" 
                        placeholder="Search doctors..."
                    />
                </div>
            </form>
        </div>
        
        <div class="flex flex-1 justify-end gap-8">
            <div class="flex items-center gap-9">
                <a class="text-primary text-sm font-semibold" href="{{ path('app_dashboard') }}">Dashboard</a>
                <a class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors" href="#">My Appointments</a>
            </div>
            <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 border-2 border-primary/20" 
                 style="background-image: url('{{ app.user.profilePicture ? asset('uploads/profiles/' ~ app.user.profilePicture) : 'https://ui-avatars.com/api/?name=' ~ app.user.name|url_encode }}');">
            </div>
        </div>
    </header>

    <main class="max-w-[1280px] mx-auto w-full px-6 py-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-8">
            <div class="flex flex-col gap-1">
                <h1 class="text-slate-900 dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]">Find your doctor</h1>
                <p class="text-slate-500 dark:text-slate-400 text-base font-normal leading-normal">Book an appointment with top-rated specialists.</p>
            </div>
        </div>

        <div class="grid grid-cols-12 gap-8">
            <aside class="col-span-12 lg:col-span-3">
                <div class="bg-white dark:bg-slate-900 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-800">
                    <h3 class="text-slate-900 dark:text-white text-lg font-bold mb-4">Filters</h3>

                    <form action="{{ path('app_doctor_search') }}" method="GET" class="flex flex-col gap-6">
                        <input type="hidden" name="q" value="{{ searchTerm }}">

                        <div class="flex flex-col gap-3">
                            <label class="text-sm font-semibold text-slate-900 dark:text-white">Specialty</label>
                            <select name="specialty" onchange="this.form.submit()" class="form-select rounded-lg border-slate-200 dark:bg-slate-800 text-sm">
                                <option value="All">All Specialties</option>
                                {% for spec in specialties %}
                                    <option value="{{ spec.value }}" {{ selectedSpecialty == spec.value ? 'selected' }}>
                                        {{ spec.value|capitalize }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="flex flex-col gap-3">
                            <label class="text-sm font-semibold text-slate-900 dark:text-white">Price Range ($)</label>
                            <div class="flex gap-2">
                                <input type="number" name="minPrice" value="{{ minPrice }}" placeholder="Min" class="form-input w-full rounded-lg border-slate-200 dark:bg-slate-800 text-sm">
                                <input type="number" name="maxPrice" value="{{ maxPrice }}" placeholder="Max" class="form-input w-full rounded-lg border-slate-200 dark:bg-slate-800 text-sm">
                            </div>
                            <button type="submit" class="bg-primary text-white py-2 rounded-lg font-bold text-sm">Apply Filters</button>
                        </div>
                    </form>
                </div>
            </aside>

            <div class="col-span-12 lg:col-span-9 flex flex-col gap-6">
                {% for doctor in doctors %}
                    <div class="bg-white dark:bg-slate-900 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-800 flex flex-col md:flex-row gap-6">
                        <div class="w-full md:w-32 h-32 rounded-xl bg-center bg-cover flex-shrink-0" 
                             style="background-image: url('{{ doctor.profilePicture ? asset('uploads/profiles/' ~ doctor.profilePicture) : 'https://ui-avatars.com/api/?name=' ~ doctor.name|url_encode }}');">
                        </div>
                        <div class="flex-1">
                            <div class="flex flex-col md:flex-row justify-between mb-4">
                                <div>
                                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Dr. {{ doctor.name }}</h2>
                                    <p class="text-primary font-semibold">{{ doctor.specialty.value|default('Specialist') }}</p>
                                    <div class="flex items-center gap-1 mt-1">
                                        <span class="material-symbols-outlined text-yellow-500 fill text-sm">star</span>
                                        <span class="text-sm text-slate-500 dark:text-slate-400 ml-1">({{ doctor.totalReviews }} reviews)</span>
                                    </div>
                                </div>
                                <div class="mt-4 md:mt-0 text-left md:text-right">
                                    <span class="text-slate-500 text-xs uppercase tracking-wider font-bold block mb-1">Fee</span>
                                    <span class="text-2xl font-black text-slate-900 dark:text-white">${{ doctor.consultationFee|default('0.00') }}</span>
                                </div>
                            </div>
                            <p class="text-slate-600 dark:text-slate-400 text-sm mb-6 line-clamp-2">
                                {{ doctor.bio ?: 'No professional bio provided yet.' }}
                            </p>
                        </div>
                        <div class="flex flex-col justify-end">
                            <button class="w-full md:w-auto bg-primary text-white px-8 py-3 rounded-lg font-bold hover:bg-primary/90 transition-all shadow-md">Book Appointment</button>
                        </div>
                    </div>
                {% else %}
                    <div class="py-20 text-center bg-white dark:bg-slate-900 rounded-xl border-2 border-dashed border-slate-200 dark:border-slate-800">
                        <span class="material-symbols-outlined text-slate-300 text-5xl">person_search</span>
                        <p class="text-slate-500 dark:text-slate-400 mt-4 font-medium">No doctors found matching your search "{{ searchTerm }}".</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </main>
</div>
{% endblock %}