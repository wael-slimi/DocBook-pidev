{% extends 'base.html.twig' %}

{% block title %}Email Sent - DOCBOOK{% endblock %}

{% block body %}
    {% include 'components/navbar.html.twig' %}

    <main class="flex flex-1 items-center justify-center py-10 px-4">
        <div class="max-w-[480px] w-full bg-white dark:bg-slate-900 rounded-xl shadow-sm p-8 text-center border border-slate-100 dark:border-slate-800">
            <div class="w-20 h-20 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-green-600 dark:text-green-400" style="font-size: 48px;">mark_email_read</span>
            </div>
            
            <h1 class="text-slate-900 dark:text-slate-100 text-2xl font-bold mb-4">Check your email</h1>
            
            <p class="text-slate-600 dark:text-slate-400 mb-6">
                An email has been sent that contains a link you can use to reset your password. 
                This link will expire soon.
            </p>

            <a href="{{ path('app_login') }}" class="text-primary font-bold hover:underline">
                Back to Login
            </a>
        </div>
    </main>
{% endblock %}