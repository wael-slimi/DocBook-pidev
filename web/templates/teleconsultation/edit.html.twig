{% extends "dashboard_base.html.twig" %}

{% block title %}Edit Teleconsultation{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>Edit Teleconsultation #{{ teleconsultation.id }}</h1>
            <hr />

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="form-group mb-3">
                    {{ form_label(form.appointment, 'Select Appointment') }}
                    {{ form_widget(form.appointment, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.appointment) }}
                    <small class="form-text text-muted">Choose the appointment to link with this teleconsultation.</small>
                </div>

                <div class="form-group mb-3">
                    {{ form_label(form.duration, 'Duration (minutes)') }}
                    {{ form_widget(form.duration, {'attr': {'class': 'form-control', 'type': 'number', 'min': '1', 'placeholder': 'e.g., 30'}}) }}
                    {{ form_errors(form.duration) }}
                </div>

                <div class="form-group mb-3">
                    {{ form_label(form.meetingUrl, 'Meeting URL') }}
                    {{ form_widget(form.meetingUrl, {'attr': {'class': 'form-control', 'type': 'url', 'placeholder': 'https://example.com/meeting'}}) }}
                    {{ form_errors(form.meetingUrl) }}
                </div>

                <div class="form-group mb-3">
                    {{ form_label(form.mode, 'Consultation Mode') }}
                    {{ form_widget(form.mode, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.mode) }}
                </div>

                <div class="d-flex justify-content-between">
                    <button class="btn btn-primary" type="submit">Update Teleconsultation</button>
                    <a href="{{ path('app_teleconsultation_show', {'id': teleconsultation.id}) }}" class="btn btn-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
