{% extends 'dashboard_base.html.twig' %}

{% block title %}Teleconsultations - DOCBOOK{% endblock %}

{% block body %}
<div class="layout-content-container flex flex-col w-full max-w-[1200px] px-6 lg:px-10 mx-auto">
    <div class="flex flex-wrap justify-between items-end gap-4 mb-6">
        <div class="flex min-w-72 flex-col gap-1">
            <p class="text-slate-900 dark:text-white text-3xl md:text-4xl font-black leading-tight tracking-[-0.033em]">Teleconsultations</p>
            <p class="text-slate-500 dark:text-slate-400 text-sm md:text-base font-normal leading-normal">Manage and join your active teleconsultation rooms linked to appointments.</p>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between gap-3">
            <h2 class="text-slate-900 dark:text-white text-lg font-bold">Active Sessions</h2>
            <p class="text-xs text-slate-400 font-bold uppercase tracking-[0.2em]">{{ teleconsultations|length }} TOTAL</p>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50 dark:bg-slate-800/50">
                    <tr class="text-slate-500 text-xs font-bold uppercase tracking-wider">
                        <th class="px-6 py-3">ID</th>
                        <th class="px-6 py-3">Appointment</th>
                        <th class="px-6 py-3">Patient</th>
                        <th class="px-6 py-3">Video Link</th>
                        <th class="px-6 py-3 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    {% if teleconsultations is not empty %}
                        {% for teleconsultation in teleconsultations %}
                            <tr>
                                <td class="px-6 py-3 text-sm text-slate-600 dark:text-slate-300">#{{ teleconsultation.id }}</td>
                                <td class="px-6 py-3 text-sm">
                                    {% if teleconsultation.appointment %}
                                        <a href="{{ path('app_appointment_show', { id: teleconsultation.appointment.id }) }}" class="text-primary font-semibold hover:text-primary/80">Appointment #{{ teleconsultation.appointment.id }}</a>
                                    {% else %}<span class="text-slate-400">—</span>{% endif %}
                                </td>
                                <td class="px-6 py-3 text-sm text-slate-700 dark:text-slate-200">
                                    {% if teleconsultation.appointment and teleconsultation.appointment.patient %}{{ teleconsultation.appointment.patient.name }}{% else %}<span class="text-slate-400">Unknown</span>{% endif %}
                                </td>
                                <td class="px-6 py-3 text-xs text-slate-500 max-w-xs">{% if teleconsultation.videoLink %}<span class="truncate block" title="{{ teleconsultation.videoLink }}">{{ teleconsultation.videoLink }}</span>{% else %}<span class="text-slate-400">Not set</span>{% endif %}</td>
                                <td class="px-6 py-3 text-right">
                                    <a href="{{ path('app_teleconsultation_room', { id: teleconsultation.id }) }}" class="inline-flex items-center gap-1 bg-primary text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-primary/90"><span class="material-symbols-outlined text-sm">video_chat</span> Open Room</a>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr><td colspan="5" class="px-6 py-8 text-center text-slate-400 text-sm">No teleconsultations found.</td></tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
