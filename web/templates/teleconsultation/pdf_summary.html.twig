<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Teleconsultation Summary - #{{ teleconsultation.id }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            color: #333;
            line-height: 1.6;
            margin: 0;
            padding: 20px;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #007bff;
            padding-bottom: 20px;
        }
        .header h1 {
            margin: 0;
            color: #007bff;
        }
        .header p {
            margin: 5px 0;
            font-size: 14px;
        }
        .section {
            margin-bottom: 20px;
        }
        .section-title {
            font-weight: bold;
            color: #007bff;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
            margin-bottom: 10px;
        }
        .info-row {
            display: flex;
            margin-bottom: 8px;
        }
        .info-label {
            width: 150px;
            font-weight: bold;
            color: #555;
        }
        .info-value {
            flex: 1;
            color: #333;
        }
        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 12px;
            color: #999;
            border-top: 1px solid #ddd;
            padding-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Teleconsultation Summary Report</h1>
        <p>Generated on: {{ "now"|date('Y-m-d H:i:s') }}</p>
    </div>

    <div class="section">
        <div class="section-title">Teleconsultation Details</div>
        <div class="info-row">
            <div class="info-label">Teleconsultation ID:</div>
            <div class="info-value">#{{ teleconsultation.id }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Duration:</div>
            <div class="info-value">{{ teleconsultation.duration }} minutes</div>
        </div>
        <div class="info-row">
            <div class="info-label">Mode:</div>
            <div class="info-value">{{ teleconsultation.mode | capitalize }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Meeting URL:</div>
            <div class="info-value">
                <a href="{{ teleconsultation.meetingUrl }}" target="_blank">{{ teleconsultation.meetingUrl }}</a>
            </div>
        </div>
    </div>

    {% if teleconsultation.appointment %}
    <div class="section">
        <div class="section-title">Related Appointment</div>
        <div class="info-row">
            <div class="info-label">Appointment ID:</div>
            <div class="info-value">#{{ teleconsultation.appointment.id }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Scheduled Date/Time:</div>
            <div class="info-value">{{ teleconsultation.appointment.scheduledAt | date('Y-m-d H:i') }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Department:</div>
            <div class="info-value">{{ teleconsultation.appointment.department }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Doctor:</div>
            <div class="info-value">{{ teleconsultation.appointment.doctor }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Status:</div>
            <div class="info-value">{{ teleconsultation.appointment.status }}</div>
        </div>
        {% if teleconsultation.appointment.message %}
        <div class="info-row">
            <div class="info-label">Notes:</div>
            <div class="info-value">{{ teleconsultation.appointment.message }}</div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    <div class="footer">
        <p>This is an auto-generated report. Please keep it safe for your records.</p>
    </div>
</body>
</html>
